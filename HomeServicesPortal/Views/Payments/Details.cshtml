@model HomeServicesPortal.Models.ViewModels.PaymentDetailsVm
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Payment Details"; }
<div class="mb-4">
    <a asp-action="Index" class="text-decoration-none text-muted"><i class="fa-solid fa-arrow-left me-1"></i>Back to Payments</a>
    <h2 class="mt-2 mb-0"><i class="fa-solid fa-eye me-2 text-primary"></i>Payment Details</h2>
</div>
<div class="row justify-content-center"><div class="col-lg-8"><div class="card hs-card"><div class="card-body p-4">
    <dl class="row mb-0">
        <dt class="col-sm-4 text-muted">Booking</dt><dd class="col-sm-8 fw-semibold">@Model.BookingLabel</dd>
        <dt class="col-sm-4 text-muted">Amount</dt><dd class="col-sm-8">@(Model.Amount?.ToString("N2") ?? "—")</dd>
        <dt class="col-sm-4 text-muted">Payment Method</dt><dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.PaymentMethod) ? "—" : Model.PaymentMethod)</dd>
        <dt class="col-sm-4 text-muted">Transaction No</dt><dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.TransactionNo) ? "—" : Model.TransactionNo)</dd>
        <dt class="col-sm-4 text-muted">Payment Date</dt><dd class="col-sm-8">@(Model.PaymentDate?.ToString("dd MMM yyyy HH:mm") ?? "—")</dd>
    </dl>
    <hr /><div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Uid" class="btn btn-primary"><i class="fa-solid fa-pen me-1"></i>Edit</a>
        <a asp-action="Delete" asp-route-id="@Model.Uid" class="btn btn-outline-danger"><i class="fa-solid fa-trash me-1"></i>Delete</a>
    </div>
</div></div></div></div>
