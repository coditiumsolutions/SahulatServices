@model HomeServicesPortal.Models.ViewModels.PaymentLedgerListVm
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Payment Ledger";
}

<div class="d-flex flex-wrap align-items-center justify-content-between mb-4 gap-2">
    <div>
        <h2 class="mb-1"><i class="fa-solid fa-book me-2 text-primary"></i>Payment Ledger</h2>
        <p class="text-muted mb-0">Read-only view of PaymentLedger entries</p>
    </div>
    <div class="btn-group">
        <a asp-action="Ledger" class="btn btn-primary">Ledger</a>
        <a asp-action="Payouts" class="btn btn-outline-primary">Provider Payouts</a>
    </div>
</div>

<div class="card hs-card">
    <div class="card-body">
        <form method="get" asp-action="Ledger" class="row g-2 mb-3">
            <div class="col-md-6 col-lg-4">
                <div class="input-group">
                    <span class="input-group-text"><i class="fa-solid fa-search"></i></span>
                    <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Search ledger..." />
                    <button type="submit" class="btn btn-outline-primary">Search</button>
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.Search))
            {
                <div class="col-auto"><a asp-action="Ledger" class="btn btn-outline-secondary">Clear</a></div>
            }
        </form>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>UID</th>
                        <th>Booking</th>
                        <th>Provider</th>
                        <th>Account</th>
                        <th>Entry</th>
                        <th>Reason</th>
                        <th>Amount</th>
                        <th>Created On</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Items.Any())
                    {
                        <tr><td colspan="9" class="text-center text-muted py-4">No ledger entries found.</td></tr>
                    }
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@item.Uid</td>
                            <td>@(item.BookingUid?.ToString() ?? "—")</td>
                            <td>@(string.IsNullOrWhiteSpace(item.ProviderName) ? "—" : item.ProviderName)</td>
                            <td>@item.AccountType</td>
                            <td>@item.EntryType</td>
                            <td>@item.Reason</td>
                            <td>@item.Amount.ToString("N2")</td>
                            <td>@item.CreatedOn.ToString("dd MMM yyyy HH:mm")</td>
                            <td class="text-end">
                                <a asp-action="LedgerDetails" asp-route-id="@item.Uid" class="btn btn-sm btn-outline-secondary" title="Details"><i class="fa-solid fa-eye"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav class="mt-3"><ul class="pagination pagination-sm justify-content-center mb-0">
                <li class="page-item @(Model.Page <= 1 ? "disabled" : "")"><a class="page-link" asp-action="Ledger" asp-route-page="@(Model.Page - 1)" asp-route-search="@Model.Search">Previous</a></li>
                @for (var p = 1; p <= Model.TotalPages; p++) { <li class="page-item @(p == Model.Page ? "active" : "")"><a class="page-link" asp-action="Ledger" asp-route-page="@p" asp-route-search="@Model.Search">@p</a></li> }
                <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")"><a class="page-link" asp-action="Ledger" asp-route-page="@(Model.Page + 1)" asp-route-search="@Model.Search">Next</a></li>
            </ul></nav>
        }
    </div>
</div>
