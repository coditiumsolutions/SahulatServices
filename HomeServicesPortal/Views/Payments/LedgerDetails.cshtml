@model HomeServicesPortal.Models.ViewModels.PaymentLedgerDetailsVm
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Ledger Entry Details";
}

<div class="mb-4">
    <a asp-action="Ledger" class="text-decoration-none text-muted"><i class="fa-solid fa-arrow-left me-1"></i>Back to Payment Ledger</a>
    <h2 class="mt-2 mb-0"><i class="fa-solid fa-eye me-2 text-primary"></i>Ledger Entry #@Model.Uid</h2>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card hs-card">
            <div class="card-body p-4">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted">Booking UID</dt>
                    <dd class="col-sm-8">@(Model.BookingUid?.ToString() ?? "—")</dd>
                    <dt class="col-sm-4 text-muted">Provider</dt>
                    <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.ProviderName) ? "—" : Model.ProviderName)</dd>
                    <dt class="col-sm-4 text-muted">Account Type</dt>
                    <dd class="col-sm-8">@Model.AccountType</dd>
                    <dt class="col-sm-4 text-muted">Entry Type</dt>
                    <dd class="col-sm-8">@Model.EntryType</dd>
                    <dt class="col-sm-4 text-muted">Reason</dt>
                    <dd class="col-sm-8">@Model.Reason</dd>
                    <dt class="col-sm-4 text-muted">Amount</dt>
                    <dd class="col-sm-8 fw-semibold">@Model.Amount.ToString("N2")</dd>
                    <dt class="col-sm-4 text-muted">Created On</dt>
                    <dd class="col-sm-8">@Model.CreatedOn.ToString("dd MMM yyyy HH:mm")</dd>
                </dl>
            </div>
        </div>
    </div>
</div>
