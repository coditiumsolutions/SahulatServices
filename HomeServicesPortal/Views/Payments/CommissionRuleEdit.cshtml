@model HomeServicesPortal.Models.ViewModels.CommissionRuleFormVm
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Edit Commission Rule";
}

<div class="mb-4">
    <a asp-action="CommissionRules" class="text-decoration-none text-muted"><i class="fa-solid fa-arrow-left me-1"></i>Back to Commission Rules</a>
    <h2 class="mt-2 mb-0"><i class="fa-solid fa-pen me-2 text-primary"></i>Edit Commission Rule</h2>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card hs-card">
            <div class="card-body p-4">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <form asp-action="CommissionRuleEdit" asp-route-id="@Model.Uid" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Uid" />
                    <partial name="_CommissionRuleFormFields" model="Model" />
                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary"><i class="fa-solid fa-save me-1"></i>Update</button>
                        <a asp-action="CommissionRules" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
