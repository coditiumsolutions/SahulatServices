@model HomeServicesPortal.Models.ViewModels.PushBroadcastFormVm
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Push Broadcast";
}

<div class="mb-4">
    <h2 class="mb-0"><i class="fa-solid fa-bullhorn me-2 text-primary"></i>Push Broadcast</h2>
    <p class="text-muted mb-0">Send a push notification to every device registered for the Sahulat Ghar Tak app, e.g. to announce a new version.</p>
</div>

@if (TempData["SuccessMessage"] is string success)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fa-solid fa-circle-check me-2"></i>@success
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] is string error)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        <i class="fa-solid fa-triangle-exclamation me-2"></i>@error
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.FirebaseConfigured)
{
    <div class="alert alert-danger">
        <i class="fa-solid fa-circle-xmark me-2"></i>Firebase is not configured on this server, so broadcasts cannot be sent.
    </div>
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card hs-card">
            <div class="card-body p-4">
                <p class="small text-muted">
                    Registered devices: <strong>@Model.AndroidDevices</strong> Android, <strong>@Model.IosDevices</strong> iOS.
                    Tapping the notification opens the app's update prompt.
                </p>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <form asp-action="Send" method="post"
                      onsubmit="return confirm('Send this push notification to the selected devices now? This cannot be undone.');">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="Platform" class="form-label"></label>
                        <select asp-for="Platform" class="form-select">
                            <option value="all">All devices</option>
                            <option value="android">Android only</option>
                            <option value="ios">iOS only</option>
                        </select>
                        <span asp-validation-for="Platform" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-sm-6">
                            <label asp-for="AndroidLatestVersion" class="form-label"></label>
                            <div class="input-group">
                                <input asp-for="AndroidLatestVersion" class="form-control" placeholder="e.g. 1.0.5" maxlength="20" />
                                <button type="button" class="btn btn-outline-primary check-store-btn" data-platform="android" data-target="AndroidLatestVersion">
                                    <i class="fa-solid fa-rotate me-1"></i>Check store for update
                                </button>
                            </div>
                            <div class="form-text" id="store-status-android" role="status"></div>
                            <div class="form-check mt-1">
                                <input asp-for="AndroidForceUpdate" class="form-check-input" />
                                <label asp-for="AndroidForceUpdate" class="form-check-label"></label>
                            </div>
                            <div class="form-text text-break">Play Store: @Model.AndroidStoreUrl</div>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="IosLatestVersion" class="form-label"></label>
                            <div class="input-group">
                                <input asp-for="IosLatestVersion" class="form-control" placeholder="e.g. 1.0.3" maxlength="20" />
                                <button type="button" class="btn btn-outline-primary check-store-btn" data-platform="ios" data-target="IosLatestVersion">
                                    <i class="fa-solid fa-rotate me-1"></i>Check store for update
                                </button>
                            </div>
                            <div class="form-text" id="store-status-ios" role="status"></div>
                            <div class="form-check mt-1">
                                <input asp-for="IosForceUpdate" class="form-check-input" />
                                <label asp-for="IosForceUpdate" class="form-check-label"></label>
                            </div>
                            <div class="form-text text-break">App Store: @Model.IosStoreUrl</div>
                        </div>
                        <div class="col-12 form-text mt-0">
                            Store-facing version as <strong>major.minor.patch</strong> (no build number). The two stores release independently, so each platform's push carries its own; only the platform(s) you send to are used. <strong>Force update</strong> ticked: phones older than this see a full-screen "Update Now" block. Unticked: they see a dismissable "Update available" dialog ("Update now" / "Maybe later") instead, with the <strong>message below as the dialog text</strong>, so write it for the user (e.g. "Version 1.0.5 is available with new features.") and keep it free of technical wording. The setting is per platform and applies to this push only (it is not saved). "Check store for update" reads the store listing and saves that version (as the platform's latest version, which the app's start-up check also reads). A version you type by hand applies to this push only.
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label"></label>
                        <input asp-for="Title" class="form-control" maxlength="60" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Message" class="form-label"></label>
                        <textarea asp-for="Message" class="form-control" rows="3" maxlength="200"></textarea>
                        <span asp-validation-for="Message" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary" disabled="@(!Model.FirebaseConfigured)">
                        <i class="fa-solid fa-paper-plane me-1"></i>Send broadcast
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // "Check store for update": the server reads the store listing and saves the version it finds; this just
        // shows the result and fills the field. Nothing is sent to devices until "Send broadcast".
        document.querySelectorAll('.check-store-btn').forEach(function (btn) {
            btn.addEventListener('click', async function () {
                var platform = btn.dataset.platform;
                var status = document.getElementById('store-status-' + platform);
                var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                btn.disabled = true;
                status.className = 'form-text';
                status.textContent = 'Checking the store...';
                try {
                    var res = await fetch('/Admin/PushBroadcast/CheckStore', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
                        body: 'platform=' + encodeURIComponent(platform)
                    });
                    var data = await res.json();
                    if (data.success) {
                        document.getElementById(btn.dataset.target).value = data.version;
                        status.className = 'form-text text-success';
                    } else {
                        status.className = 'form-text text-danger';
                    }
                    status.textContent = data.message || 'Could not check the store.';
                } catch (e) {
                    status.className = 'form-text text-danger';
                    status.textContent = 'Could not check the store. Try again.';
                } finally {
                    btn.disabled = false;
                }
            });
        });
    </script>
}
