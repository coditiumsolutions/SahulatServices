@using HomeServicesPortal.Models.ViewModels
@model PublicSignupViewModel
@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "Sign Up";
    ViewData["Description"] = "Create a Sahulat Ghar Tak account as a customer or service provider.";
    ViewData["Robots"] = "noindex, follow";
}

@section Head {
    <link rel="stylesheet" href="~/css/public-auth.css" asp-append-version="true" />
}

<section class="pub-auth">
    <div class="container">
        <div class="pub-auth-shell">
            <aside class="pub-auth-aside" aria-hidden="true">
                <p class="pub-auth-eyebrow">Sahulat Ghar Tak</p>
                <h1 class="pub-auth-aside-title">Join the marketplace</h1>
                <p class="pub-auth-aside-text">
                    Register as a customer to book trusted help at home, or as a provider to receive service requests near you.
                </p>
            </aside>

            <div class="pub-auth-panel">
                <header class="pub-auth-header">
                    <h1>Sign up</h1>
                    <p>Choose Client or Provider — admin staff are not created here.</p>
                </header>

                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <form asp-controller="PublicAccount" asp-action="Signup" method="post" novalidate class="pub-auth-form" id="publicSignupForm">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label"></label>
                        <input asp-for="FullName" class="form-control form-control-lg" placeholder="Your full name" autocomplete="name" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="MobileNo" class="form-label"></label>
                        <input asp-for="MobileNo"
                               id="signupMobileNo"
                               class="form-control form-control-lg"
                               placeholder="03XX-XXXXXXX"
                               autocomplete="tel"
                               inputmode="numeric"
                               maxlength="12"
                               pattern="^03\d{2}-?\d{7}$"
                               title="Pakistani mobile: 03XX-XXXXXXX" />
                        <div class="form-text">Format: 03XX-XXXXXXX (digits only)</div>
                        <span asp-validation-for="MobileNo" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="UserType" class="form-label"></label>
                        <select asp-for="UserType" class="form-select form-select-lg" id="userTypeSelect">
                            <option value="">-- Select account type --</option>
                            <option value="Client">Client (Customer)</option>
                            <option value="Provider">Provider (Service professional)</option>
                        </select>
                        <span asp-validation-for="UserType" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Gender" class="form-label"></label>
                        <div class="d-flex flex-wrap gap-2" role="radiogroup" aria-label="Gender">
                            @foreach (var option in new[] { "Male", "Female", "Other" })
                            {
                                var id = "gender" + option;
                                <input type="radio" class="btn-check" name="Gender" id="@id" value="@option"
                                       checked="@string.Equals(Model.Gender, option, StringComparison.OrdinalIgnoreCase)" autocomplete="off" />
                                <label class="btn btn-outline-primary" for="@id">@option</label>
                            }
                        </div>
                        <span asp-validation-for="Gender" class="text-danger small"></span>
                    </div>

                    <div class="mb-3 provider-only @(Model.UserType == "Provider" ? "" : "d-none")" id="cnicGroup">
                        <label asp-for="Cnic" class="form-label"></label>
                        <input asp-for="Cnic" id="signupCnic" class="form-control form-control-lg" placeholder="XXXXX-XXXXXXX-X"
                               inputmode="numeric" maxlength="15" autocomplete="off" />
                        <span asp-validation-for="Cnic" class="text-danger small"></span>
                    </div>

                    <div class="mb-3 provider-only @(Model.UserType == "Provider" ? "" : "d-none")" id="categoryGroup">
                        <label asp-for="CategoryUids" class="form-label"></label>
                        <div class="form-text mb-2">Select up to @PublicSignupViewModel.MaxCategories categories.</div>
                        <div class="signup-category-list" id="categoryList">
                            @foreach (var cat in Model.Categories)
                            {
                                var catId = "cat" + cat.Value;
                                <div class="form-check">
                                    <input class="form-check-input signup-cat-check" type="checkbox" name="CategoryUids" id="@catId"
                                           value="@cat.Value" data-name="@cat.Text" checked="@cat.Selected" />
                                    <label class="form-check-label" for="@catId">@cat.Text</label>
                                </div>
                            }
                        </div>
                        <span asp-validation-for="CategoryUids" class="text-danger small"></span>

                        <div class="mt-3 d-none" id="primaryGroup">
                            <label class="form-label">Primary category</label>
                            <div id="primaryList" data-selected="@Model.PrimaryCategoryUid"></div>
                            <span asp-validation-for="PrimaryCategoryUid" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row provider-only @(Model.UserType == "Provider" ? "" : "d-none")">
                        <div class="col-md-6 mb-3">
                            <label asp-for="City" class="form-label"></label>
                            <select asp-for="City" class="form-select form-select-lg" asp-items="Model.Cities">
                                <option value="">Select your city</option>
                            </select>
                            <span asp-validation-for="City" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="ExperienceYears" class="form-label"></label>
                            <input asp-for="ExperienceYears" type="number" min="0" max="50" step="1"
                                   class="form-control form-control-lg" placeholder="0" />
                            <span asp-validation-for="ExperienceYears" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3 provider-only @(Model.UserType == "Provider" ? "" : "d-none")">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="3" maxlength="1000"
                                  placeholder="Briefly describe your services"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Password" class="form-label"></label>
                            <input asp-for="Password" class="form-control form-control-lg" autocomplete="new-password" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="ConfirmPassword" class="form-label"></label>
                            <input asp-for="ConfirmPassword" class="form-control form-control-lg" autocomplete="new-password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <button type="submit" class="btn pub-auth-btn w-100">
                        <i class="fa-solid fa-user-plus me-2" aria-hidden="true"></i>Create account
                    </button>
                </form>

                <p class="pub-auth-switch">
                    Already have an account?
                    <a href="/login">Log in</a>
                </p>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        (function () {
            var select = document.getElementById('userTypeSelect');
            var groups = document.querySelectorAll('.provider-only');
            if (!select) return;
            function sync() {
                var show = select.value === 'Provider';
                groups.forEach(function (el) {
                    el.classList.toggle('d-none', !show);
                });
            }
            select.addEventListener('change', sync);
            sync();
        })();

        (function () {
            var input = document.getElementById('signupMobileNo');
            if (!input) return;

            function formatMobile(raw) {
                var digits = String(raw || '').replace(/\D/g, '');
                if (digits.indexOf('92') === 0 && digits.length >= 12) {
                    digits = '0' + digits.slice(2);
                }
                digits = digits.slice(0, 11);
                if (digits.length <= 4) return digits;
                return digits.slice(0, 4) + '-' + digits.slice(4);
            }

            function applyMask() {
                var start = input.selectionStart;
                var before = input.value;
                var next = formatMobile(before);
                if (before === next) return;
                input.value = next;
                var pos = next.length;
                if (typeof start === 'number' && before.length > next.length) {
                    pos = Math.max(0, start - (before.length - next.length));
                }
                try { input.setSelectionRange(pos, pos); } catch (e) { /* ignore */ }
            }

            input.addEventListener('input', applyMask);
            input.addEventListener('blur', applyMask);
            input.addEventListener('paste', function () { setTimeout(applyMask, 0); });

            document.getElementById('publicSignupForm').addEventListener('submit', function () {
                // Server expects 03XXXXXXXXX; strip hyphen before post.
                input.value = String(input.value || '').replace(/\D/g, '').slice(0, 11);
            });

            applyMask();
        })();

        (function () {
            var checks = Array.prototype.slice.call(document.querySelectorAll('.signup-cat-check'));
            var primaryGroup = document.getElementById('primaryGroup');
            var primaryList = document.getElementById('primaryList');
            if (!checks.length || !primaryList) return;
            var max = @PublicSignupViewModel.MaxCategories;
            var preset = primaryList.getAttribute('data-selected');

            function render() {
                var chosen = checks.filter(function (c) { return c.checked; });
                checks.forEach(function (c) { c.disabled = !c.checked && chosen.length >= max; });

                var current = (primaryList.querySelector('input:checked') || {}).value || preset;
                primaryList.innerHTML = '';
                primaryGroup.classList.toggle('d-none', chosen.length < 2);
                if (chosen.length < 2) return;

                var valid = chosen.some(function (c) { return c.value === current; });
                chosen.forEach(function (c, i) {
                    var id = 'primary' + c.value;
                    var wrap = document.createElement('div');
                    wrap.className = 'form-check form-check-inline';
                    var radio = document.createElement('input');
                    radio.type = 'radio';
                    radio.className = 'form-check-input';
                    radio.name = 'PrimaryCategoryUid';
                    radio.id = id;
                    radio.value = c.value;
                    radio.checked = valid ? c.value === current : i === 0;
                    var label = document.createElement('label');
                    label.className = 'form-check-label';
                    label.htmlFor = id;
                    label.textContent = c.getAttribute('data-name');
                    wrap.appendChild(radio);
                    wrap.appendChild(label);
                    primaryList.appendChild(wrap);
                });
            }

            checks.forEach(function (c) { c.addEventListener('change', render); });
            render();
        })();

        (function () {
            var cnic = document.getElementById('signupCnic');
            if (!cnic) return;
            function formatCnic(raw) {
                var d = String(raw || '').replace(/\D/g, '').slice(0, 13);
                if (d.length <= 5) return d;
                if (d.length <= 12) return d.slice(0, 5) + '-' + d.slice(5);
                return d.slice(0, 5) + '-' + d.slice(5, 12) + '-' + d.slice(12);
            }
            cnic.addEventListener('input', function () { cnic.value = formatCnic(cnic.value); });
            cnic.value = formatCnic(cnic.value);
        })();
    </script>
}
