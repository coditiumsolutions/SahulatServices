@* The terms text lives in Shared/_TermsCustomer and _TermsProvider, shared with the public /terms-and-conditions page. *@
<div class="modal fade" id="termsModal" tabindex="-1" aria-labelledby="termsModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5" id="termsModalTitle">Terms &amp; Conditions</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="termsClient" class="d-none">
                    <h3 class="h5">Customer Terms &amp; Conditions</h3>
                    <partial name="_TermsCustomer" />
                </div>

                <div id="termsProvider" class="d-none">
                    <h3 class="h5">Provider Terms &amp; Conditions</h3>
                    <partial name="_TermsProvider" />
                </div>
            </div>
            <div class="modal-footer">
                <a class="me-auto small" href="/terms-and-conditions" target="_blank" rel="noopener">Open as a page</a>
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
