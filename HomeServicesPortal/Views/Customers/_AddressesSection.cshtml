@model List<HomeServicesPortal.Models.ViewModels.CustomerAddressItemVm>
@{
    var clientUid = (int)(ViewData["ClientUid"] ?? 0);
    var canManage = ViewData["CanManage"] as bool? ?? false;
}

<style>
    .client-addresses-grid .addresses-heading {
        font-size: 0.95rem;
        font-weight: 400;
    }
    .client-addresses-grid table {
        font-size: 0.8125rem;
        font-weight: 400;
    }
    .client-addresses-grid thead th {
        font-weight: 400;
    }
</style>

<div class="card hs-card mt-3 client-addresses-grid">
    <div class="card-body p-3">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
            <div class="addresses-heading mb-0">
                <i class="fa-solid fa-location-dot me-2 text-primary"></i>Addresses
                <span class="text-muted">(@Model.Count)</span>
            </div>
            @if (canManage)
            {
                <a asp-action="CreateAddress" asp-route-clientId="@clientUid" class="btn btn-primary btn-sm">
                    <i class="fa-solid fa-plus me-1"></i>Add Address
                </a>
            }
        </div>

        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Title</th>
                        <th>Full Address</th>
                        <th>Area</th>
                        <th>City</th>
                        <th>Lat / Long</th>
                        @if (canManage)
                        {
                            <th class="text-end">Actions</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="@(canManage ? 6 : 5)" class="text-center text-muted py-3">No addresses yet.</td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.AddressTitle</td>
                            <td>@item.FullAddress</td>
                            <td>@item.Area</td>
                            <td>@item.City</td>
                            <td class="text-muted">
                                @(item.Latitude?.ToString("0.#######") ?? "—")
                                /
                                @(item.Longitude?.ToString("0.#######") ?? "—")
                            </td>
                            @if (canManage)
                            {
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="EditAddress" asp-route-clientId="@clientUid" asp-route-addressId="@item.Uid"
                                           class="btn btn-outline-primary" title="Edit"><i class="fa-solid fa-pen"></i></a>
                                        <a asp-action="DeleteAddress" asp-route-clientId="@clientUid" asp-route-addressId="@item.Uid"
                                           class="btn btn-outline-danger" title="Delete"><i class="fa-solid fa-trash"></i></a>
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
