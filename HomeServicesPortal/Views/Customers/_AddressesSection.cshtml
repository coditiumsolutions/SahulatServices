@model List<HomeServicesPortal.Models.ViewModels.CustomerAddressItemVm>
@{
    var clientUid = (int)(ViewData["ClientUid"] ?? 0);
    var canManage = ViewData["CanManage"] as bool? ?? false;

    // (0,0) is what every currently-published app build sends when no pin was ever set —
    // a real point in the Gulf of Guinea, not a valid client location. Same convention as
    // ClientAddressApiDto.HasLocation (ClientAddressService.cs).
    bool HasValidLocation(HomeServicesPortal.Models.ViewModels.CustomerAddressItemVm item) =>
        item.Latitude.HasValue && item.Longitude.HasValue
        && !(item.Latitude == 0 && item.Longitude == 0);
}

<style>
    .client-addresses-grid .addresses-heading {
        font-size: 0.95rem;
        font-weight: 400;
    }
    .client-addresses-grid table {
        font-size: 0.8125rem;
        font-weight: 400;
    }
    .client-addresses-grid thead th {
        font-weight: 400;
    }
</style>

<div class="card hs-card mt-3 client-addresses-grid">
    <div class="card-body p-3">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
            <div class="addresses-heading mb-0">
                <i class="fa-solid fa-location-dot me-2 text-primary"></i>Addresses
                <span class="text-muted">(@Model.Count)</span>
            </div>
            @if (canManage)
            {
                <a asp-action="CreateAddress" asp-route-clientId="@clientUid" class="btn btn-primary btn-sm">
                    <i class="fa-solid fa-plus me-1"></i>Add Address
                </a>
            }
        </div>

        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Title</th>
                        <th>Full Address</th>
                        <th>Area</th>
                        <th>City</th>
                        <th>Lat / Long</th>
                        @if (canManage)
                        {
                            <th class="text-end">Actions</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="@(canManage ? 6 : 5)" class="text-center text-muted py-3">No addresses yet.</td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.AddressTitle</td>
                            <td>@item.FullAddress</td>
                            <td>@item.Area</td>
                            <td>@item.City</td>
                            <td class="text-muted">
                                @(item.Latitude?.ToString("0.#######") ?? "—")
                                /
                                @(item.Longitude?.ToString("0.#######") ?? "—")
                                @if (HasValidLocation(item))
                                {
                                    <button type="button" class="btn btn-outline-primary btn-sm ms-2 hs-address-map-view"
                                            data-bs-toggle="modal" data-bs-target="#hsAddressMapModal"
                                            data-lat="@item.Latitude!.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                            data-lng="@item.Longitude!.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                            data-title="@item.AddressTitle"
                                            title="View pin location on map">
                                        <i class="fa-solid fa-map-location-dot"></i> Map View
                                    </button>
                                }
                            </td>
                            @if (canManage)
                            {
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="EditAddress" asp-route-clientId="@clientUid" asp-route-addressId="@item.Uid"
                                           class="btn btn-outline-primary" title="Edit"><i class="fa-solid fa-pen"></i></a>
                                        <a asp-action="DeleteAddress" asp-route-clientId="@clientUid" asp-route-addressId="@item.Uid"
                                           class="btn btn-outline-danger" title="Delete"><i class="fa-solid fa-trash"></i></a>
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (Model.Any(HasValidLocation))
{
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />

    <div class="modal fade" id="hsAddressMapModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="hsAddressMapModalTitle">Address Location</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="hsAddressMapView" style="height: 380px; border-radius: 8px;"></div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script>
        (function () {
            var modalEl = document.getElementById('hsAddressMapModal');
            if (!modalEl) return;

            var map = null;
            var marker = null;

            modalEl.addEventListener('show.bs.modal', function (e) {
                var btn = e.relatedTarget;
                if (!btn) return;

                var lat = parseFloat(btn.getAttribute('data-lat'));
                var lng = parseFloat(btn.getAttribute('data-lng'));
                var title = btn.getAttribute('data-title') || 'Address Location';

                document.getElementById('hsAddressMapModalTitle').textContent = title;

                // Leaflet can't size a map correctly while its container is display:none
                // (still true mid-transition), so (re)create it once the modal has fully
                // shown rather than on show.bs.modal.
                modalEl.addEventListener('shown.bs.modal', function onShown() {
                    modalEl.removeEventListener('shown.bs.modal', onShown);

                    if (!map) {
                        map = L.map('hsAddressMapView');
                        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                            attribution: '&copy; OpenStreetMap contributors',
                            maxZoom: 19
                        }).addTo(map);
                    }

                    map.setView([lat, lng], 16);
                    if (marker) {
                        marker.setLatLng([lat, lng]);
                    } else {
                        marker = L.marker([lat, lng]).addTo(map);
                    }
                    map.invalidateSize();
                });
            });
        })();
    </script>
}
