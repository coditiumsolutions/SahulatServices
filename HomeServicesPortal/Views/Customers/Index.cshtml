@model HomeServicesPortal.Models.ViewModels.CustomerListVm
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Customers";
}

<div class="d-flex flex-wrap align-items-center justify-content-between mb-4 gap-2">
    <div>
        <h2 class="mb-1"><i class="fa-solid fa-users me-2 text-primary"></i>Customers</h2>
        <p class="text-muted mb-0">Manage customer records</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fa-solid fa-plus me-1"></i>Add Customer
    </a>
</div>

@if (TempData["SuccessMessage"] is string success)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fa-solid fa-circle-check me-2"></i>@success
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card hs-card">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-2 mb-3">
            <div class="col-md-6 col-lg-4">
                <div class="input-group">
                    <span class="input-group-text"><i class="fa-solid fa-search"></i></span>
                    <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Search customers..." />
                    <button type="submit" class="btn btn-outline-primary">Search</button>
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.Search))
            {
                <div class="col-auto">
                    <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
                </div>
            }
        </form>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>
                            <a class="text-decoration-none text-dark" asp-action="Index"
                               asp-route-search="@Model.Search" asp-route-sort="name"
                               asp-route-sortDir="@(Model.Sort == "name" && Model.SortDir == "asc" ? "desc" : "asc")">
                                Full Name
                                @if (Model.Sort == "name")
                                {
                                    <i class="fa-solid fa-sort-@(Model.SortDir == "asc" ? "up" : "down") ms-1"></i>
                                }
                            </a>
                        </th>
                        <th>
                            <a class="text-decoration-none text-dark" asp-action="Index"
                               asp-route-search="@Model.Search" asp-route-sort="mobile"
                               asp-route-sortDir="@(Model.Sort == "mobile" && Model.SortDir == "asc" ? "desc" : "asc")">
                                Mobile No
                            </a>
                        </th>
                        <th>
                            <a class="text-decoration-none text-dark" asp-action="Index"
                               asp-route-search="@Model.Search" asp-route-sort="email"
                               asp-route-sortDir="@(Model.Sort == "email" && Model.SortDir == "asc" ? "desc" : "asc")">
                                Email
                            </a>
                        </th>
                        <th>Address</th>
                        <th>
                            <a class="text-decoration-none text-dark" asp-action="Index"
                               asp-route-search="@Model.Search" asp-route-sort="date"
                               asp-route-sortDir="@(Model.Sort == "date" && Model.SortDir == "asc" ? "desc" : "asc")">
                                Created On
                            </a>
                        </th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Items.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">No customers found.</td>
                        </tr>
                    }
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td class="fw-semibold">@item.FullName</td>
                            <td>@(string.IsNullOrWhiteSpace(item.MobileNo) ? "—" : item.MobileNo)</td>
                            <td>@(string.IsNullOrWhiteSpace(item.Email) ? "—" : item.Email)</td>
                            <td>@(string.IsNullOrWhiteSpace(item.Address) ? "—" : item.Address)</td>
                            <td>@(item.CreatedOn?.ToString("dd MMM yyyy") ?? "—")</td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@item.Uid" class="btn btn-outline-secondary" title="Details"><i class="fa-solid fa-eye"></i></a>
                                    <a asp-action="Edit" asp-route-id="@item.Uid" class="btn btn-outline-primary" title="Edit"><i class="fa-solid fa-pen"></i></a>
                                    <a asp-action="Delete" asp-route-id="@item.Uid" class="btn btn-outline-danger" title="Delete"><i class="fa-solid fa-trash"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav class="mt-3" aria-label="Customer pagination">
                <ul class="pagination pagination-sm justify-content-center mb-0">
                    <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page - 1)"
                           asp-route-search="@Model.Search" asp-route-sort="@Model.Sort" asp-route-sortDir="@Model.SortDir">Previous</a>
                    </li>
                    @for (var p = 1; p <= Model.TotalPages; p++)
                    {
                        <li class="page-item @(p == Model.Page ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@p"
                               asp-route-search="@Model.Search" asp-route-sort="@Model.Sort" asp-route-sortDir="@Model.SortDir">@p</a>
                        </li>
                    }
                    <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page + 1)"
                           asp-route-search="@Model.Search" asp-route-sort="@Model.Sort" asp-route-sortDir="@Model.SortDir">Next</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>
