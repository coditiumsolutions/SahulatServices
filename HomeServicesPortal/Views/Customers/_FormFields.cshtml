@model HomeServicesPortal.Models.ViewModels.CustomerFormVm

<style>
    .client-form-grid .form-label {
        font-size: 0.78rem;
        font-weight: 600;
        color: #6c757d;
        margin-bottom: 0.2rem;
    }
    .client-form-grid .form-control,
    .client-form-grid .form-select {
        font-size: 0.875rem;
    }
</style>

<div class="client-form-grid">
    <div class="row g-2 mb-2">
        <div class="col-md-6">
            <div class="row g-2 align-items-center">
                <div class="col-sm-4">
                    <label asp-for="FullName" class="form-label mb-0"></label>
                </div>
                <div class="col-sm-8">
                    <input asp-for="FullName" class="form-control form-control-sm" placeholder="Enter full name" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="row g-2 align-items-center">
                <div class="col-sm-4">
                    <label asp-for="MobileNo" class="form-label mb-0"></label>
                </div>
                <div class="col-sm-8">
                    <input asp-for="MobileNo" class="form-control form-control-sm" placeholder="Enter mobile number" />
                    <span asp-validation-for="MobileNo" class="text-danger small"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-2 mb-2">
        <div class="col-md-6">
            <div class="row g-2 align-items-center">
                <div class="col-sm-4">
                    <label asp-for="Cnic" class="form-label mb-0"></label>
                </div>
                <div class="col-sm-8">
                    <input asp-for="Cnic" class="form-control form-control-sm" placeholder="Enter CNIC" />
                    <span asp-validation-for="Cnic" class="text-danger small"></span>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="row g-2 align-items-center">
                <div class="col-sm-4">
                    <label asp-for="Gender" class="form-label mb-0"></label>
                </div>
                <div class="col-sm-8">
                    <select asp-for="Gender" class="form-select form-select-sm">
                        <option value="">-- Select Gender --</option>
                        <option value="Male">Male</option>
                        <option value="Female">Female</option>
                        <option value="Other">Other</option>
                    </select>
                    <span asp-validation-for="Gender" class="text-danger small"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-2 mb-2">
        <div class="col-md-6">
            <div class="row g-2 align-items-center">
                <div class="col-sm-4">
                    <label asp-for="City" class="form-label mb-0"></label>
                </div>
                <div class="col-sm-8">
                    <select asp-for="City" class="form-select form-select-sm" asp-items="Model.CityOptions">
                        <option value="">-- Select City --</option>
                    </select>
                    <span asp-validation-for="City" class="text-danger small"></span>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="row g-2 align-items-center">
                <div class="col-sm-4">
                    <label asp-for="Location" class="form-label mb-0"></label>
                </div>
                <div class="col-sm-8">
                    <select asp-for="Location" class="form-select form-select-sm" asp-items="Model.LocationOptions">
                        <option value="">-- Select Location --</option>
                    </select>
                    <span asp-validation-for="Location" class="text-danger small"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-2 mb-2">
        <div class="col-md-6">
            <div class="row g-2 align-items-start">
                <div class="col-sm-4 pt-1">
                    <label asp-for="CustomerAlert" class="form-label mb-0"></label>
                </div>
                <div class="col-sm-8">
                    <select asp-for="CustomerAlert" class="form-select form-select-sm" asp-items="Model.AlertOptions">
                        <option value="">-- Select Alert --</option>
                    </select>
                    <span asp-validation-for="CustomerAlert" class="text-danger small"></span>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="row g-2 align-items-start">
                <div class="col-sm-4 pt-1">
                    <label asp-for="Comments" class="form-label mb-0"></label>
                </div>
                <div class="col-sm-8">
                    <textarea asp-for="Comments" class="form-control form-control-sm" rows="2" maxlength="1000" placeholder="Internal comments"></textarea>
                    <span asp-validation-for="Comments" class="text-danger small"></span>
                </div>
            </div>
        </div>
    </div>
</div>
