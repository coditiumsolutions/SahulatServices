@model HomeServicesPortal.Models.ViewModels.CustomerRequestsListVm
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Customer Requests";
    string StatusBadgeClass(string? status) => status switch
    {
        "Completed" => "success",
        "In Progress" => "primary",
        "Assigned" => "info",
        "Cancelled" => "secondary",
        "Initiated" => "warning",
        _ => "warning"
    };
}

<div class="d-flex flex-wrap align-items-center justify-content-between mb-4 gap-2">
    <div>
        <h2 class="mb-1"><i class="fa-solid fa-clipboard-user me-2 text-primary"></i>Customer Requests</h2>
        <p class="text-muted mb-0">Customers joined with their service requests</p>
    </div>
</div>

<div class="card hs-card">
    <div class="card-body">
        <form method="get" asp-action="Requests" class="row g-2 mb-3">
            <div class="col-md-6 col-lg-4">
                <div class="input-group">
                    <span class="input-group-text"><i class="fa-solid fa-search"></i></span>
                    <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Search customer or request..." />
                    <button type="submit" class="btn btn-outline-primary">Search</button>
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.Search))
            {
                <div class="col-auto">
                    <a asp-action="Requests" class="btn btn-outline-secondary">Clear</a>
                </div>
            }
        </form>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Customer</th>
                        <th>Mobile</th>
                        <th>Request</th>
                        <th>Category</th>
                        <th>Status</th>
                        <th>Created</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Items.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">No customer requests found.</td>
                        </tr>
                    }
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td class="fw-semibold">
                                <div>@item.CustomerName</div>
                                <div class="small text-muted">Client #@item.ClientUid</div>
                            </td>
                            <td>@(string.IsNullOrWhiteSpace(item.MobileNo) ? "—" : item.MobileNo)</td>
                            <td>
                                <div>#@item.RequestUid — @item.ServiceTitle</div>
                                @if (item.IsUrgent)
                                {
                                    <span class="badge bg-danger">Urgent</span>
                                }
                            </td>
                            <td>@item.CategoryName</td>
                            <td><span class="badge bg-@StatusBadgeClass(item.Status)">@item.Status</span></td>
                            <td>@item.CreatedOn.ToString("dd MMM yyyy HH:mm")</td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a href="/Admin/Clients/Details/@item.ClientUid" class="btn btn-outline-secondary" title="Customer"><i class="fa-solid fa-user"></i></a>
                                    <a href="/Admin/ServiceRequests/Details/@item.RequestUid" class="btn btn-outline-primary" title="Request"><i class="fa-solid fa-eye"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav class="mt-3" aria-label="Customer requests pagination">
                <ul class="pagination pagination-sm justify-content-center mb-0">
                    <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Requests" asp-route-page="@(Model.Page - 1)" asp-route-search="@Model.Search">Previous</a>
                    </li>
                    @for (var p = 1; p <= Model.TotalPages; p++)
                    {
                        <li class="page-item @(p == Model.Page ? "active" : "")">
                            <a class="page-link" asp-action="Requests" asp-route-page="@p" asp-route-search="@Model.Search">@p</a>
                        </li>
                    }
                    <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Requests" asp-route-page="@(Model.Page + 1)" asp-route-search="@Model.Search">Next</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>
