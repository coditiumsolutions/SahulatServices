@model HomeServicesPortal.Models.ViewModels.CustomerAddressDeleteVm
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Delete Address";
}

<div class="mb-3">
    <a asp-action="Edit" asp-route-id="@Model.ClientUid" class="text-decoration-none text-muted small">
        <i class="fa-solid fa-arrow-left me-1"></i>Back to Client
    </a>
    <h2 class="mt-1 mb-0 h4">
        <i class="fa-solid fa-trash me-2 text-danger"></i>Delete Address
        <span class="text-muted fw-normal">#@Model.Uid</span>
    </h2>
</div>

<div class="card hs-card">
    <div class="card-body p-3">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

        @if (Model.IsLinkedToRequests)
        {
            <div class="alert alert-warning py-2">
                This address is linked to service requests and cannot be deleted.
            </div>
        }
        else
        {
            <p class="mb-3">Are you sure you want to delete this address for <strong>@Model.ClientName</strong>?</p>
        }

        <dl class="row mb-0">
            <dt class="col-sm-3 text-muted">Title</dt>
            <dd class="col-sm-9">@Model.AddressTitle</dd>
            <dt class="col-sm-3 text-muted">Full Address</dt>
            <dd class="col-sm-9">@Model.FullAddress</dd>
            <dt class="col-sm-3 text-muted">Area</dt>
            <dd class="col-sm-9">@Model.Area</dd>
            <dt class="col-sm-3 text-muted">City</dt>
            <dd class="col-sm-9">@Model.City</dd>
        </dl>

        <div class="d-flex gap-2 mt-3">
            @if (!Model.IsLinkedToRequests)
            {
                <form asp-action="DeleteAddressConfirmed" asp-route-clientId="@Model.ClientUid" asp-route-addressId="@Model.Uid" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger btn-sm"><i class="fa-solid fa-trash me-1"></i>Delete</button>
                </form>
            }
            <a asp-action="Edit" asp-route-id="@Model.ClientUid" class="btn btn-outline-secondary btn-sm">Cancel</a>
        </div>
    </div>
</div>
