@model HomeServicesPortal.Models.ViewModels.ClientPortalAddressDeleteVm
@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "Delete address";
    ViewData["Robots"] = "noindex, nofollow";
}

@section Head {
    <link rel="stylesheet" href="~/css/public-dashboard.css" asp-append-version="true" />
}

<section class="pub-dash">
    <div class="container">
        <p class="mb-3">
            <a href="/client/profile" class="client-back-link">
                <i class="fa-solid fa-arrow-left me-1" aria-hidden="true"></i>Back to profile
            </a>
        </p>

        <header class="pub-dash-hero">
            <p class="pub-dash-eyebrow">Client · Profile · Addresses</p>
            <h1>Delete address</h1>
            <p class="pub-dash-lead">This cannot be undone. Addresses linked to service requests cannot be deleted.</p>
        </header>

        <div class="pub-dash-card client-request-form-card">
            <dl class="pub-dash-dl mb-4">
                <div><dt>Title</dt><dd>@Model.AddressTitle</dd></div>
                <div><dt>Address</dt><dd>@Model.FullAddress</dd></div>
                <div><dt>Area</dt><dd>@Model.Area</dd></div>
                <div><dt>City</dt><dd>@Model.City</dd></div>
            </dl>

            <form method="post" action="/client/profile/addresses/@Model.Uid/delete">
                @Html.AntiForgeryToken()
                <div class="d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-danger">
                        <i class="fa-solid fa-trash me-2" aria-hidden="true"></i>Delete permanently
                    </button>
                    <a href="/client/profile" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</section>
