@model HomeServicesPortal.Models.ViewModels.ProviderDocumentDetailsVm
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Legal Document Details";
    string UrlPath(string? path) => string.IsNullOrWhiteSpace(path) ? "" : "/" + path.TrimStart('/');
}

<style>
    .pd-details-grid .pd-label {
        font-size: 0.78rem;
        font-weight: 600;
        color: #6c757d;
    }
    .pd-details-grid .pd-value {
        font-size: 0.9rem;
        font-weight: 500;
        color: #212529;
        word-break: break-word;
    }
    .pd-details-grid .pd-thumb {
        max-height: 96px;
    }
</style>

<div class="mb-3">
    <a asp-action="Index" class="text-decoration-none text-muted small"><i class="fa-solid fa-arrow-left me-1"></i>Back to Legal Documents</a>
    <h2 class="mt-1 mb-0 h4"><i class="fa-solid fa-eye me-2 text-primary"></i>Legal Document Details <span class="text-muted fw-normal">#@Model.Uid</span></h2>
</div>

<div class="card hs-card">
    <div class="card-body p-3 pd-details-grid">
        <div class="row g-2 mb-2">
            <div class="col-md-6">
                <div class="row g-2">
                    <div class="col-sm-4 pd-label">Provider</div>
                    <div class="col-sm-8 pd-value">@Model.ProviderName <span class="text-muted">(#@Model.ProviderUid)</span></div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="row g-2">
                    <div class="col-sm-4 pd-label">Status</div>
                    <div class="col-sm-8 pd-value">
                        @if (Model.IsVerified)
                        {
                            <span class="badge bg-success">Verified</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Pending</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-2 mb-2">
            <div class="col-md-6">
                <div class="row g-2">
                    <div class="col-sm-4 pd-label">Verified On</div>
                    <div class="col-sm-8 pd-value">@(Model.VerifiedOn?.ToString("dd MMM yyyy HH:mm") ?? "—")</div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="row g-2">
                    <div class="col-sm-4 pd-label">Verified By</div>
                    <div class="col-sm-8 pd-value">@(Model.VerifiedBy?.ToString() ?? "—")</div>
                </div>
            </div>
        </div>

        <div class="row g-2 mb-2">
            <div class="col-md-6">
                <div class="row g-2">
                    <div class="col-sm-4 pd-label">Remarks</div>
                    <div class="col-sm-8 pd-value">@(string.IsNullOrWhiteSpace(Model.VerificationRemarks) ? "—" : Model.VerificationRemarks)</div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="row g-2">
                    <div class="col-sm-4 pd-label">Created</div>
                    <div class="col-sm-8 pd-value">@Model.CreatedOn.ToString("dd MMM yyyy HH:mm")</div>
                </div>
            </div>
        </div>

        <div class="row g-2 mb-2">
            <div class="col-md-6">
                <div class="row g-2">
                    <div class="col-sm-4 pd-label">Updated</div>
                    <div class="col-sm-8 pd-value">@(Model.UpdatedOn?.ToString("dd MMM yyyy HH:mm") ?? "—")</div>
                </div>
            </div>
            <div class="col-md-6"></div>
        </div>

        <div class="row g-2 mb-2">
            <div class="col-md-6">
                <div class="row g-2 align-items-start">
                    <div class="col-sm-4 pd-label">Profile Photo</div>
                    <div class="col-sm-8 pd-value">
                        @if (!string.IsNullOrWhiteSpace(Model.ProfilePhotoPath))
                        {
                            <img src="@UrlPath(Model.ProfilePhotoPath)" alt="Profile" class="img-thumbnail pd-thumb" />
                            <div><a href="@UrlPath(Model.ProfilePhotoPath)" target="_blank" rel="noopener" class="small">Open</a></div>
                        }
                        else
                        {
                            <text>—</text>
                        }
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="row g-2 align-items-start">
                    <div class="col-sm-4 pd-label">CNIC Front</div>
                    <div class="col-sm-8 pd-value">
                        @if (!string.IsNullOrWhiteSpace(Model.CnicFrontImagePath))
                        {
                            <img src="@UrlPath(Model.CnicFrontImagePath)" alt="CNIC Front" class="img-thumbnail pd-thumb" />
                            <div><a href="@UrlPath(Model.CnicFrontImagePath)" target="_blank" rel="noopener" class="small">Open</a></div>
                        }
                        else
                        {
                            <text>—</text>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-2 mb-2">
            <div class="col-md-6">
                <div class="row g-2 align-items-start">
                    <div class="col-sm-4 pd-label">CNIC Back</div>
                    <div class="col-sm-8 pd-value">
                        @if (!string.IsNullOrWhiteSpace(Model.CnicBackImagePath))
                        {
                            <img src="@UrlPath(Model.CnicBackImagePath)" alt="CNIC Back" class="img-thumbnail pd-thumb" />
                            <div><a href="@UrlPath(Model.CnicBackImagePath)" target="_blank" rel="noopener" class="small">Open</a></div>
                        }
                        else
                        {
                            <text>—</text>
                        }
                    </div>
                </div>
            </div>
            <div class="col-md-6"></div>
        </div>

        <hr class="my-3" />
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Uid" class="btn btn-primary btn-sm"><i class="fa-solid fa-pen me-1"></i>Edit</a>
            <a asp-action="Delete" asp-route-id="@Model.Uid" class="btn btn-outline-danger btn-sm"><i class="fa-solid fa-trash me-1"></i>Delete</a>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back</a>
        </div>
    </div>
</div>
