@model HomeServicesPortal.Models.ViewModels.ProviderDocumentDetailsVm
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "P-Document Details";
    string UrlPath(string? path) => string.IsNullOrWhiteSpace(path) ? "" : "/" + path.TrimStart('/');
}
<div class="mb-4">
    <a asp-action="Index" class="text-decoration-none text-muted"><i class="fa-solid fa-arrow-left me-1"></i>Back to P-Documents</a>
    <h2 class="mt-2 mb-0"><i class="fa-solid fa-eye me-2 text-primary"></i>P-Document Details</h2>
</div>
<div class="row justify-content-center"><div class="col-lg-10"><div class="card hs-card"><div class="card-body p-4">
    <dl class="row mb-4">
        <dt class="col-sm-3 text-muted">Provider</dt>
        <dd class="col-sm-9 fw-semibold">@Model.ProviderName <span class="text-muted fw-normal">(#@Model.ProviderUid)</span></dd>
        <dt class="col-sm-3 text-muted">Status</dt>
        <dd class="col-sm-9">
            @if (Model.IsVerified)
            {
                <span class="badge bg-success">Verified</span>
            }
            else
            {
                <span class="badge bg-secondary">Pending</span>
            }
        </dd>
        <dt class="col-sm-3 text-muted">Verified On</dt>
        <dd class="col-sm-9">@(Model.VerifiedOn?.ToString("dd MMM yyyy HH:mm") ?? "—")</dd>
        <dt class="col-sm-3 text-muted">Verified By</dt>
        <dd class="col-sm-9">@(Model.VerifiedBy?.ToString() ?? "—")</dd>
        <dt class="col-sm-3 text-muted">Remarks</dt>
        <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.VerificationRemarks) ? "—" : Model.VerificationRemarks)</dd>
        <dt class="col-sm-3 text-muted">Created</dt>
        <dd class="col-sm-9">@Model.CreatedOn.ToString("dd MMM yyyy HH:mm")</dd>
        <dt class="col-sm-3 text-muted">Updated</dt>
        <dd class="col-sm-9">@(Model.UpdatedOn?.ToString("dd MMM yyyy HH:mm") ?? "—")</dd>
    </dl>

    <div class="row g-3">
        <div class="col-md-4">
            <div class="border rounded p-2 h-100">
                <div class="small text-muted mb-2">Profile Photo</div>
                @if (!string.IsNullOrWhiteSpace(Model.ProfilePhotoPath))
                {
                    <img src="@UrlPath(Model.ProfilePhotoPath)" alt="Profile" class="img-fluid rounded" />
                    <div class="mt-2"><a href="@UrlPath(Model.ProfilePhotoPath)" target="_blank" rel="noopener" class="small">Open</a></div>
                }
                else { <span class="text-muted">—</span> }
            </div>
        </div>
        <div class="col-md-4">
            <div class="border rounded p-2 h-100">
                <div class="small text-muted mb-2">CNIC Front</div>
                @if (!string.IsNullOrWhiteSpace(Model.CnicFrontImagePath))
                {
                    <img src="@UrlPath(Model.CnicFrontImagePath)" alt="CNIC Front" class="img-fluid rounded" />
                    <div class="mt-2"><a href="@UrlPath(Model.CnicFrontImagePath)" target="_blank" rel="noopener" class="small">Open</a></div>
                }
                else { <span class="text-muted">—</span> }
            </div>
        </div>
        <div class="col-md-4">
            <div class="border rounded p-2 h-100">
                <div class="small text-muted mb-2">CNIC Back</div>
                @if (!string.IsNullOrWhiteSpace(Model.CnicBackImagePath))
                {
                    <img src="@UrlPath(Model.CnicBackImagePath)" alt="CNIC Back" class="img-fluid rounded" />
                    <div class="mt-2"><a href="@UrlPath(Model.CnicBackImagePath)" target="_blank" rel="noopener" class="small">Open</a></div>
                }
                else { <span class="text-muted">—</span> }
            </div>
        </div>
    </div>

    <hr /><div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Uid" class="btn btn-primary"><i class="fa-solid fa-pen me-1"></i>Edit</a>
        <a asp-action="Delete" asp-route-id="@Model.Uid" class="btn btn-outline-danger"><i class="fa-solid fa-trash me-1"></i>Delete</a>
    </div>
</div></div></div></div>
