@model HomeServicesPortal.Models.ViewModels.ServiceFormVm

<div class="mb-3">
    <label asp-for="ServiceName" class="form-label"></label>
    <input asp-for="ServiceName" class="form-control" placeholder="Enter service name" />
    <span asp-validation-for="ServiceName" class="text-danger small"></span>
</div>

<div class="mb-3">
    <label asp-for="Description" class="form-label"></label>
    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Optional description"></textarea>
    <span asp-validation-for="Description" class="text-danger small"></span>
</div>

<div class="mb-3">
    <label asp-for="DisplayOrder" class="form-label"></label>
    <input asp-for="DisplayOrder" type="number" class="form-control" />
    <span asp-validation-for="DisplayOrder" class="text-danger small"></span>
</div>

<div class="form-check mb-2">
    <input asp-for="IsActive" class="form-check-input" />
    <label asp-for="IsActive" class="form-check-label"></label>
</div>
