@model HomeServicesPortal.Models.ViewModels.ProviderLocationFormVm

<div class="mb-3">
    <label asp-for="ProviderUid" class="form-label"></label>
    <select asp-for="ProviderUid" class="form-select" asp-items="Model.Providers">
        <option value="">-- Select S-Provider --</option>
    </select>
    <span asp-validation-for="ProviderUid" class="text-danger small"></span>
</div>

<div class="mb-3">
    <label class="form-label">Pick Location</label>
    <div class="d-flex flex-wrap gap-2 mb-2">
        <button type="button" id="btnCurrentLocation" class="btn btn-outline-primary btn-sm">
            <i class="fa-solid fa-location-crosshairs me-1"></i>Use My Current Location
        </button>
        <span class="text-muted small align-self-center">
            <i class="fa-solid fa-hand-pointer me-1"></i>Or click the map / drag the pin to set coordinates
        </span>
    </div>
    <div id="locationMap" class="rounded border" style="height: 320px; z-index: 0;"></div>
    <div id="locationStatus" class="form-text text-muted mt-1"></div>
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="Latitude" class="form-label"></label>
        <input asp-for="Latitude" class="form-control" type="number" step="any" min="-90" max="90" placeholder="e.g. 31.5204" />
        <span asp-validation-for="Latitude" class="text-danger small"></span>
        <div class="form-text">Between -90 and 90. Map / current location fills this for you.</div>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="Longitude" class="form-label"></label>
        <input asp-for="Longitude" class="form-control" type="number" step="any" min="-180" max="180" placeholder="e.g. 74.3587" />
        <span asp-validation-for="Longitude" class="text-danger small"></span>
        <div class="form-text">Between -180 and 180. Map / current location fills this for you.</div>
    </div>
</div>
