@model HomeServicesPortal.Models.ViewModels.BookingTrackingDetailsVm
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "BookingTracking Details";
    var statusClass = Model.Status switch
    {
        "Completed" => "success",
        "In Progress" => "primary",
        "Arrived" => "info",
        "On The Way" => "warning",
        "Cancelled" => "secondary",
        _ => "light text-dark"
    };
}
<div class="mb-4">
    <a asp-action="Index" class="text-decoration-none text-muted"><i class="fa-solid fa-arrow-left me-1"></i>Back to BookingTracking</a>
    <h2 class="mt-2 mb-0"><i class="fa-solid fa-eye me-2 text-primary"></i>BookingTracking Details</h2>
</div>
<div class="row justify-content-center"><div class="col-lg-8"><div class="card hs-card"><div class="card-body p-4">
    <dl class="row mb-0">
        <dt class="col-sm-4 text-muted">Booking</dt><dd class="col-sm-8 fw-semibold">@Model.BookingLabel</dd>
        <dt class="col-sm-4 text-muted">Status</dt><dd class="col-sm-8"><span class="badge bg-@statusClass">@(Model.Status ?? "—")</span></dd>
        <dt class="col-sm-4 text-muted">Remarks</dt><dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Remarks) ? "—" : Model.Remarks)</dd>
        <dt class="col-sm-4 text-muted">Status Date</dt><dd class="col-sm-8">@(Model.StatusDate?.ToString("dd MMM yyyy HH:mm") ?? "—")</dd>
    </dl>
    <hr /><div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Uid" class="btn btn-primary"><i class="fa-solid fa-pen me-1"></i>Edit</a>
        <a asp-action="Delete" asp-route-id="@Model.Uid" class="btn btn-outline-danger"><i class="fa-solid fa-trash me-1"></i>Delete</a>
    </div>
</div></div></div></div>
