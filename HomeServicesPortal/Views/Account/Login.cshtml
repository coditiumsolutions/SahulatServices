@model HomeServicesPortal.Models.ViewModels.LoginViewModel
@{
    Layout = "_LoginLayout";
    ViewData["Title"] = "Sign In";
}

<div class="login-page login-fade-in">
    <!-- Mobile-only brand strip -->
    <div class="login-mobile-brand" aria-hidden="true">
        <div class="login-logo">
            <i class="fa-solid fa-house-chimney"></i>
        </div>
        <h2>Home Services Portal</h2>
        <p>Connect Customers with Trusted Service Providers</p>
    </div>

    <div class="login-split">
        <!-- Left: Branding panel (desktop / tablet) -->
        <aside class="login-brand-panel" aria-label="Welcome information">
            <div class="login-brand-content">
                <!-- Company logo placeholder -->
                <div class="login-logo" role="img" aria-label="Home Services Portal logo">
                    <i class="fa-solid fa-house-chimney"></i>
                </div>

                <h1 class="login-brand-title">Home Services Portal</h1>
                <p class="login-brand-subtitle">
                    Connect Customers with Trusted Service Providers
                </p>

                <!-- Service categories -->
                <div class="login-services" role="list" aria-label="Available services">
                    <div class="login-service-item" role="listitem">
                        <i class="fa-solid fa-faucet-drip" aria-hidden="true"></i>
                        <span>Plumber</span>
                    </div>
                    <div class="login-service-item" role="listitem">
                        <i class="fa-solid fa-bolt" aria-hidden="true"></i>
                        <span>Electrician</span>
                    </div>
                    <div class="login-service-item" role="listitem">
                        <i class="fa-solid fa-hammer" aria-hidden="true"></i>
                        <span>Carpenter</span>
                    </div>
                    <div class="login-service-item" role="listitem">
                        <i class="fa-solid fa-paint-roller" aria-hidden="true"></i>
                        <span>Painter</span>
                    </div>
                    <div class="login-service-item" role="listitem">
                        <i class="fa-solid fa-fan" aria-hidden="true"></i>
                        <span>AC Technician</span>
                    </div>
                    <div class="login-service-item" role="listitem">
                        <i class="fa-solid fa-book-open" aria-hidden="true"></i>
                        <span>Home Tutor</span>
                    </div>
                </div>

                <!-- Illustration placeholder -->
                <div class="login-illustration">
                    <i class="bi bi-building-gear" aria-hidden="true"></i>
                    <p>Enterprise admin portal for managing home services at scale</p>
                </div>
            </div>
        </aside>

        <!-- Right: Login form -->
        <section class="login-form-panel" aria-label="Sign in form">
            <div class="login-card">
                <header class="login-card-header">
                    <h1>SahulatGharTak</h1>
                    <p>Sign in to your admin account</p>
                </header>

                <!-- Server-side login error -->
                @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
                {
                    var errors = ViewData.ModelState.Values
                        .SelectMany(v => v.Errors)
                        .Select(e => e.ErrorMessage)
                        .Where(m => !string.IsNullOrWhiteSpace(m))
                        .Distinct()
                        .ToList();

                    if (errors.Count > 0)
                    {
                        <div class="alert alert-danger login-alert d-flex align-items-start gap-2 mb-3"
                             role="alert"
                             aria-live="polite">
                            <i class="fa-solid fa-circle-exclamation mt-1" aria-hidden="true"></i>
                            <div>
                                @foreach (var error in errors)
                                {
                                    <div>@error</div>
                                }
                            </div>
                        </div>
                    }
                }

                <form asp-action="Login"
                      asp-controller="Account"
                      method="post"
                      novalidate
                      id="loginForm"
                      aria-label="Login form">

                    <input type="hidden" asp-for="ReturnUrl" />

                    <!-- Username field -->
                    <div class="login-field">
                        <div class="form-floating">
                            <input asp-for="Username"
                                   class="form-control"
                                   placeholder="Username"
                                   autocomplete="username"
                                   aria-required="true"
                                   id="usernameInput" />
                            <label asp-for="Username">Username</label>
                        </div>
                        <i class="fa-solid fa-user login-field-icon" aria-hidden="true"></i>
                        <span asp-validation-for="Username" class="text-danger"></span>
                    </div>

                    <!-- Password field -->
                    <div class="login-field">
                        <div class="form-floating">
                            <input asp-for="Password"
                                   class="form-control"
                                   placeholder="Password"
                                   autocomplete="current-password"
                                   aria-required="true"
                                   id="passwordInput" />
                            <label asp-for="Password">Password</label>
                        </div>
                        <i class="fa-solid fa-lock login-field-icon" aria-hidden="true"></i>
                        <button type="button"
                                class="login-password-toggle"
                                id="togglePassword"
                                aria-label="Show password"
                                aria-pressed="false"
                                tabindex="0">
                            <i class="fa-solid fa-eye" id="togglePasswordIcon" aria-hidden="true"></i>
                        </button>
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <!-- Remember me + Forgot password -->
                    <div class="login-options">
                        <div class="form-check">
                            <input asp-for="RememberMe"
                                   class="form-check-input"
                                   type="checkbox"
                                   id="rememberMe" />
                            <label class="form-check-label" for="rememberMe">
                                Remember me
                            </label>
                        </div>
                        <a class="login-forgot-link"
                           asp-area="Identity"
                           asp-page="/Account/ForgotPassword"
                           aria-label="Forgot your password?">
                            Forgot password?
                        </a>
                    </div>

                    <!-- Sign in button -->
                    <button type="submit"
                            class="btn btn-primary btn-lg login-btn"
                            id="loginBtn"
                            aria-label="Sign in to your account">
                        <span id="loginBtnText">Sign In</span>
                        <span id="loginBtnSpinner"
                              class="spinner-border spinner-border-sm ms-2 d-none"
                              role="status"
                              aria-hidden="true"></span>
                    </button>
                </form>
            </div>
        </section>
    </div>

    <!-- Footer -->
    <footer class="login-footer">
        <span>&copy; 2026 Home Services Portal</span>
        <span>Version 1.0</span>
    </footer>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            'use strict';

            const form = document.getElementById('loginForm');
            const passwordInput = document.getElementById('passwordInput');
            const toggleBtn = document.getElementById('togglePassword');
            const toggleIcon = document.getElementById('togglePasswordIcon');
            const loginBtn = document.getElementById('loginBtn');
            const loginBtnText = document.getElementById('loginBtnText');
            const loginBtnSpinner = document.getElementById('loginBtnSpinner');

            // Show / hide password toggle
            if (toggleBtn && passwordInput) {
                toggleBtn.addEventListener('click', function () {
                    const isPassword = passwordInput.type === 'password';
                    passwordInput.type = isPassword ? 'text' : 'password';
                    toggleIcon.classList.toggle('fa-eye', !isPassword);
                    toggleIcon.classList.toggle('fa-eye-slash', isPassword);
                    toggleBtn.setAttribute('aria-label', isPassword ? 'Hide password' : 'Show password');
                    toggleBtn.setAttribute('aria-pressed', isPassword ? 'true' : 'false');
                });

                // Keyboard support for toggle
                toggleBtn.addEventListener('keydown', function (e) {
                    if (e.key === 'Enter' || e.key === ' ') {
                        e.preventDefault();
                        toggleBtn.click();
                    }
                });
            }

            // Loading spinner on submit
            if (form && loginBtn) {
                form.addEventListener('submit', function () {
                    // Only show spinner if client-side validation passes
                    if (typeof $ !== 'undefined' && $(form).valid && !$(form).valid()) {
                        return;
                    }

                    loginBtn.disabled = true;
                    loginBtnText.textContent = 'Signing in...';
                    loginBtnSpinner.classList.remove('d-none');
                });
            }

            // Bootstrap client-side validation styling
            if (form) {
                form.addEventListener('submit', function (event) {
                    if (!form.checkValidity()) {
                        event.preventDefault();
                        event.stopPropagation();
                        // Re-enable button if HTML5 validation fails
                        loginBtn.disabled = false;
                        loginBtnText.textContent = 'Sign In';
                        loginBtnSpinner.classList.add('d-none');
                    }
                    form.classList.add('was-validated');
                });
            }
        })();
    </script>
}
