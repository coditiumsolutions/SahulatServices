@model HomeServicesPortal.Models.ViewModels.ServiceTitleFormVm
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Add Service Title";
}

<div class="mb-3">
    <a asp-action="Index" class="text-decoration-none text-muted small"><i class="fa-solid fa-arrow-left me-1"></i>Back to Service Titles</a>
    <h2 class="mt-1 mb-0 h4"><i class="fa-solid fa-plus me-2 text-primary"></i>Add Service Title</h2>
</div>

<div class="card hs-card">
    <div class="card-body p-3">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <partial name="_FormFields" model="Model" />
            <div class="d-flex gap-2 mt-3">
                <button type="submit" class="btn btn-primary btn-sm"><i class="fa-solid fa-check me-1"></i>Save</button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
