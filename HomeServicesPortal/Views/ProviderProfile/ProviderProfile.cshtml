@using HomeServicesPortal.Helpers
@using HomeServicesPortal.Models.ViewModels
@model ProviderProfileVm
@{
    Layout = "_PublicLayout";
    ViewData["Robots"] = "noindex, nofollow";
    string Dash(string? v) => string.IsNullOrWhiteSpace(v) ? "-" : v;
    var success = TempData["ProfileSuccess"] as string ?? TempData["ProviderSuccess"] as string;
    var error = TempData["ProfileError"] as string ?? TempData["ProviderError"] as string;
}

@section Head {
    <link rel="stylesheet" href="~/css/public-dashboard.css" asp-append-version="true" />
}

<section class="pub-dash">
    <div class="container">
        @if (!string.IsNullOrEmpty(success))
        {
            <div class="alert alert-success" role="status">@success</div>
        }
        @if (!string.IsNullOrEmpty(error))
        {
            <div class="alert alert-danger" role="alert">@error</div>
        }

        <header class="pub-dash-hero pub-dash-hero--provider provider-profile-hero">
            <div class="provider-avatar">
                @if (!string.IsNullOrEmpty(Model.PhotoUrl))
                {
                    <img src="@Model.PhotoUrl" alt="Profile photo" />
                }
                else
                {
                    <i class="fa-solid fa-user" aria-hidden="true"></i>
                }
            </div>
            <div>
                <h1 class="mb-1">
                    @Model.FullName
                    @if (Model.IsVerified)
                    {
                        <i class="fa-solid fa-circle-check text-info ms-1" title="Verified" aria-label="Verified"></i>
                    }
                </h1>
                <p class="pub-dash-lead mb-1">@Model.CategoryName</p>
                <p class="mb-0"><i class="fa-solid fa-star text-warning me-1" aria-hidden="true"></i>@Model.AverageRating.ToString("0.0") (@Model.TotalReviews reviews)</p>
            </div>
        </header>

        <div class="pub-dash-grid mb-4">
            <article class="pub-dash-card">
                <h2><i class="fa-solid fa-id-card me-2" aria-hidden="true"></i>Provider Details</h2>
                <dl class="pub-dash-dl">
                    <div><dt>Provider ID</dt><dd>@Model.ProviderUid</dd></div>
                    <div><dt>Mobile Number</dt><dd>@RequestDisplayHelper.MobileDisplay(Model.MobileNo)</dd></div>
                    <div><dt>CNIC</dt><dd>@Dash(Model.Cnic)</dd></div>
                    <div><dt>Gender</dt><dd>@Dash(Model.Gender)</dd></div>
                    <div><dt>Experience</dt><dd>@Model.ExperienceYears years</dd></div>
                    @if (!string.IsNullOrWhiteSpace(Model.City))
                    {
                        <div><dt>City</dt><dd>@Model.City</dd></div>
                    }
                    <div><dt>Category</dt><dd>@Dash(Model.CategoryName)</dd></div>
                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <div><dt>Description</dt><dd>@Model.Description</dd></div>
                    }
                    <div><dt>Jobs Completed</dt><dd>@Model.JobsCompleted</dd></div>
                    <div>
                        <dt>Verification Status</dt>
                        <dd>
                            @if (Model.IsVerified)
                            {
                                <span class="badge text-bg-success">Verified</span>
                            }
                            else
                            {
                                <span class="badge text-bg-warning">Pending</span>
                                @if (!string.IsNullOrEmpty(Model.VerificationRemarks))
                                {
                                    <div class="small text-muted mt-1">@Model.VerificationRemarks</div>
                                }
                            }
                        </dd>
                    </div>
                    <div><dt>Member Since</dt><dd>@Model.CreatedOn.ToPktDateDisplay()</dd></div>
                </dl>
            </article>

            <article class="pub-dash-card">
                <h2><i class="fa-regular fa-clock me-2" aria-hidden="true"></i>Availability</h2>
                <dl class="pub-dash-dl">
                    <div><dt>Status</dt><dd>@(Model.IsOnline ? "Online — receiving new requests" : "Offline")</dd></div>
                    <div><dt>Available Timing</dt><dd>@(Model.IsOnline ? $"{Model.AvailableFrom} - {Model.AvailableTo}" : "Not set")</dd></div>
                </dl>
                <div class="d-flex flex-wrap gap-2">
                    @if (Model.IsOnline)
                    {
                        <form method="post" action="/provider/availability" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="isOnline" value="false" />
                            <input type="hidden" name="returnTo" value="profile" />
                            <button type="submit" class="btn btn-outline-primary btn-sm">Go offline</button>
                        </form>
                        <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#availabilityModal">Change hours</button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#availabilityModal">Go online</button>
                    }
                </div>
            </article>
        </div>

        <div class="pub-dash-card mb-4">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                <h2 class="mb-0"><i class="fa-solid fa-screwdriver-wrench me-2" aria-hidden="true"></i>Categories &amp; Services</h2>
                <a href="/provider/categories" class="btn btn-outline-primary btn-sm"><i class="fa-solid fa-pen me-1" aria-hidden="true"></i>Edit</a>
            </div>

            <h3 class="h6">My Categories</h3>
            @if (Model.Categories.Count == 0)
            {
                <p class="text-muted">No categories yet</p>
            }
            else
            {
                <p>
                    @foreach (var c in Model.Categories)
                    {
                        <span class="badge text-bg-light border me-1">@c@(c == Model.PrimaryCategory && Model.Categories.Count > 1 ? " · Primary" : "")</span>
                    }
                </p>
            }

            <h3 class="h6">My Services</h3>
            @if (Model.Titles.Count == 0)
            {
                <p class="text-muted mb-0">No services selected yet. Optional: it helps customers find you for specific jobs.</p>
            }
            else
            {
                @foreach (var group in Model.Titles)
                {
                    <div class="mb-2">
                        <div class="small fw-semibold">@group.Key</div>
                        @foreach (var t in group)
                        {
                            <span class="badge text-bg-light border me-1">@t</span>
                        }
                    </div>
                }
            }

            @if (Model.Zones.Count > 0)
            {
                <h3 class="h6 mt-3">Service Zones</h3>
                <p class="mb-0">
                    @foreach (var z in Model.Zones)
                    {
                        <span class="badge text-bg-light border me-1">@z</span>
                    }
                </p>
            }
        </div>

        <div class="d-flex flex-wrap gap-2 mb-4">
            <a href="/provider/profile/edit" class="btn btn-primary"><i class="fa-solid fa-pen me-1" aria-hidden="true"></i>Edit Profile</a>
            <a href="/provider/documents" class="btn btn-outline-primary"><i class="fa-solid fa-file-lines me-1" aria-hidden="true"></i>My Documents</a>
            <a href="/provider/categories" class="btn btn-outline-primary"><i class="fa-solid fa-list-check me-1" aria-hidden="true"></i>Categories</a>
        </div>

        @* Delete Account hidden for now (re-enable by removing this comment and the modal one below).
<div class="pub-dash-card border-danger-subtle">
            <h2 class="text-danger"><i class="fa-solid fa-triangle-exclamation me-2" aria-hidden="true"></i>Danger zone</h2>
            <p class="text-muted">Deleting your account is permanent. You cannot delete it while you have pending dues, open bookings or an unpaid payout.</p>
            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteAccountModal">Delete Account</button>
        </div>
*@
    </div>
</section>

@await Html.PartialAsync("_AvailabilityModal", (Model.AvailableFrom, Model.AvailableTo), new ViewDataDictionary(ViewData) { { "ReturnTo", "profile" } })

