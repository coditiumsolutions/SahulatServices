@model HomeServicesPortal.Models.ViewModels.ProviderAvailabilityFormVm

<div class="mb-3">
    <label asp-for="ProviderUid" class="form-label"></label>
    <select asp-for="ProviderUid" class="form-select" asp-items="Model.Providers">
        <option value="">-- Select S-Provider --</option>
    </select>
    <span asp-validation-for="ProviderUid" class="text-danger small"></span>
</div>

<div class="mb-3">
    <div class="form-check form-switch">
        <input asp-for="IsOnline" class="form-check-input" type="checkbox" role="switch" />
        <label asp-for="IsOnline" class="form-check-label"></label>
    </div>
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="AvailableFrom" class="form-label"></label>
        <input asp-for="AvailableFrom" class="form-control" type="time" />
        <span asp-validation-for="AvailableFrom" class="text-danger small"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="AvailableTo" class="form-label"></label>
        <input asp-for="AvailableTo" class="form-control" type="time" />
        <span asp-validation-for="AvailableTo" class="text-danger small"></span>
    </div>
</div>
