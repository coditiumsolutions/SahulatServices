@model HomeServicesPortal.Models.ViewModels.ProviderAvailabilityDeleteVm
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Delete P-Availability";
}

<div class="mb-4">
    <a asp-action="Index" class="text-decoration-none text-muted"><i class="fa-solid fa-arrow-left me-1"></i>Back to P-Availability</a>
    <h2 class="mt-2 mb-0 text-danger"><i class="fa-solid fa-triangle-exclamation me-2"></i>Delete P-Availability</h2>
</div>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card hs-card border-danger">
            <div class="card-body p-4">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <p>Are you sure you want to delete this availability record?</p>
                <dl class="row mb-4">
                    <dt class="col-sm-4 text-muted">Provider</dt>
                    <dd class="col-sm-8 fw-semibold">@Model.ProviderName</dd>
                    <dt class="col-sm-4 text-muted">Status</dt>
                    <dd class="col-sm-8">
                        @if (Model.IsOnline == true)
                        {
                            <span class="badge bg-success">Online</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Offline</span>
                        }
                    </dd>
                    <dt class="col-sm-4 text-muted">Available From</dt>
                    <dd class="col-sm-8">@(Model.AvailableFrom?.ToString("HH:mm") ?? "—")</dd>
                    <dt class="col-sm-4 text-muted">Available To</dt>
                    <dd class="col-sm-8">@(Model.AvailableTo?.ToString("HH:mm") ?? "—")</dd>
                </dl>
                <form asp-action="DeleteConfirmed" asp-route-id="@Model.Uid" method="post">
                    @Html.AntiForgeryToken()
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-danger"><i class="fa-solid fa-trash me-1"></i>Yes, Delete</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
