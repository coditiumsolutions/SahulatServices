@model HomeServicesPortal.Models.ViewModels.BookingDetailsVm
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Booking Details";
    var statusClass = Model.Status switch
    {
        "Completed" => "success",
        "In Progress" => "primary",
        "Accepted" => "info",
        "Cancelled" => "secondary",
        _ => "warning"
    };
}

<style>
    .bk-details-grid .bk-title {
        font-weight: normal;
        color: #000;
    }
    .bk-details-grid .bk-field {
        color: #0d6efd;
        font-weight: 500;
    }
</style>

<div class="mb-4">
    <a asp-action="Index" class="text-decoration-none text-muted"><i class="fa-solid fa-arrow-left me-1"></i>Back to Bookings</a>
    <h2 class="mt-2 mb-0"><i class="fa-solid fa-eye me-2 text-primary"></i>Booking Details</h2>
</div>

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="card hs-card">
            <div class="card-body p-4">
                <div class="bk-details-grid">
                    <div class="row g-3 mb-3">
                        <div class="col-md-3 bk-title">Service Request</div>
                        <div class="col-md-3 bk-field">@Model.ServiceTitle</div>
                        <div class="col-md-3 bk-title">Created On</div>
                        <div class="col-md-3 bk-field">@(Model.BookingDate?.ToString("dd MMM yyyy HH:mm") ?? "—")</div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-3 bk-title">Client</div>
                        <div class="col-md-3 bk-field">@Model.ClientName</div>
                        <div class="col-md-3 bk-title">Service Type</div>
                        <div class="col-md-3 bk-field">@Model.ServiceType</div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-3 bk-title">Provider</div>
                        <div class="col-md-3 bk-field">@Model.ProviderName</div>
                        <div class="col-md-3 bk-title">Status</div>
                        <div class="col-md-3 bk-field"><span class="badge bg-@statusClass">@(Model.Status ?? "—")</span></div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-3 bk-title">Service Detail</div>
                        <div class="col-md-9 bk-field">@(string.IsNullOrWhiteSpace(Model.ServiceDetail) ? "—" : Model.ServiceDetail)</div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-3 bk-title">Estimated Amount</div>
                        <div class="col-md-3 bk-field">@Model.EstimatedAmount.ToString("N2")</div>
                        <div class="col-md-3 bk-title">Visit Charges</div>
                        <div class="col-md-3 bk-field">@Model.VisitCharges.ToString("N2")</div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-3 bk-title">Additional Charges</div>
                        <div class="col-md-3 bk-field">@Model.AdditionalCharges.ToString("N2")</div>
                        <div class="col-md-3 bk-title">Deductions</div>
                        <div class="col-md-3 bk-field">@Model.Deductions.ToString("N2")</div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-3 bk-title">Final Bill</div>
                        <div class="col-md-3 bk-field">@Model.FinalAmount.ToString("N2")</div>
                        <div class="col-md-3 bk-title">Customer Paid</div>
                        <div class="col-md-3 bk-field">@Model.CustomerPaid.ToString("N2")</div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-3 bk-title">Payment Method</div>
                        <div class="col-md-3 bk-field">@Model.PaymentMode</div>
                        <div class="col-md-3 bk-title">Customer Remaining</div>
                        <div class="col-md-3 bk-field">@Model.CustomerRemaining.ToString("N2")</div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-3 bk-title">Commission Type</div>
                        <div class="col-md-3 bk-field">@Model.CommissionType</div>
                        <div class="col-md-3 bk-title">Commission Rate / Value</div>
                        <div class="col-md-3 bk-field">@Model.CommissionValue.ToString("N2")</div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-3 bk-title">Company Commission</div>
                        <div class="col-md-3 bk-field">@Model.CommissionAmount.ToString("N2")</div>
                        <div class="col-md-3 bk-title">Provider Earning</div>
                        <div class="col-md-3 bk-field">@Model.ProviderEarning.ToString("N2")</div>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-3 bk-title">Ledger Entries</div>
                        <div class="col-md-3 bk-field"><span class="badge bg-info">@Model.LedgerCount</span></div>
                    </div>
                </div>
                <hr />
                <div class="d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.Uid" class="btn btn-primary"><i class="fa-solid fa-pen me-1"></i>Edit</a>
                    <a asp-action="Delete" asp-route-id="@Model.Uid" class="btn btn-outline-danger"><i class="fa-solid fa-trash me-1"></i>Delete</a>
                </div>
            </div>
        </div>
    </div>
</div>
