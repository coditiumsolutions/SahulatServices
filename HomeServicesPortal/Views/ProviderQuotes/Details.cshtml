@model HomeServicesPortal.Models.ViewModels.ProviderQuoteDetailsVm
@{ Layout = "_AdminLayout"; ViewData["Title"] = "P-Quote Details"; }
<div class="mb-4">
    <a asp-action="Index" class="text-decoration-none text-muted"><i class="fa-solid fa-arrow-left me-1"></i>Back to P-Quote</a>
    <h2 class="mt-2 mb-0"><i class="fa-solid fa-eye me-2 text-primary"></i>P-Quote Details</h2>
</div>
<div class="row justify-content-center"><div class="col-lg-8"><div class="card hs-card"><div class="card-body p-4">
    <dl class="row mb-0">
        <dt class="col-sm-4 text-muted">Service Request</dt><dd class="col-sm-8 fw-semibold">@Model.RequestLabel</dd>
        <dt class="col-sm-4 text-muted">Provider</dt><dd class="col-sm-8">@Model.ProviderName</dd>
        <dt class="col-sm-4 text-muted">Quote Amount</dt><dd class="col-sm-8">@(Model.QuoteAmount?.ToString("N2") ?? "—")</dd>
        <dt class="col-sm-4 text-muted">Estimated Arrival</dt><dd class="col-sm-8">@(Model.EstimatedArrivalMinutes?.ToString() ?? "—") min</dd>
        <dt class="col-sm-4 text-muted">Distance</dt><dd class="col-sm-8">@(Model.DistanceKm?.ToString("N2") ?? "—") KM</dd>
        <dt class="col-sm-4 text-muted">Remarks</dt><dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Remarks) ? "—" : Model.Remarks)</dd>
        <dt class="col-sm-4 text-muted">Quote Date</dt><dd class="col-sm-8">@(Model.QuoteDate?.ToString("dd MMM yyyy HH:mm") ?? "—")</dd>
    </dl>
    <hr /><div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Uid" class="btn btn-primary"><i class="fa-solid fa-pen me-1"></i>Edit</a>
        <a asp-action="Delete" asp-route-id="@Model.Uid" class="btn btn-outline-danger"><i class="fa-solid fa-trash me-1"></i>Delete</a>
    </div>
</div></div></div></div>
