@model HomeServicesPortal.Models.ViewModels.ConfigurationDetailsVm
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Configuration Details";
}

<div class="mb-4">
    <a asp-action="Index" class="text-decoration-none text-muted"><i class="fa-solid fa-arrow-left me-1"></i>Back to Configurations</a>
    <h2 class="mt-2 mb-0"><i class="fa-solid fa-eye me-2 text-primary"></i>Configuration Details</h2>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card hs-card">
            <div class="card-body p-4">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted">UID</dt>
                    <dd class="col-sm-8 fw-semibold">@Model.Uid</dd>
                    <dt class="col-sm-4 text-muted">Config Key</dt>
                    <dd class="col-sm-8 fw-semibold">@Model.ConfigKey</dd>
                    <dt class="col-sm-4 text-muted">Created On</dt>
                    <dd class="col-sm-8">@Model.CreatedOn.ToString("dd MMM yyyy HH:mm")</dd>
                    <dt class="col-sm-4 text-muted">Config Value</dt>
                    <dd class="col-sm-8">
                        <div class="mb-2">@Model.ConfigValue</div>
                        <div class="d-flex flex-wrap gap-1">
                            @foreach (var v in Model.Values)
                            {
                                <span class="badge bg-primary">@v</span>
                            }
                        </div>
                    </dd>
                </dl>
                <hr />
                <div class="d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.Uid" class="btn btn-primary"><i class="fa-solid fa-pen me-1"></i>Edit</a>
                    <a asp-action="Delete" asp-route-id="@Model.Uid" class="btn btn-outline-danger"><i class="fa-solid fa-trash me-1"></i>Delete</a>
                    <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
                </div>
            </div>
        </div>
    </div>
</div>
