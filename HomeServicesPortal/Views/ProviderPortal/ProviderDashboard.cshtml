@using HomeServicesPortal.Helpers
@using HomeServicesPortal.Models.ViewModels
@model ProviderHomeVm
@{
    Layout = "_PublicLayout";
    ViewData["Robots"] = "noindex, nofollow";
    var firstName = (Model.FullName ?? string.Empty).Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault();
    var success = TempData["ProviderSuccess"] as string;
    var error = TempData["ProviderError"] as string;
}

@section Head {
    <link rel="stylesheet" href="~/css/public-dashboard.css" asp-append-version="true" />
}

<section class="pub-dash">
    <div class="container">
        @if (!string.IsNullOrEmpty(success))
        {
            <div class="alert alert-success" role="status">@success</div>
        }
        @if (!string.IsNullOrEmpty(error))
        {
            <div class="alert alert-danger" role="alert">@error</div>
        }

        <header class="pub-dash-hero pub-dash-hero--provider">
            <div class="provider-hero-bar">
                <p class="pub-dash-eyebrow mb-0">Provider account</p>
                <div class="provider-hero-actions">
                    @if (Model.IsOnline)
                    {
                        <form method="post" action="/provider/availability">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="isOnline" value="false" />
                            <button type="submit" class="btn btn-sm btn-outline-primary">
                                <i class="fa-solid fa-power-off me-1" aria-hidden="true"></i>Go offline
                            </button>
                        </form>
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#availabilityModal">
                            <i class="fa-regular fa-clock me-1" aria-hidden="true"></i>Change hours
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#availabilityModal">
                            <i class="fa-solid fa-wifi me-1" aria-hidden="true"></i>Go online
                        </button>
                    }
                </div>
            </div>
            <h1 class="provider-welcome">@(string.IsNullOrEmpty(firstName) ? "Welcome back!" : $"Welcome back, {firstName}!")</h1>
            <p class="pub-dash-lead">
                @if (Model.IsOnline)
                {
                    <text>You're online and visible to customers (@Model.AvailableFrom &ndash; @Model.AvailableTo).</text>
                }
                else
                {
                    <text>You're offline right now.</text>
                }
            </p>
        </header>

        <a class="provider-notif-card mb-4" href="/provider/notifications">
            <span class="provider-notif-icon" aria-hidden="true"><i class="fa-regular fa-bell"></i></span>
            <span class="flex-grow-1">
                <span class="fw-semibold d-block">Notifications</span>
                <span class="small text-muted">@(Model.UnreadNotifications > 0 ? $"{Model.UnreadNotifications} unread" : "You are all caught up")</span>
            </span>
            @if (Model.UnreadNotifications > 0)
            {
                <span class="badge rounded-pill text-bg-danger">@(Model.UnreadNotifications > 99 ? "99+" : Model.UnreadNotifications.ToString())</span>
            }
            <i class="fa-solid fa-chevron-right text-muted" aria-hidden="true"></i>
        </a>

        <h2 class="h5 mb-3">Overview</h2>
        <div class="provider-stats">
            <a class="provider-stat provider-stat--indigo" href="/provider/requests">
                <span class="provider-stat-icon" aria-hidden="true"><i class="fa-solid fa-inbox"></i></span>
                <span class="provider-stat-value">@Model.AvailableRequests</span>
                <span class="provider-stat-label">Available Requests</span>
            </a>
            <a class="provider-stat provider-stat--teal" href="/provider/bookings">
                <span class="provider-stat-icon" aria-hidden="true"><i class="fa-solid fa-briefcase"></i></span>
                <span class="provider-stat-value">@Model.ActiveBookings</span>
                <span class="provider-stat-label">Active Bookings</span>
            </a>
            <div class="provider-stat provider-stat--green">
                <span class="provider-stat-icon" aria-hidden="true"><i class="fa-solid fa-circle-check"></i></span>
                <span class="provider-stat-value">@Model.CompletedToday</span>
                <span class="provider-stat-label">Completed Today</span>
            </div>
            <div class="provider-stat provider-stat--amber">
                <span class="provider-stat-icon" aria-hidden="true"><i class="fa-solid fa-star"></i></span>
                <span class="provider-stat-value">@Model.AverageRating.ToString("0.0")</span>
                <span class="provider-stat-label">Average Rating</span>
            </div>
            <a class="provider-stat provider-stat--pink" href="/provider/wallet">
                <span class="provider-stat-icon" aria-hidden="true"><i class="fa-solid fa-wallet"></i></span>
                <span class="provider-stat-value">@(Model.WalletBalance is decimal balance ? RequestDisplayHelper.Currency(balance) ?? "Rs 0" : "—")</span>
                <span class="provider-stat-label">Wallet Balance</span>
            </a>
        </div>
    </div>
</section>

@await Html.PartialAsync("_AvailabilityModal", (Model.AvailableFrom, Model.AvailableTo), new ViewDataDictionary(ViewData) { { "ReturnTo", "dashboard" } })
