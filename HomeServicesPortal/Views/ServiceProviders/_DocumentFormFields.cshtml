@model HomeServicesPortal.Models.ViewModels.ProviderDocumentFormVm
@{
    string UrlPath(string? path) => string.IsNullOrWhiteSpace(path) ? "" : "/" + path.TrimStart('/');
    var isEdit = Model.Uid > 0;
}

<style>
    .pd-embed-form .form-label {
        font-size: 0.78rem;
        font-weight: 600;
        color: #6c757d;
        margin-bottom: 0;
    }
    .pd-embed-form .form-control,
    .pd-embed-form .form-select {
        font-size: 0.875rem;
    }
    .pd-embed-form .pd-thumb {
        max-height: 72px;
        margin-top: 0.35rem;
    }
    .pd-embed-form .form-text {
        font-size: 0.72rem;
        margin-top: 0.2rem;
    }
</style>

<div class="pd-embed-form">
    <input type="hidden" asp-for="Uid" />
    <input type="hidden" asp-for="ProviderUid" />
    <input type="hidden" asp-for="MobileNo" />

    <div class="row g-2 mb-2">
        <div class="col-md-6">
            <div class="row g-2 align-items-center">
                <div class="col-sm-4">
                    <label class="form-label">Provider Name</label>
                </div>
                <div class="col-sm-8">
                    <input type="text" class="form-control form-control-sm" value="@(Model.ProviderName ?? "")" readonly />
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="row g-2 align-items-center">
                <div class="col-sm-4">
                    <label class="form-label">Mobile No</label>
                </div>
                <div class="col-sm-8">
                    <input type="text" class="form-control form-control-sm" value="@(Model.MobileNo ?? "")" readonly />
                </div>
            </div>
        </div>
    </div>

    <div class="row g-2 mb-2">
        <div class="col-md-6">
            <div class="row g-2 align-items-start">
                <div class="col-sm-4 pt-1">
                    <label asp-for="ProfilePhoto" class="form-label"></label>
                </div>
                <div class="col-sm-8">
                    <input asp-for="ProfilePhoto" class="form-control form-control-sm" type="file" accept=".jpg,.jpeg,.png" />
                    @if (!string.IsNullOrWhiteSpace(Model.ExistingProfilePhotoPath))
                    {
                        <img src="@UrlPath(Model.ExistingProfilePhotoPath)" alt="Profile" class="img-thumbnail pd-thumb" />
                        <div class="form-text">Leave empty to keep current photo.</div>
                    }
                    else
                    {
                        <div class="form-text">JPG/PNG — max 5 MB. Required on create.</div>
                    }
                    <span asp-validation-for="ProfilePhoto" class="text-danger small"></span>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="row g-2 align-items-start">
                <div class="col-sm-4 pt-1">
                    <label asp-for="CnicFront" class="form-label"></label>
                </div>
                <div class="col-sm-8">
                    <input asp-for="CnicFront" class="form-control form-control-sm" type="file" accept=".jpg,.jpeg,.png" />
                    @if (!string.IsNullOrWhiteSpace(Model.ExistingCnicFrontPath))
                    {
                        <img src="@UrlPath(Model.ExistingCnicFrontPath)" alt="CNIC Front" class="img-thumbnail pd-thumb" />
                        <div class="form-text">Leave empty to keep current image.</div>
                    }
                    else
                    {
                        <div class="form-text">JPG/PNG — max 5 MB. Required on create.</div>
                    }
                    <span asp-validation-for="CnicFront" class="text-danger small"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-2 mb-2">
        <div class="col-md-6">
            <div class="row g-2 align-items-start">
                <div class="col-sm-4 pt-1">
                    <label asp-for="CnicBack" class="form-label"></label>
                </div>
                <div class="col-sm-8">
                    <input asp-for="CnicBack" class="form-control form-control-sm" type="file" accept=".jpg,.jpeg,.png" />
                    @if (!string.IsNullOrWhiteSpace(Model.ExistingCnicBackPath))
                    {
                        <img src="@UrlPath(Model.ExistingCnicBackPath)" alt="CNIC Back" class="img-thumbnail pd-thumb" />
                        <div class="form-text">Leave empty to keep current image.</div>
                    }
                    else
                    {
                        <div class="form-text">JPG/PNG — max 5 MB. Required on create.</div>
                    }
                    <span asp-validation-for="CnicBack" class="text-danger small"></span>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="row g-2 align-items-start">
                <div class="col-sm-4 pt-1">
                    <label asp-for="PoliceVerification" class="form-label"></label>
                </div>
                <div class="col-sm-8">
                    <input asp-for="PoliceVerification" class="form-control form-control-sm" type="file" accept=".jpg,.jpeg,.png" />
                    @if (!string.IsNullOrWhiteSpace(Model.ExistingPoliceVerificationPath))
                    {
                        <img src="@UrlPath(Model.ExistingPoliceVerificationPath)" alt="Police Verification" class="img-thumbnail pd-thumb" />
                        <div class="form-text">Leave empty to keep current image.</div>
                    }
                    else
                    {
                        <div class="form-text">JPG/PNG — max 5 MB. Optional.</div>
                    }
                    <span asp-validation-for="PoliceVerification" class="text-danger small"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-2 mb-2">
        <div class="col-md-6">
            @if (isEdit)
            {
                <div class="row g-2 align-items-start">
                    <div class="col-sm-4 pt-1">
                        <label asp-for="VerificationRemarks" class="form-label"></label>
                    </div>
                    <div class="col-sm-8">
                        <input asp-for="VerificationRemarks" class="form-control form-control-sm" maxlength="500" placeholder="Optional remarks" />
                        <span asp-validation-for="VerificationRemarks" class="text-danger small"></span>
                    </div>
                </div>
            }
        </div>
        <div class="col-md-6"></div>
    </div>
</div>
