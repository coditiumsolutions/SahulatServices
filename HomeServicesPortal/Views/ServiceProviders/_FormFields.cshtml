@model HomeServicesPortal.Models.ViewModels.ServiceProviderFormVm

<style>
    .sp-form-grid .form-label {
        font-size: 0.78rem;
        font-weight: 600;
        color: #6c757d;
        margin-bottom: 0;
    }
    .sp-form-grid .form-control,
    .sp-form-grid .form-select {
        font-size: 0.875rem;
    }
    .sp-form-grid .sp-thumb {
        width: 56px;
        height: 56px;
        object-fit: cover;
        margin-top: 0.35rem;
    }
    .sp-form-grid .form-text {
        font-size: 0.72rem;
        margin-top: 0.2rem;
    }
</style>

<div class="sp-form-grid">
    <div class="row g-2 mb-2">
        <div class="col-md-6">
            <div class="row g-2 align-items-center">
                <div class="col-sm-4">
                    <label asp-for="FullName" class="form-label"></label>
                </div>
                <div class="col-sm-8">
                    <input asp-for="FullName" class="form-control form-control-sm" placeholder="Provider full name" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="row g-2 align-items-center">
                <div class="col-sm-4">
                    <label asp-for="CategoryUid" class="form-label"></label>
                </div>
                <div class="col-sm-8">
                    <select asp-for="CategoryUid" class="form-select form-select-sm" asp-items="Model.Categories">
                        <option value="">-- Select S-Category --</option>
                    </select>
                    <span asp-validation-for="CategoryUid" class="text-danger small"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-2 mb-2">
        <div class="col-md-6">
            <div class="row g-2 align-items-center">
                <div class="col-sm-4">
                    <label asp-for="MobileNo" class="form-label"></label>
                </div>
                <div class="col-sm-8">
                    <input asp-for="MobileNo" class="form-control form-control-sm" placeholder="03xx-xxxxxxx" />
                    <span asp-validation-for="MobileNo" class="text-danger small"></span>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="row g-2 align-items-center">
                <div class="col-sm-4">
                    <label asp-for="Cnic" class="form-label"></label>
                </div>
                <div class="col-sm-8">
                    <input asp-for="Cnic" class="form-control form-control-sm" placeholder="xxxxx-xxxxxxx-x" />
                    <span asp-validation-for="Cnic" class="text-danger small"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-2 mb-2">
        <div class="col-md-6">
            <div class="row g-2 align-items-center">
                <div class="col-sm-4">
                    <label asp-for="City" class="form-label"></label>
                </div>
                <div class="col-sm-8">
                    <select asp-for="City" class="form-select form-select-sm" asp-items="Model.CityOptions">
                        <option value="">-- Select City --</option>
                    </select>
                    <span asp-validation-for="City" class="text-danger small"></span>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="row g-2 align-items-center">
                <div class="col-sm-4">
                    <label asp-for="ExperienceYears" class="form-label"></label>
                </div>
                <div class="col-sm-8">
                    <input asp-for="ExperienceYears" class="form-control form-control-sm" type="number" min="0" max="60" />
                    <span asp-validation-for="ExperienceYears" class="text-danger small"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-2 mb-2">
        <div class="col-md-6">
            <div class="row g-2 align-items-center">
                <div class="col-sm-4">
                    <label asp-for="Rating" class="form-label"></label>
                </div>
                <div class="col-sm-8">
                    <input asp-for="Rating" class="form-control form-control-sm" type="number" min="0" max="5" step="1" />
                    <span asp-validation-for="Rating" class="text-danger small"></span>
                </div>
            </div>
        </div>
        <div class="col-md-6">
        </div>
    </div>

    <div class="row g-2 mb-2">
        <div class="col-md-6">
            <div class="row g-2 align-items-start">
                <div class="col-sm-4 pt-1">
                    <label asp-for="ProfilePicture" class="form-label"></label>
                </div>
                <div class="col-sm-8">
                    <input asp-for="ProfilePicture" class="form-control form-control-sm" type="file" accept=".jpg,.jpeg,.png,.webp" />
                    @if (!string.IsNullOrWhiteSpace(Model.ExistingProfilePicturePath))
                    {
                        <img src="@Model.ExistingProfilePicturePath" alt="Current profile" class="rounded sp-thumb" />
                        <div class="form-text">Leave empty to keep current picture.</div>
                    }
                    <span asp-validation-for="ProfilePicture" class="text-danger small"></span>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="row g-2 align-items-center">
                <div class="col-sm-4">
                    <span class="form-label">Flags</span>
                </div>
                <div class="col-sm-8">
                    <div class="form-check form-switch mb-1">
                        <input asp-for="IsVerified" class="form-check-input" type="checkbox" />
                        <label asp-for="IsVerified" class="form-check-label small"></label>
                    </div>
                    <div class="form-check form-switch mb-0">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                        <label asp-for="IsActive" class="form-check-label small"></label>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
