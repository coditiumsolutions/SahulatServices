@model HomeServicesPortal.Models.ViewModels.ServiceProviderFormVm

<style>
    .sp-form-grid .form-label {
        font-size: 0.78rem;
        font-weight: 600;
        color: #6c757d;
        margin-bottom: 0;
    }
    .sp-form-grid .form-control,
    .sp-form-grid .form-select {
        font-size: 0.875rem;
    }
    .sp-form-grid .sp-thumb {
        width: 56px;
        height: 56px;
        object-fit: cover;
        margin-top: 0.35rem;
    }
    .sp-form-grid .form-text {
        font-size: 0.72rem;
        margin-top: 0.2rem;
    }
    .sp-form-grid .sp-category-toggle {
        display: flex;
        align-items: center;
        overflow: hidden;
    }
    .sp-form-grid .sp-category-toggle::after {
        margin-left: auto;
    }
    .sp-form-grid .sp-category-menu {
        max-height: 240px;
        overflow-y: auto;
    }
    .sp-form-grid .sp-category-menu .dropdown-item {
        cursor: pointer;
    }
    .sp-form-grid .sp-title-toggle {
        display: flex;
        align-items: center;
        overflow: hidden;
    }
    .sp-form-grid .sp-title-toggle::after {
        margin-left: auto;
    }
    .sp-form-grid .sp-title-menu {
        max-height: 280px;
        overflow-y: auto;
    }
    .sp-form-grid .sp-title-menu .dropdown-item {
        cursor: pointer;
    }
    .sp-form-grid .sp-title-group-header {
        font-size: 0.68rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        color: #adb5bd;
        padding: 0.35rem 1rem 0.15rem;
    }
    .sp-form-grid .sp-title-group + .sp-title-group-header {
        border-top: 1px solid #eee;
        margin-top: 0.25rem;
    }
</style>

<div class="sp-form-grid">
    <div class="row g-2 mb-2">
        <div class="col-md-6">
            <div class="row g-2 align-items-center">
                <div class="col-sm-4">
                    <label asp-for="FullName" class="form-label"></label>
                </div>
                <div class="col-sm-8">
                    <input asp-for="FullName" class="form-control form-control-sm" placeholder="Provider full name" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="row g-2 align-items-center">
                <div class="col-sm-4">
                    <label asp-for="CategoryUids" class="form-label"></label>
                </div>
                <div class="col-sm-8">
                    <div class="dropdown" id="spCategoryDropdown">
                        <button class="form-select form-select-sm text-start sp-category-toggle" type="button"
                                data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false"
                                aria-haspopup="listbox">
                            <span class="sp-category-summary text-truncate">-- Select Categories --</span>
                        </button>
                        <ul class="dropdown-menu w-100 py-1 sp-category-menu" role="listbox" aria-multiselectable="true">
                            @foreach (var cat in Model.Categories)
                            {
                                var catUid = int.Parse(cat.Value!);
                                var isChecked = Model.CategoryUids.Contains(catUid);
                                <li>
                                    <label class="dropdown-item d-flex align-items-center gap-2 py-1">
                                        <input type="checkbox" class="form-check-input mt-0 sp-category-check"
                                               name="CategoryUids" value="@catUid" @(isChecked ? "checked" : null) />
                                        <span class="small">@cat.Text</span>
                                    </label>
                                </li>
                            }
                        </ul>
                    </div>
                    <div class="form-text" id="spCategoryLimitHint">Maximum 3 categories per provider.</div>
                    <span asp-validation-for="CategoryUids" class="text-danger small"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-2 mb-2">
        <div class="col-md-6">
            <div class="row g-2 align-items-center">
                <div class="col-sm-4">
                    <label asp-for="CategoryUid" class="form-label"></label>
                </div>
                <div class="col-sm-8">
                    <select asp-for="CategoryUid" class="form-select form-select-sm" id="spPrimaryCategory" asp-items="Model.Categories">
                        <option value="">-- Select Primary Category --</option>
                    </select>
                    <span asp-validation-for="CategoryUid" class="text-danger small"></span>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="row g-2 align-items-center">
                <div class="col-sm-4">
                    <label asp-for="ServiceTitleUids" class="form-label"></label>
                </div>
                <div class="col-sm-8">
                    <div class="dropdown" id="spTitleDropdown">
                        <button class="form-select form-select-sm text-start sp-title-toggle" type="button"
                                data-bs-toggle="dropdown" data-bs-auto-close="outside" data-bs-display="static"
                                aria-expanded="false" aria-haspopup="listbox">
                            <span class="sp-title-summary text-truncate">-- Select Service Titles --</span>
                        </button>
                        <ul class="dropdown-menu w-100 py-1 sp-title-menu" role="listbox" aria-multiselectable="true">
                            @{
                                var categoryNameByUid = Model.Categories
                                    .Where(c => int.TryParse(c.Value, out _))
                                    .ToDictionary(c => int.Parse(c.Value!), c => c.Text);
                                var titleGroups = Model.ServiceTitleOptions
                                    .GroupBy(t => t.CategoryUid)
                                    .Select(g => new
                                    {
                                        CategoryUid = g.Key,
                                        CategoryName = categoryNameByUid.TryGetValue(g.Key, out var n) ? n : $"Category {g.Key}",
                                        Titles = g.OrderBy(t => t.Title).ToList()
                                    })
                                    .OrderBy(g => g.CategoryName);
                            }
                            @foreach (var group in titleGroups)
                            {
                                <li class="sp-title-group-header">@group.CategoryName</li>
                                @foreach (var title in group.Titles)
                                {
                                    var isChecked = Model.ServiceTitleUids.Contains(title.Uid);
                                    <li class="sp-title-group" data-category-uid="@group.CategoryUid">
                                        <label class="dropdown-item d-flex align-items-center gap-2 py-1">
                                            <input type="checkbox" class="form-check-input mt-0 sp-title-check"
                                                   name="ServiceTitleUids" value="@title.Uid"
                                                   data-category-uid="@group.CategoryUid"
                                                   @(isChecked ? "checked" : null) />
                                            <span class="small">@title.Title</span>
                                        </label>
                                    </li>
                                }
                            }
                        </ul>
                    </div>
                    <span asp-validation-for="ServiceTitleUids" class="text-danger small"></span>
                </div>
            </div>
        </div>
    </div>

    <script>
        (function () {
            var categoryRoot = document.getElementById('spCategoryDropdown');
            var titleRoot = document.getElementById('spTitleDropdown');
            var primary = document.getElementById('spPrimaryCategory');
            if (!categoryRoot || !titleRoot) return;

            var categorySummary = categoryRoot.querySelector('.sp-category-summary');
            var titleSummary = titleRoot.querySelector('.sp-title-summary');
            var categoryLimitHint = document.getElementById('spCategoryLimitHint');
            var categoryPlaceholder = '-- Select Categories --';
            var titlePlaceholder = '-- Select Service Titles --';
            var CATEGORY_LIMIT = 3;

            function selectedCategoryChecks() {
                return Array.prototype.slice.call(categoryRoot.querySelectorAll('.sp-category-check:checked'));
            }

            function enforceCategoryLimit() {
                var allChecks = Array.prototype.slice.call(categoryRoot.querySelectorAll('.sp-category-check'));
                var checkedCount = allChecks.filter(function (c) { return c.checked; }).length;
                var atLimit = checkedCount >= CATEGORY_LIMIT;

                allChecks.forEach(function (c) {
                    var label = c.closest('label');
                    var disable = atLimit && !c.checked;
                    c.disabled = disable;
                    if (label) {
                        label.classList.toggle('text-muted', disable);
                        label.style.cursor = disable ? 'not-allowed' : '';
                    }
                });

                if (categoryLimitHint) {
                    if (atLimit) {
                        categoryLimitHint.textContent = 'Maximum of ' + CATEGORY_LIMIT + ' categories reached.';
                        categoryLimitHint.classList.add('text-danger');
                        categoryLimitHint.classList.remove('text-muted');
                    } else {
                        categoryLimitHint.textContent = 'Maximum ' + CATEGORY_LIMIT + ' categories per provider (' + checkedCount + '/' + CATEGORY_LIMIT + ' selected).';
                        categoryLimitHint.classList.remove('text-danger');
                    }
                }
            }

            function selectedTitleChecks() {
                return Array.prototype.slice.call(titleRoot.querySelectorAll('.sp-title-check:checked'));
            }

            function refreshCategorySummary() {
                var checks = selectedCategoryChecks();
                if (checks.length === 0) {
                    categorySummary.textContent = categoryPlaceholder;
                    categorySummary.classList.add('text-muted');
                    return;
                }
                categorySummary.classList.remove('text-muted');
                var labels = checks.map(function (c) {
                    return c.closest('label').querySelector('span').textContent.trim();
                });
                categorySummary.textContent = labels.length <= 2 ? labels.join(', ') : (labels.length + ' categories selected');
            }

            function refreshTitleSummary() {
                var checks = selectedTitleChecks();
                if (checks.length === 0) {
                    titleSummary.textContent = titlePlaceholder;
                    titleSummary.classList.add('text-muted');
                    return;
                }
                titleSummary.classList.remove('text-muted');
                var labels = checks.map(function (c) {
                    return c.closest('label').querySelector('span').textContent.trim();
                });
                titleSummary.textContent = labels.length <= 2 ? labels.join(', ') : (labels.length + ' titles selected');
            }

            function ensurePrimaryChecked() {
                if (!primary || !primary.value) return;
                var match = categoryRoot.querySelector('.sp-category-check[value="' + primary.value + '"]');
                if (match && !match.checked) {
                    match.checked = true;
                }
            }

            function refreshPrimaryOptions() {
                if (!primary) return;
                var checks = selectedCategoryChecks();
                var currentValue = primary.value;

                primary.innerHTML = '';

                var placeholderOption = document.createElement('option');
                placeholderOption.value = '';
                placeholderOption.textContent = '-- Select Primary Category --';
                primary.appendChild(placeholderOption);

                checks.forEach(function (c) {
                    var label = c.closest('label');
                    var text = label ? label.querySelector('span').textContent.trim() : c.value;
                    var option = document.createElement('option');
                    option.value = c.value;
                    option.textContent = text;
                    primary.appendChild(option);
                });

                var stillValid = checks.some(function (c) { return c.value === currentValue; });
                primary.value = stillValid ? currentValue : (checks.length === 1 ? checks[0].value : '');
            }

            function ensureCategoryForTitle(categoryUid) {
                if (!categoryUid) return true;
                var match = categoryRoot.querySelector('.sp-category-check[value="' + categoryUid + '"]');
                if (match && !match.checked) {
                    if (match.disabled) return false;
                    match.checked = true;
                    enforceCategoryLimit();
                    refreshPrimaryOptions();
                    if (primary && !primary.value) {
                        primary.value = categoryUid;
                    }
                }
                return true;
            }

            function clearTitlesForCategory(categoryUid) {
                titleRoot.querySelectorAll('.sp-title-check[data-category-uid="' + categoryUid + '"]:checked')
                    .forEach(function (cb) { cb.checked = false; });
            }

            categoryRoot.addEventListener('change', function (e) {
                if (!e.target.classList.contains('sp-category-check')) return;
                if (!e.target.checked) {
                    clearTitlesForCategory(e.target.value);
                }
                enforceCategoryLimit();
                refreshPrimaryOptions();
                refreshCategorySummary();
                refreshTitleSummary();
            });

            titleRoot.addEventListener('change', function (e) {
                if (!e.target.classList.contains('sp-title-check')) return;
                if (e.target.checked) {
                    var ok = ensureCategoryForTitle(e.target.getAttribute('data-category-uid'));
                    if (!ok) {
                        e.target.checked = false;
                        alert('This title belongs to a category you have not selected, and the ' + CATEGORY_LIMIT + '-category limit has been reached. Remove a category first.');
                    }
                    refreshCategorySummary();
                }
                refreshTitleSummary();
            });

            if (primary) {
                primary.addEventListener('change', function () {
                    ensurePrimaryChecked();
                    refreshCategorySummary();
                });
            }

            ensurePrimaryChecked();
            enforceCategoryLimit();
            refreshPrimaryOptions();
            refreshCategorySummary();
            refreshTitleSummary();
        })();
    </script>

    <div class="row g-2 mb-2">
        <div class="col-md-6">
            <div class="row g-2 align-items-center">
                <div class="col-sm-4">
                    <label asp-for="MobileNo" class="form-label"></label>
                </div>
                <div class="col-sm-8">
                    <input asp-for="MobileNo" class="form-control form-control-sm" placeholder="03XXXXXXXXX" maxlength="11" />
                    <span asp-validation-for="MobileNo" class="text-danger small"></span>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="row g-2 align-items-center">
                <div class="col-sm-4">
                    <label asp-for="Cnic" class="form-label"></label>
                </div>
                <div class="col-sm-8">
                    <input asp-for="Cnic" class="form-control form-control-sm" placeholder="XXXXX-XXXXXXX-X" maxlength="15" />
                    <span asp-validation-for="Cnic" class="text-danger small"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-2 mb-2">
        <div class="col-md-6">
            <div class="row g-2 align-items-center">
                <div class="col-sm-4">
                    <label asp-for="City" class="form-label"></label>
                </div>
                <div class="col-sm-8">
                    <select asp-for="City" class="form-select form-select-sm" asp-items="Model.CityOptions">
                        <option value="">-- Select City --</option>
                    </select>
                    <span asp-validation-for="City" class="text-danger small"></span>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="row g-2 align-items-center">
                <div class="col-sm-4">
                    <label asp-for="Zone" class="form-label"></label>
                </div>
                <div class="col-sm-8">
                    <select asp-for="Zone" class="form-select form-select-sm" asp-items="Model.ZoneOptions">
                        <option value="">-- Select Zone --</option>
                    </select>
                    <span asp-validation-for="Zone" class="text-danger small"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-2 mb-2">
        <div class="col-md-6">
            <div class="row g-2 align-items-center">
                <div class="col-sm-4">
                    <label asp-for="ExperienceYears" class="form-label"></label>
                </div>
                <div class="col-sm-8">
                    <input asp-for="ExperienceYears" class="form-control form-control-sm" type="number" min="0" max="60" />
                    <span asp-validation-for="ExperienceYears" class="text-danger small"></span>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="row g-2 align-items-center">
                <div class="col-sm-4">
                    <label asp-for="Rating" class="form-label"></label>
                </div>
                <div class="col-sm-8">
                    <input asp-for="Rating" class="form-control form-control-sm" type="number" step="any" />
                    <span asp-validation-for="Rating" class="text-danger small"></span>
                </div>
            </div>
        </div>
    </div>

    @if (Model.Uid == 0)
    {
        <div class="row g-2 mb-2">
            <div class="col-md-6">
                <div class="row g-2 align-items-center">
                    <div class="col-sm-4">
                        <label asp-for="Password" class="form-label"></label>
                    </div>
                    <div class="col-sm-8">
                        <input asp-for="Password" class="form-control form-control-sm" autocomplete="new-password" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="row g-2 align-items-center">
                    <div class="col-sm-4">
                        <label asp-for="ConfirmPassword" class="form-label"></label>
                    </div>
                    <div class="col-sm-8">
                        <input asp-for="ConfirmPassword" class="form-control form-control-sm" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="row g-2 mb-2">
        <div class="col-md-6">
            <div class="row g-2 align-items-start">
                <div class="col-sm-4 pt-1">
                    <label asp-for="ProfilePicture" class="form-label"></label>
                </div>
                <div class="col-sm-8">
                    <input asp-for="ProfilePicture" class="form-control form-control-sm" type="file" accept=".jpg,.jpeg,.png,.webp" />
                    @if (!string.IsNullOrWhiteSpace(Model.ExistingProfilePicturePath))
                    {
                        <img src="@Model.ExistingProfilePicturePath" alt="Current profile" class="rounded sp-thumb" />
                        <div class="form-text">Leave empty to keep current picture.</div>
                    }
                    <span asp-validation-for="ProfilePicture" class="text-danger small"></span>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="row g-2 align-items-center">
                <div class="col-sm-4">
                    <span class="form-label">Flags</span>
                </div>
                <div class="col-sm-8">
                    <div class="form-check form-switch mb-1">
                        <input asp-for="IsVerified" class="form-check-input" type="checkbox" />
                        <label asp-for="IsVerified" class="form-check-label small"></label>
                    </div>
                    <div class="form-check form-switch mb-0">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                        <label asp-for="IsActive" class="form-check-label small"></label>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
