@model HomeServicesPortal.Models.ViewModels.ServiceProviderFormVm

<style>
    .sp-form-grid .form-label {
        font-size: 0.78rem;
        font-weight: 600;
        color: #6c757d;
        margin-bottom: 0;
    }
    .sp-form-grid .form-control,
    .sp-form-grid .form-select {
        font-size: 0.875rem;
    }
    .sp-form-grid .sp-thumb {
        width: 56px;
        height: 56px;
        object-fit: cover;
        margin-top: 0.35rem;
    }
    .sp-form-grid .form-text {
        font-size: 0.72rem;
        margin-top: 0.2rem;
    }
    .sp-form-grid .sp-category-toggle {
        display: flex;
        align-items: center;
        overflow: hidden;
    }
    .sp-form-grid .sp-category-toggle::after {
        margin-left: auto;
    }
    .sp-form-grid .sp-category-menu {
        max-height: 240px;
        overflow-y: auto;
    }
    .sp-form-grid .sp-category-menu .dropdown-item {
        cursor: pointer;
    }
</style>

<div class="sp-form-grid">
    <div class="row g-2 mb-2">
        <div class="col-md-6">
            <div class="row g-2 align-items-center">
                <div class="col-sm-4">
                    <label asp-for="FullName" class="form-label"></label>
                </div>
                <div class="col-sm-8">
                    <input asp-for="FullName" class="form-control form-control-sm" placeholder="Provider full name" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="row g-2 align-items-center">
                <div class="col-sm-4">
                    <label asp-for="CategoryUids" class="form-label"></label>
                </div>
                <div class="col-sm-8">
                    <div class="dropdown" id="spCategoryDropdown">
                        <button class="form-select form-select-sm text-start sp-category-toggle" type="button"
                                data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false"
                                aria-haspopup="listbox">
                            <span class="sp-category-summary text-truncate">-- Select Categories --</span>
                        </button>
                        <ul class="dropdown-menu w-100 py-1 sp-category-menu" role="listbox" aria-multiselectable="true">
                            @foreach (var cat in Model.Categories)
                            {
                                var catUid = int.Parse(cat.Value!);
                                var isChecked = Model.CategoryUids.Contains(catUid);
                                <li>
                                    <label class="dropdown-item d-flex align-items-center gap-2 py-1">
                                        <input type="checkbox" class="form-check-input mt-0 sp-category-check"
                                               name="CategoryUids" value="@catUid" @(isChecked ? "checked" : null) />
                                        <span class="small">@cat.Text</span>
                                    </label>
                                </li>
                            }
                        </ul>
                    </div>
                    <span asp-validation-for="CategoryUids" class="text-danger small"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-2 mb-2">
        <div class="col-md-12">
            <div class="row g-2">
                <div class="col-sm-2">
                    <label class="form-label">Service Titles</label>
                    <div class="form-text">Optional. Shown per selected category.</div>
                </div>
                <div class="col-sm-10" id="spTitleChecklist">
                    @foreach (var group in Model.ServiceTitleOptions.GroupBy(t => t.CategoryUid))
                    {
                        var categorySelected = Model.CategoryUids.Contains(group.Key);
                        <div class="sp-title-group mb-2" data-category-uid="@group.Key" style="@(categorySelected ? "" : "display:none;")">
                            @foreach (var title in group)
                            {
                                var checkedAttr = Model.ServiceTitleUids.Contains(title.Uid) ? "checked" : null;
                                <div class="form-check form-check-inline">
                                    <input type="checkbox" class="form-check-input sp-title-check" name="ServiceTitleUids" value="@title.Uid" checked="@(checkedAttr != null)" />
                                    <label class="form-check-label small">@title.Title</label>
                                </div>
                            }
                        </div>
                    }
                    <span asp-validation-for="ServiceTitleUids" class="text-danger small"></span>
                </div>
            </div>
        </div>
    </div>

    <script>
        (function () {
            var categoryRoot = document.getElementById('spCategoryDropdown');
            var titleList = document.getElementById('spTitleChecklist');
            if (!categoryRoot || !titleList) return;
            categoryRoot.addEventListener('change', function (e) {
                if (!e.target.classList.contains('sp-category-check')) return;
                var categoryUid = e.target.value;
                var group = titleList.querySelector('.sp-title-group[data-category-uid="' + categoryUid + '"]');
                if (!group) return;
                if (e.target.checked) {
                    group.style.display = '';
                } else {
                    group.style.display = 'none';
                    // Un-check any titles under a category that's no longer selected, so a
                    // stale hidden selection can't silently persist to the next save.
                    group.querySelectorAll('.sp-title-check:checked').forEach(function (cb) {
                        cb.checked = false;
                    });
                }
            });
        })();
    </script>

    <div class="row g-2 mb-2">
        <div class="col-md-6">
            <div class="row g-2 align-items-center">
                <div class="col-sm-4">
                    <label asp-for="CategoryUid" class="form-label"></label>
                </div>
                <div class="col-sm-8">
                    <select asp-for="CategoryUid" class="form-select form-select-sm" id="spPrimaryCategory" asp-items="Model.Categories">
                        <option value="">-- Select Primary Category --</option>
                    </select>
                    <span asp-validation-for="CategoryUid" class="text-danger small"></span>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="row g-2 align-items-center">
                <div class="col-sm-4">
                    <label asp-for="MobileNo" class="form-label"></label>
                </div>
                <div class="col-sm-8">
                    <input asp-for="MobileNo" class="form-control form-control-sm" placeholder="03xx-xxxxxxx" />
                    <span asp-validation-for="MobileNo" class="text-danger small"></span>
                </div>
            </div>
        </div>
    </div>

    <script>
        (function () {
            var root = document.getElementById('spCategoryDropdown');
            var primary = document.getElementById('spPrimaryCategory');
            if (!root || !primary) return;
            var summary = root.querySelector('.sp-category-summary');
            var placeholder = '-- Select Categories --';

            function selectedChecks() {
                return Array.prototype.slice.call(root.querySelectorAll('.sp-category-check:checked'));
            }

            function ensurePrimaryChecked() {
                if (!primary.value) return;
                var match = root.querySelector('.sp-category-check[value="' + primary.value + '"]');
                if (match && !match.checked) {
                    match.checked = true;
                }
            }

            function refreshSummary() {
                var checks = selectedChecks();
                if (checks.length === 0) {
                    summary.textContent = placeholder;
                    summary.classList.add('text-muted');
                    return;
                }
                summary.classList.remove('text-muted');
                var labels = checks.map(function (c) {
                    return c.closest('label').querySelector('span').textContent.trim();
                });
                summary.textContent = labels.length <= 2 ? labels.join(', ') : (labels.length + ' categories selected');
            }

            root.addEventListener('change', function (e) {
                if (!e.target.classList.contains('sp-category-check')) return;
                if (!e.target.checked && primary.value === e.target.value) {
                    primary.value = '';
                }
                refreshSummary();
            });
            primary.addEventListener('change', function () {
                ensurePrimaryChecked();
                refreshSummary();
            });
            ensurePrimaryChecked();
            refreshSummary();
        })();
    </script>

    <div class="row g-2 mb-2">
        <div class="col-md-6">
            <div class="row g-2 align-items-center">
                <div class="col-sm-4">
                    <label asp-for="Cnic" class="form-label"></label>
                </div>
                <div class="col-sm-8">
                    <input asp-for="Cnic" class="form-control form-control-sm" placeholder="xxxxx-xxxxxxx-x" />
                    <span asp-validation-for="Cnic" class="text-danger small"></span>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="row g-2 align-items-center">
                <div class="col-sm-4">
                    <label asp-for="City" class="form-label"></label>
                </div>
                <div class="col-sm-8">
                    <select asp-for="City" class="form-select form-select-sm" asp-items="Model.CityOptions">
                        <option value="">-- Select City --</option>
                    </select>
                    <span asp-validation-for="City" class="text-danger small"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-2 mb-2">
        <div class="col-md-6">
            <div class="row g-2 align-items-center">
                <div class="col-sm-4">
                    <label asp-for="ExperienceYears" class="form-label"></label>
                </div>
                <div class="col-sm-8">
                    <input asp-for="ExperienceYears" class="form-control form-control-sm" type="number" min="0" max="60" />
                    <span asp-validation-for="ExperienceYears" class="text-danger small"></span>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="row g-2 align-items-center">
                <div class="col-sm-4">
                    <label asp-for="Rating" class="form-label"></label>
                </div>
                <div class="col-sm-8">
                    <input asp-for="Rating" class="form-control form-control-sm" type="number" step="any" />
                    <span asp-validation-for="Rating" class="text-danger small"></span>
                </div>
            </div>
        </div>
    </div>

    @if (Model.Uid == 0)
    {
        <div class="row g-2 mb-2">
            <div class="col-md-6">
                <div class="row g-2 align-items-center">
                    <div class="col-sm-4">
                        <label asp-for="Password" class="form-label"></label>
                    </div>
                    <div class="col-sm-8">
                        <input asp-for="Password" class="form-control form-control-sm" autocomplete="new-password" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="row g-2 align-items-center">
                    <div class="col-sm-4">
                        <label asp-for="ConfirmPassword" class="form-label"></label>
                    </div>
                    <div class="col-sm-8">
                        <input asp-for="ConfirmPassword" class="form-control form-control-sm" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="row g-2 mb-2">
        <div class="col-md-6">
            <div class="row g-2 align-items-start">
                <div class="col-sm-4 pt-1">
                    <label asp-for="ProfilePicture" class="form-label"></label>
                </div>
                <div class="col-sm-8">
                    <input asp-for="ProfilePicture" class="form-control form-control-sm" type="file" accept=".jpg,.jpeg,.png,.webp" />
                    @if (!string.IsNullOrWhiteSpace(Model.ExistingProfilePicturePath))
                    {
                        <img src="@Model.ExistingProfilePicturePath" alt="Current profile" class="rounded sp-thumb" />
                        <div class="form-text">Leave empty to keep current picture.</div>
                    }
                    <span asp-validation-for="ProfilePicture" class="text-danger small"></span>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="row g-2 align-items-center">
                <div class="col-sm-4">
                    <span class="form-label">Flags</span>
                </div>
                <div class="col-sm-8">
                    <div class="form-check form-switch mb-1">
                        <input asp-for="IsVerified" class="form-check-input" type="checkbox" />
                        <label asp-for="IsVerified" class="form-check-label small"></label>
                    </div>
                    <div class="form-check form-switch mb-0">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                        <label asp-for="IsActive" class="form-check-label small"></label>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
