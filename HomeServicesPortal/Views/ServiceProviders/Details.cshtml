@model HomeServicesPortal.Models.ViewModels.ServiceProviderDetailsVm
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Job Provider Details";
    string UrlPath(string? path) => string.IsNullOrWhiteSpace(path) ? "" : "/" + path.TrimStart('/');
}

<style>
    .sp-details-grid .sp-label {
        font-size: 0.78rem;
        font-weight: 600;
        color: #6c757d;
    }
    .sp-details-grid .sp-value {
        font-size: 0.9rem;
        font-weight: 500;
        color: #212529;
        word-break: break-word;
    }
    .sp-details-grid .sp-thumb {
        max-height: 96px;
    }
    .sp-details-tabs .nav-link {
        font-size: 0.9rem;
    }
</style>

<div class="mb-3">
    <a asp-action="Index" class="text-decoration-none text-muted small"><i class="fa-solid fa-arrow-left me-1"></i>Back to Job Providers</a>
    <h2 class="mt-1 mb-0 h4"><i class="fa-solid fa-eye me-2 text-primary"></i>Job Provider Details <span class="text-muted fw-normal">#@Model.Uid</span></h2>
</div>

<div class="card hs-card">
    <div class="card-header bg-white border-bottom-0 pb-0">
        <ul class="nav nav-tabs sp-details-tabs card-header-tabs" id="providerDetailsTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="provider-tab" data-bs-toggle="tab" data-bs-target="#provider-pane"
                        type="button" role="tab" aria-controls="provider-pane" aria-selected="true">
                    <i class="fa-solid fa-user-tie me-1"></i>Provider Details
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="documents-tab" data-bs-toggle="tab" data-bs-target="#documents-pane"
                        type="button" role="tab" aria-controls="documents-pane" aria-selected="false">
                    <i class="fa-solid fa-file-signature me-1"></i>Legal Documents
                    @if (Model.Documents != null)
                    {
                        <span class="badge bg-@(Model.Documents.IsVerified ? "success" : "secondary") ms-1">
                            @(Model.Documents.IsVerified ? "Verified" : "Pending")
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark ms-1">None</span>
                    }
                </button>
            </li>
        </ul>
    </div>
    <div class="card-body p-3 sp-details-grid">
        <div class="tab-content" id="providerDetailsTabContent">
            <div class="tab-pane fade show active" id="provider-pane" role="tabpanel" aria-labelledby="provider-tab" tabindex="0">
                <div class="d-flex align-items-center gap-3 mb-3">
                    @if (!string.IsNullOrWhiteSpace(Model.ProfilePicturePath))
                    {
                        <img src="@Model.ProfilePicturePath" alt="@Model.FullName" class="rounded-circle" width="56" height="56" style="object-fit:cover" />
                    }
                    else
                    {
                        <div class="rounded-circle bg-light d-flex align-items-center justify-content-center" style="width:56px;height:56px">
                            <i class="fa-solid fa-user text-muted"></i>
                        </div>
                    }
                    <div>
                        <div class="fw-semibold">@Model.FullName</div>
                        <span class="badge bg-primary">@Model.CategoryName</span>
                    </div>
                </div>

                <div class="row g-2 mb-2">
                    <div class="col-md-6">
                        <div class="row g-2">
                            <div class="col-sm-4 sp-label">Provider ID</div>
                            <div class="col-sm-8 sp-value">@Model.Uid</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="row g-2">
                            <div class="col-sm-4 sp-label">Category</div>
                            <div class="col-sm-8 sp-value">@Model.CategoryName</div>
                        </div>
                    </div>
                </div>

                <div class="row g-2 mb-2">
                    <div class="col-md-6">
                        <div class="row g-2">
                            <div class="col-sm-4 sp-label">Mobile No</div>
                            <div class="col-sm-8 sp-value">@(Model.MobileNo ?? "—")</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="row g-2">
                            <div class="col-sm-4 sp-label">CNIC</div>
                            <div class="col-sm-8 sp-value">@(Model.Cnic ?? "—")</div>
                        </div>
                    </div>
                </div>

                <div class="row g-2 mb-2">
                    <div class="col-md-6">
                        <div class="row g-2">
                            <div class="col-sm-4 sp-label">City</div>
                            <div class="col-sm-8 sp-value">@(string.IsNullOrWhiteSpace(Model.City) ? "—" : Model.City)</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="row g-2">
                            <div class="col-sm-4 sp-label">Experience</div>
                            <div class="col-sm-8 sp-value">@(Model.ExperienceYears?.ToString() ?? "0") yrs</div>
                        </div>
                    </div>
                </div>

                <div class="row g-2 mb-2">
                    <div class="col-md-6">
                        <div class="row g-2">
                            <div class="col-sm-4 sp-label">Rating</div>
                            <div class="col-sm-8 sp-value">
                                @if (Model.Rating.HasValue)
                                {
                                    <span class="text-warning"><i class="fa-solid fa-star"></i></span>
                                    @Model.Rating.Value.ToString("0.0")
                                }
                                else
                                {
                                    <text>—</text>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="row g-2">
                            <div class="col-sm-4 sp-label">Verified</div>
                            <div class="col-sm-8 sp-value">
                                <span class="badge bg-@(Model.IsVerified ? "success" : "secondary")">@(Model.IsVerified ? "Yes" : "No")</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="row g-2">
                            <div class="col-sm-4 sp-label">Active</div>
                            <div class="col-sm-8 sp-value">
                                <span class="badge bg-@(Model.IsActive ? "success" : "secondary")">@(Model.IsActive ? "Active" : "Inactive")</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row g-2 mb-2">
                    <div class="col-md-6">
                        <div class="row g-2">
                            <div class="col-sm-4 sp-label">Created On</div>
                            <div class="col-sm-8 sp-value">@(Model.CreatedOn.ToPktDisplay())</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="tab-pane fade" id="documents-pane" role="tabpanel" aria-labelledby="documents-tab" tabindex="0">
                @if (Model.Documents == null)
                {
                    <div class="text-center text-muted py-4">
                        <i class="fa-solid fa-file-circle-xmark fa-2x mb-2 d-block"></i>
                        No legal documents found for mobile <strong>@(Model.MobileNo ?? "—")</strong>.
                        <div class="mt-3">
                            <a asp-controller="ProviderDocuments" asp-action="Create" class="btn btn-outline-primary btn-sm">
                                <i class="fa-solid fa-plus me-1"></i>Add Legal Document
                            </a>
                        </div>
                    </div>
                }
                else
                {
                    var docs = Model.Documents;
                    <div class="row g-2 mb-2">
                        <div class="col-md-6">
                            <div class="row g-2">
                                <div class="col-sm-4 sp-label">Document ID</div>
                                <div class="col-sm-8 sp-value">#@docs.Uid</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="row g-2">
                                <div class="col-sm-4 sp-label">Mobile No</div>
                                <div class="col-sm-8 sp-value">@docs.MobileNo</div>
                            </div>
                        </div>
                    </div>

                    <div class="row g-2 mb-2">
                        <div class="col-md-6">
                            <div class="row g-2">
                                <div class="col-sm-4 sp-label">Status</div>
                                <div class="col-sm-8 sp-value">
                                    @if (Model.IsVerified)
                                    {
                                        <span class="badge bg-success">Verified</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Pending</span>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="row g-2">
                                <div class="col-sm-4 sp-label">Verified On</div>
                                <div class="col-sm-8 sp-value">@(docs.VerifiedOn.ToPktDisplay())</div>
                            </div>
                        </div>
                    </div>

                    <div class="row g-2 mb-2">
                        <div class="col-md-6">
                            <div class="row g-2">
                                <div class="col-sm-4 sp-label">Verified By</div>
                                <div class="col-sm-8 sp-value">@(docs.VerifiedBy?.ToString() ?? "—")</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="row g-2">
                                <div class="col-sm-4 sp-label">Remarks</div>
                                <div class="col-sm-8 sp-value">@(string.IsNullOrWhiteSpace(docs.VerificationRemarks) ? "—" : docs.VerificationRemarks)</div>
                            </div>
                        </div>
                    </div>

                    <div class="row g-2 mb-2">
                        <div class="col-md-6">
                            <div class="row g-2">
                                <div class="col-sm-4 sp-label">Created</div>
                                <div class="col-sm-8 sp-value">@docs.CreatedOn.ToPktDisplay()</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="row g-2">
                                <div class="col-sm-4 sp-label">Updated</div>
                                <div class="col-sm-8 sp-value">@(docs.UpdatedOn.ToPktDisplay())</div>
                            </div>
                        </div>
                    </div>

                    <div class="row g-2 mb-2">
                        <div class="col-md-4">
                            <div class="sp-label mb-1">Profile Photo</div>
                            @if (!string.IsNullOrWhiteSpace(docs.ProfilePhotoPath))
                            {
                                <img src="@UrlPath(docs.ProfilePhotoPath)" alt="Profile" class="img-thumbnail sp-thumb" />
                                <div><a href="@UrlPath(docs.ProfilePhotoPath)" target="_blank" rel="noopener" class="small">Open</a></div>
                            }
                            else
                            {
                                <span class="sp-value">—</span>
                            }
                        </div>
                        <div class="col-md-4">
                            <div class="sp-label mb-1">CNIC Front</div>
                            @if (!string.IsNullOrWhiteSpace(docs.CnicFrontImagePath))
                            {
                                <img src="@UrlPath(docs.CnicFrontImagePath)" alt="CNIC Front" class="img-thumbnail sp-thumb" />
                                <div><a href="@UrlPath(docs.CnicFrontImagePath)" target="_blank" rel="noopener" class="small">Open</a></div>
                            }
                            else
                            {
                                <span class="sp-value">—</span>
                            }
                        </div>
                        <div class="col-md-4">
                            <div class="sp-label mb-1">CNIC Back</div>
                            @if (!string.IsNullOrWhiteSpace(docs.CnicBackImagePath))
                            {
                                <img src="@UrlPath(docs.CnicBackImagePath)" alt="CNIC Back" class="img-thumbnail sp-thumb" />
                                <div><a href="@UrlPath(docs.CnicBackImagePath)" target="_blank" rel="noopener" class="small">Open</a></div>
                            }
                            else
                            {
                                <span class="sp-value">—</span>
                            }
                        </div>
                    </div>

                    <div class="row g-2 mb-2">
                        <div class="col-md-4">
                            <div class="sp-label mb-1">Police Verification</div>
                            @if (!string.IsNullOrWhiteSpace(docs.PoliceVerificationPath))
                            {
                                <img src="@UrlPath(docs.PoliceVerificationPath)" alt="Police Verification" class="img-thumbnail sp-thumb" />
                                <div><a href="@UrlPath(docs.PoliceVerificationPath)" target="_blank" rel="noopener" class="small">Open</a></div>
                            }
                            else
                            {
                                <span class="sp-value">—</span>
                            }
                        </div>
                    </div>

                    <div class="mt-3">
                        <a asp-controller="ProviderDocuments" asp-action="Details" asp-route-id="@docs.Uid" class="btn btn-outline-secondary btn-sm">
                            <i class="fa-solid fa-arrow-up-right-from-square me-1"></i>Open in Legal Documents
                        </a>
                        <a asp-controller="ProviderDocuments" asp-action="Edit" asp-route-id="@docs.Uid" class="btn btn-outline-primary btn-sm">
                            <i class="fa-solid fa-pen me-1"></i>Edit Documents
                        </a>
                    </div>
                }
            </div>
        </div>

        <hr class="my-3" />
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Uid" class="btn btn-primary btn-sm"><i class="fa-solid fa-pen me-1"></i>Edit</a>
            <a asp-action="Delete" asp-route-id="@Model.Uid" class="btn btn-outline-danger btn-sm"><i class="fa-solid fa-trash me-1"></i>Delete</a>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back</a>
        </div>
    </div>
</div>
