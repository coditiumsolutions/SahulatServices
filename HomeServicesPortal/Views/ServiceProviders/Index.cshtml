@model HomeServicesPortal.Models.ViewModels.ServiceProviderListVm
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "S-Providers";
}

<div class="d-flex flex-wrap align-items-center justify-content-between mb-4 gap-2">
    <div>
        <h2 class="mb-1"><i class="fa-solid fa-user-tie me-2 text-primary"></i>S-Providers</h2>
        <p class="text-muted mb-0">Manage service provider master data</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fa-solid fa-user-plus me-1"></i>Add S-Provider
    </a>
</div>

@if (TempData["SuccessMessage"] is string success)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fa-solid fa-circle-check me-2"></i>@success
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card hs-card">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-2 mb-3">
            <div class="col-md-6 col-lg-4">
                <div class="input-group">
                    <span class="input-group-text"><i class="fa-solid fa-search"></i></span>
                    <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Search name, mobile, CNIC..." />
                    <button type="submit" class="btn btn-outline-primary">Search</button>
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.Search))
            {
                <div class="col-auto">
                    <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
                </div>
            }
        </form>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th></th>
                        <th>
                            <a class="text-decoration-none text-dark" asp-action="Index"
                               asp-route-search="@Model.Search" asp-route-sort="name"
                               asp-route-sortDir="@(Model.Sort == "name" && Model.SortDir == "asc" ? "desc" : "asc")">Name</a>
                        </th>
                        <th>Mobile</th>
                        <th>
                            <a class="text-decoration-none text-dark" asp-action="Index"
                               asp-route-search="@Model.Search" asp-route-sort="category"
                               asp-route-sortDir="@(Model.Sort == "category" && Model.SortDir == "asc" ? "desc" : "asc")">Category</a>
                        </th>
                        <th>Exp. Years</th>
                        <th>
                            <a class="text-decoration-none text-dark" asp-action="Index"
                               asp-route-search="@Model.Search" asp-route-sort="rating"
                               asp-route-sortDir="@(Model.Sort == "rating" && Model.SortDir == "asc" ? "desc" : "asc")">Rating</a>
                        </th>
                        <th>Verified</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Items.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center text-muted py-4">No providers found.</td>
                        </tr>
                    }
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td style="width:48px">
                                @if (!string.IsNullOrWhiteSpace(item.ProfilePicturePath))
                                {
                                    <img src="@item.ProfilePicturePath" alt="@item.FullName" class="rounded-circle" width="40" height="40" style="object-fit:cover" />
                                }
                                else
                                {
                                    <div class="rounded-circle bg-light d-flex align-items-center justify-content-center" style="width:40px;height:40px">
                                        <i class="fa-solid fa-user text-muted"></i>
                                    </div>
                                }
                            </td>
                            <td class="fw-semibold">
                                <div>@item.FullName</div>
                                <div class="small text-muted">ID #@item.Uid</div>
                            </td>
                            <td>@(item.MobileNo ?? "—")</td>
                            <td>@item.CategoryName</td>
                            <td>@(item.ExperienceYears?.ToString() ?? "0")</td>
                            <td>
                                @if (item.Rating.HasValue)
                                {
                                    <span class="text-warning"><i class="fa-solid fa-star"></i></span>
                                    @item.Rating.Value.ToString("0.0")
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </td>
                            <td>
                                @if (item.IsVerified)
                                {
                                    <span class="badge bg-success">Yes</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">No</span>
                                }
                            </td>
                            <td>
                                <span class="badge bg-@(item.IsActive ? "success" : "secondary")">@(item.IsActive ? "Active" : "Inactive")</span>
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@item.Uid" class="btn btn-outline-secondary" title="Details"><i class="fa-solid fa-eye"></i></a>
                                    <a asp-action="Edit" asp-route-id="@item.Uid" class="btn btn-outline-primary" title="Edit"><i class="fa-solid fa-pen"></i></a>
                                    <a asp-action="Delete" asp-route-id="@item.Uid" class="btn btn-outline-danger" title="Delete"><i class="fa-solid fa-trash"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav class="mt-3" aria-label="Provider pagination">
                <ul class="pagination pagination-sm justify-content-center mb-0">
                    <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page - 1)"
                           asp-route-search="@Model.Search" asp-route-sort="@Model.Sort" asp-route-sortDir="@Model.SortDir">Previous</a>
                    </li>
                    @for (var p = 1; p <= Model.TotalPages; p++)
                    {
                        <li class="page-item @(p == Model.Page ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@p"
                               asp-route-search="@Model.Search" asp-route-sort="@Model.Sort" asp-route-sortDir="@Model.SortDir">@p</a>
                        </li>
                    }
                    <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page + 1)"
                           asp-route-search="@Model.Search" asp-route-sort="@Model.Sort" asp-route-sortDir="@Model.SortDir">Next</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>
