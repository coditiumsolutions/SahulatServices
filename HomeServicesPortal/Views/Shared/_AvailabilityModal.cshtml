@model (string, string)
<div class="modal fade" id="availabilityModal" tabindex="-1" aria-labelledby="availabilityModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content" method="post" action="/provider/availability">
            @Html.AntiForgeryToken()
            <input type="hidden" name="isOnline" value="true" />
            <input type="hidden" name="returnTo" value="@(ViewData["ReturnTo"] ?? "dashboard")" />
            <div class="modal-header">
                <h2 class="modal-title h5" id="availabilityModalTitle">Available Timing</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted">Set your active hours for new requests.</p>
                <div class="row g-3">
                    <div class="col-6">
                        <label class="form-label" for="availableFrom"><i class="fa-regular fa-sun me-1" aria-hidden="true"></i>Available From</label>
                        <input type="time" class="form-control form-control-lg" id="availableFrom" name="availableFrom" value="@Model.Item1" required />
                    </div>
                    <div class="col-6">
                        <label class="form-label" for="availableTo"><i class="fa-regular fa-moon me-1" aria-hidden="true"></i>Available To</label>
                        <input type="time" class="form-control form-control-lg" id="availableTo" name="availableTo" value="@Model.Item2" required />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary">Save</button>
            </div>
        </form>
    </div>
</div>
