@model HomeServicesPortal.Models.ViewModels.WorkInProgressVm
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = Model.PageTitle;
}

<div class="d-flex flex-wrap align-items-center justify-content-between mb-4 gap-2">
    <div>
        <h2 class="mb-1"><i class="fa-solid fa-person-digging me-2 text-warning"></i>@Model.PageTitle</h2>
        <p class="text-muted mb-0">This page is not available yet</p>
    </div>
    <span class="badge bg-warning text-dark px-3 py-2"><i class="fa-solid fa-screwdriver-wrench me-1"></i>Work in Progress</span>
</div>

<div class="card hs-card">
    <div class="card-body text-center py-5">
        <i class="fa-solid fa-person-digging fa-3x text-warning mb-3"></i>
        <h4>This section is still being rebuilt</h4>
        <p class="text-muted col-lg-6 mx-auto mb-1">
            This page is being migrated to the current data model and isn't ready for use yet.
        </p>
        @if (!string.IsNullOrWhiteSpace(Model.Reason))
        {
            <p class="text-muted col-lg-6 mx-auto small">@Model.Reason</p>
        }
        <p class="text-muted small mb-0">No action is needed from you &mdash; check back later.</p>
        <a href="/Admin" class="btn btn-outline-primary mt-3">
            <i class="fa-solid fa-arrow-left me-1"></i>Back to Dashboard
        </a>
    </div>
</div>
