@{
    var userName = User.Identity?.Name ?? "User";
    var pageTitle = ViewData["Title"]?.ToString() ?? "Dashboard";
    var path = (Context.Request.Path.Value ?? "/").ToLowerInvariant().TrimEnd('/');
    if (string.IsNullOrEmpty(path)) path = "/";

    string TabClass(params string[] prefixes) =>
        prefixes.Any(p => path.Equals(p, StringComparison.OrdinalIgnoreCase)
                          || path.StartsWith(p + "/", StringComparison.OrdinalIgnoreCase))
            ? "active" : "";

    string NavClass(params string[] prefixes) => TabClass(prefixes);

    bool IsDashboardPath() =>
        path.Equals("/admin", StringComparison.OrdinalIgnoreCase)
        || path.StartsWith("/admin/dashboard", StringComparison.OrdinalIgnoreCase);

    bool IsBookingsPath() =>
        path.StartsWith("/admin/bookings", StringComparison.OrdinalIgnoreCase) &&
        !path.StartsWith("/admin/bookingtracking", StringComparison.OrdinalIgnoreCase);

    var activeSection = "dashboard";
    if (IsDashboardPath())
        activeSection = "dashboard";
    else if (TabClass("/admin/servicecategories", "/admin/serviceproviders", "/admin/providerlocations", "/admin/provideravailability", "/admin/providerdocuments", "/admin/customers", "/admin/clients") == "active")
        activeSection = "masters";
    else if (TabClass("/admin/servicerequests", "/admin/providerquotes") == "active" || IsBookingsPath())
        activeSection = "operations";
    else if (TabClass("/admin/bookingtracking") == "active")
        activeSection = "tracking";
    else if (TabClass("/admin/payments", "/admin/reviews") == "active")
        activeSection = "finance";
    else if (TabClass("/admin/reports") == "active")
        activeSection = "reports";
    else if (TabClass("/admin/administration") == "active")
        activeSection = "administration";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle - HomeServicesPortal</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:wght@400;700&family=Open+Sans:wght@400;600;700&display=swap" />

    <style>
        :root {
            --primary: #0D6EFD;
            --success: #198754;
            --danger: #DC3545;
            --warning: #FFC107;
            --hs-dark: #0b1220;
            --hs-dark-hover: #14213D;
            --hs-navy: #003366;
            --hs-navy-dark: #002244;
            --hs-maroon: #8B1A1A;
            --hs-tab-text: #1a3a5c;
            --topbar-primary-height: 68px;
            --topbar-secondary-height: 38px;
        }

        body {
            background: #f5f7fb;
            margin: 0;
            font-family: "Open Sans", system-ui, sans-serif;
        }

        /* ---- Tier 1: navy utility bar ---- */
        .hs-topbar-primary {
            background: var(--hs-navy);
            color: #fff;
            min-height: var(--topbar-primary-height);
            border-bottom: 2px solid var(--hs-navy-dark);
            position: sticky;
            top: 0;
            z-index: 1030;
        }

        .hs-brand {
            display: flex;
            align-items: baseline;
            gap: 0.35rem;
            text-decoration: none;
            color: #fff;
            line-height: 1;
            padding: 0.5rem 0;
        }

        .hs-brand:hover {
            color: #fff;
            text-decoration: none;
        }

        .hs-brand-main {
            font-family: "Libre Baskerville", Georgia, "Times New Roman", serif;
            font-size: 2rem;
            font-weight: 700;
            letter-spacing: 0.04em;
            text-transform: uppercase;
        }

        .hs-brand-sub {
            font-family: "Libre Baskerville", Georgia, "Times New Roman", serif;
            font-size: 1.15rem;
            font-weight: 400;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            opacity: 0.95;
        }

        .hs-utility-nav {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 0;
            list-style: none;
            margin: 0;
            padding: 0;
        }

        .hs-utility-nav > li {
            display: flex;
            align-items: center;
        }

        .hs-utility-nav > li + li::before {
            content: "";
            width: 1px;
            height: 14px;
            background: rgba(255, 255, 255, 0.25);
            margin: 0 0.15rem;
        }

        .hs-utility-link {
            color: #fff;
            text-decoration: none;
            font-size: 0.8rem;
            font-weight: 600;
            padding: 0.35rem 0.65rem;
            white-space: nowrap;
            display: inline-flex;
            align-items: center;
            gap: 0.3rem;
            border: none;
            background: transparent;
            cursor: pointer;
        }

        .hs-utility-link:hover {
            color: #fff;
            text-decoration: underline;
        }

        .hs-utility-link .fa-chevron-right {
            font-size: 0.55rem;
            opacity: 0.85;
        }

        .hs-utility-link--logout:hover {
            color: #ffb4b4;
        }

        /* ---- Tier 2: gray tab bar ---- */
        .hs-topbar-secondary {
            background: linear-gradient(180deg, #ececec 0%, #d4d4d4 100%);
            min-height: var(--topbar-secondary-height);
            border-bottom: 1px solid #a8a8a8;
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.6);
            position: sticky;
            top: var(--topbar-primary-height);
            z-index: 1020;
        }

        .hs-tab-nav {
            display: flex;
            align-items: stretch;
            list-style: none;
            margin: 0;
            padding: 0;
            height: 100%;
            flex-wrap: wrap;
        }

        .hs-tab-nav > li {
            display: flex;
            align-items: stretch;
            border-right: 1px solid #b5b5b5;
        }

        .hs-tab-nav > li:first-child {
            border-left: 1px solid #b5b5b5;
        }

        .hs-tab-link {
            display: inline-flex;
            align-items: center;
            padding: 0 1.1rem;
            font-size: 0.72rem;
            font-weight: 700;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            color: var(--hs-tab-text);
            text-decoration: none;
            background: linear-gradient(180deg, #f0f0f0 0%, #dcdcdc 100%);
            border: none;
            white-space: nowrap;
            transition: color 0.12s ease, background 0.12s ease;
            height: var(--topbar-secondary-height);
        }

        .hs-tab-link:hover,
        .hs-tab-link:focus {
            color: var(--hs-maroon);
            background: linear-gradient(180deg, #f8f8f8 0%, #e6e6e6 100%);
        }

        .hs-tab-link.active {
            color: var(--hs-maroon);
            background: linear-gradient(180deg, #fff 0%, #ededed 100%);
            box-shadow: inset 0 2px 0 var(--hs-maroon);
        }

        .hs-tab-dropdown .dropdown-menu {
            border: 1px solid #b5b5b5;
            border-radius: 0 0 4px 4px;
            box-shadow: 0 6px 16px rgba(0, 0, 0, 0.12);
            font-size: 0.82rem;
            margin-top: 0;
            padding: 0.25rem 0;
        }

        .hs-tab-dropdown .dropdown-item {
            padding: 0.45rem 1rem;
            font-weight: 600;
            color: var(--hs-tab-text);
        }

        .hs-tab-dropdown .dropdown-item:hover {
            background: #f0f4f8;
            color: var(--hs-maroon);
        }

        .hs-tab-dropdown .dropdown-item.active {
            background: rgba(139, 26, 26, 0.08);
            color: var(--hs-maroon);
        }

        .hs-mobile-toggle {
            color: #fff;
            border: 1px solid rgba(255, 255, 255, 0.35);
            background: transparent;
            padding: 0.35rem 0.6rem;
            border-radius: 4px;
        }

        /* ---- Sidebar ---- */
        .hs-sidebar {
            background: var(--hs-navy);
            min-height: calc(100vh - var(--topbar-primary-height) - var(--topbar-secondary-height));
            position: sticky;
            top: calc(var(--topbar-primary-height) + var(--topbar-secondary-height));
            align-self: flex-start;
        }

        .hs-sidebar .hs-nav-link {
            color: rgba(255, 255, 255, 0.8);
            text-decoration: none;
            padding: 0.6rem 0.9rem;
            display: flex;
            gap: 0.6rem;
            align-items: center;
            border-radius: 10px;
            transition: background-color 0.15s ease;
        }

        .hs-sidebar .hs-nav-link:hover {
            background: rgba(13, 110, 253, 0.15);
            color: #fff;
        }

        .hs-sidebar .hs-nav-link.active {
            background: rgba(255, 255, 255, 0.14);
            color: #fff;
            font-weight: 600;
        }

        .hs-sidebar .hs-nav-parent {
            color: #fff;
            font-size: 0.78rem;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            padding: 0.75rem 0.9rem 0.35rem;
            display: flex;
            align-items: center;
            gap: 0.55rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.12);
            margin-bottom: 0.35rem;
        }

        .hs-sidebar .hs-nav-sublink {
            padding-left: 1.75rem;
            font-size: 0.88rem;
        }

        .hs-sidebar-panel.d-none {
            display: none !important;
        }

        .hs-sidebar .hs-nav-section-title {
            color: rgba(255, 255, 255, 0.55);
            font-size: 0.85rem;
            margin: 1.1rem 0 0.4rem;
            padding: 0 0.9rem;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }

        .hs-card {
            border: 0;
            border-radius: 14px;
            box-shadow: 0 10px 22px rgba(18, 38, 63, 0.08);
            transition: transform .15s ease, box-shadow .15s ease;
        }

        .hs-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 14px 28px rgba(18, 38, 63, 0.13);
        }

        .hs-tab-dropdown .dropdown-toggle::after {
            display: none;
        }

        .hs-tab-dropdown:hover > .dropdown-menu {
            display: block;
        }

        @@media (max-width: 991.98px) {
            .hs-brand-main {
                font-size: 1.45rem;
            }

            .hs-brand-sub {
                font-size: 0.9rem;
            }

            .hs-topbar-secondary .container-fluid {
                padding: 0;
            }

            .hs-tab-nav {
                flex-direction: column;
                width: 100%;
            }

            .hs-tab-nav > li {
                border-right: none;
                border-bottom: 1px solid #b5b5b5;
            }

            .hs-tab-nav > li:first-child {
                border-left: none;
            }

            .hs-tab-link {
                width: 100%;
                height: auto;
                padding: 0.65rem 1rem;
            }

            .hs-sidebar {
                min-height: auto;
                position: relative;
                top: 0;
            }
        }
    </style>
</head>
<body>

    <!-- Tier 1: Navy utility bar (brand + quick links) -->
    <header class="hs-topbar-primary">
        <div class="container-fluid px-3 px-lg-4">
            <div class="d-flex align-items-center justify-content-between py-2 gap-2">
                <a class="hs-brand" href="/Admin">
                    <span class="hs-brand-main">Sahulat</span>
                    <span class="hs-brand-sub">Ghar Tak</span>
                </a>

                <button class="hs-mobile-toggle d-lg-none" type="button" data-bs-toggle="collapse"
                        data-bs-target="#hsUtilityNav" aria-controls="hsUtilityNav" aria-expanded="false"
                        aria-label="Toggle utility menu">
                    <i class="fa-solid fa-bars"></i>
                </button>

                <div class="collapse d-lg-flex" id="hsUtilityNav">
                    <ul class="hs-utility-nav ms-lg-auto">
                        <li>
                            <span class="hs-utility-link d-none d-xl-inline-flex">
                                <i class="fa-regular fa-calendar"></i>
                                @DateTime.Now.ToString("dddd, dd MMM yyyy")
                            </span>
                        </li>
                        <li>
                            <span class="hs-utility-link">
                                <i class="fa-regular fa-user"></i>@userName
                                <i class="fa-solid fa-chevron-right"></i>
                            </span>
                        </li>
                        <li>
                            <a class="hs-utility-link" href="/Admin/Administration/Users">
                                Users<i class="fa-solid fa-chevron-right"></i>
                            </a>
                        </li>
                        <li>
                            <form class="m-0" asp-controller="Account" asp-action="Logout" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="hs-utility-link hs-utility-link--logout">
                                    Logout<i class="fa-solid fa-chevron-right"></i>
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </header>

    <!-- Tier 2: Gray tab navigation -->
    <nav class="hs-topbar-secondary">
        <div class="container-fluid px-0 px-lg-3">
            <button class="hs-mobile-toggle d-lg-none w-100 text-start px-3 py-2 border-0"
                    type="button" data-bs-toggle="collapse" data-bs-target="#hsTabNav"
                    aria-controls="hsTabNav" aria-expanded="false" aria-label="Toggle navigation"
                    style="background: linear-gradient(180deg, #f0f0f0 0%, #dcdcdc 100%); color: var(--hs-tab-text); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase;">
                <i class="fa-solid fa-bars me-2"></i>Menu
            </button>

            <div class="collapse d-lg-block" id="hsTabNav">
                <ul class="hs-tab-nav">
                    <li>
                        <a class="hs-tab-link @(IsDashboardPath() ? "active" : "")" href="/Admin" data-hs-section="dashboard">Dashboard</a>
                    </li>
                    <li>
                        <a class="hs-tab-link @TabClass("/admin/servicecategories", "/admin/serviceproviders", "/admin/providerlocations", "/admin/provideravailability", "/admin/providerdocuments", "/admin/customers", "/admin/clients")"
                           href="#" data-hs-section="masters">Masters</a>
                    </li>
                    <li>
                        <a class="hs-tab-link @(TabClass("/admin/servicerequests", "/admin/providerquotes") == "active" || IsBookingsPath() ? "active" : "")"
                           href="#" data-hs-section="operations">Operations</a>
                    </li>
                    <li>
                        <a class="hs-tab-link @TabClass("/admin/bookingtracking")"
                           href="#" data-hs-section="tracking">Tracking</a>
                    </li>
                    <li>
                        <a class="hs-tab-link @TabClass("/admin/payments", "/admin/reviews")" href="#" data-hs-section="finance">Finance</a>
                    </li>
                    <li>
                        <a class="hs-tab-link @TabClass("/admin/reports")"
                           href="#" data-hs-section="reports">Reports</a>
                    </li>
                    <li>
                        <a class="hs-tab-link @TabClass("/admin/administration")"
                           href="#" data-hs-section="administration">Administration</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main layout: sidebar + content -->
    <div class="container-fluid">
        <div class="row">
            <aside class="col-12 col-lg-2 hs-sidebar d-none d-lg-block" id="hsSidebar">
                <div class="px-2 pb-4 pt-3">

                    <div class="hs-sidebar-panel @(activeSection == "dashboard" ? "" : "d-none")" data-section="dashboard">
                        <div class="hs-nav-parent"><i class="fa-solid fa-gauge"></i> Dashboard</div>
                        <a class="hs-nav-link hs-nav-sublink @(IsDashboardPath() ? "active" : "")" href="/Admin">
                            <i class="fa-solid fa-chart-line"></i> Overview
                        </a>
                    </div>

                    <div class="hs-sidebar-panel @(activeSection == "masters" ? "" : "d-none")" data-section="masters">
                        <div class="hs-nav-parent"><i class="fa-solid fa-layer-group"></i> Masters</div>
                        <a class="hs-nav-link hs-nav-sublink @NavClass("/admin/servicecategories")" href="/Admin/ServiceCategories">
                            <i class="fa-solid fa-layer-group"></i> S-Categories
                        </a>
                        <a class="hs-nav-link hs-nav-sublink @NavClass("/admin/serviceproviders")" href="/Admin/ServiceProviders">
                            <i class="fa-solid fa-user-tie"></i> S-Provider
                        </a>
                        <a class="hs-nav-link hs-nav-sublink @NavClass("/admin/providerlocations")" href="/Admin/ProviderLocations">
                            <i class="fa-solid fa-location-dot"></i> P-Locations
                        </a>
                        <a class="hs-nav-link hs-nav-sublink @NavClass("/admin/provideravailability")" href="/Admin/ProviderAvailability">
                            <i class="fa-solid fa-clock"></i> P-Availability
                        </a>
                        <a class="hs-nav-link hs-nav-sublink @NavClass("/admin/providerdocuments")" href="/Admin/ProviderDocuments">
                            <i class="fa-solid fa-file-signature"></i> P-Documents
                        </a>
                        <a class="hs-nav-link hs-nav-sublink @NavClass("/admin/clients", "/admin/customers")" href="/Admin/Clients">
                            <i class="fa-solid fa-users"></i> Clients
                        </a>
                    </div>

                    <div class="hs-sidebar-panel @(activeSection == "operations" ? "" : "d-none")" data-section="operations">
                        <div class="hs-nav-parent"><i class="fa-solid fa-list-check"></i> Operations</div>
                        <a class="hs-nav-link hs-nav-sublink @NavClass("/admin/servicerequests")" href="/Admin/ServiceRequests">
                            <i class="fa-solid fa-list-check"></i> S-Requeste
                        </a>
                        <a class="hs-nav-link hs-nav-sublink @NavClass("/admin/providerquotes")" href="/Admin/ProviderQuotes">
                            <i class="fa-solid fa-tags"></i> P-Quote
                        </a>
                        <a class="hs-nav-link hs-nav-sublink @(IsBookingsPath() ? "active" : "")" href="/Admin/Bookings">
                            <i class="fa-solid fa-clipboard-list"></i> Booking
                        </a>
                    </div>

                    <div class="hs-sidebar-panel @(activeSection == "tracking" ? "" : "d-none")" data-section="tracking">
                        <div class="hs-nav-parent"><i class="fa-solid fa-location-dot"></i> Tracking</div>
                        <a class="hs-nav-link hs-nav-sublink @NavClass("/admin/bookingtracking")" href="/Admin/BookingTracking">
                            <i class="fa-solid fa-diagram-project"></i> BookingTracking
                        </a>
                    </div>

                    <div class="hs-sidebar-panel @(activeSection == "finance" ? "" : "d-none")" data-section="finance">
                        <div class="hs-nav-parent"><i class="fa-solid fa-money-bill-wave"></i> Finance</div>
                        <a class="hs-nav-link hs-nav-sublink @NavClass("/admin/payments/ledger")" href="/Admin/Payments/Ledger">
                            <i class="fa-solid fa-book"></i> Payment Ledger
                        </a>
                        <a class="hs-nav-link hs-nav-sublink @NavClass("/admin/payments/payouts")" href="/Admin/Payments/Payouts">
                            <i class="fa-solid fa-hand-holding-dollar"></i> Provider Payouts
                        </a>
                        <a class="hs-nav-link hs-nav-sublink @NavClass("/admin/payments/commissionrules")" href="/Admin/Payments/CommissionRules">
                            <i class="fa-solid fa-percent"></i> Commission Rules
                        </a>
                        <a class="hs-nav-link hs-nav-sublink @NavClass("/admin/reviews")" href="/Admin/Reviews">
                            <i class="fa-solid fa-star"></i> Reviews
                        </a>
                    </div>

                    <div class="hs-sidebar-panel @(activeSection == "reports" ? "" : "d-none")" data-section="reports">
                        <div class="hs-nav-parent"><i class="fa-solid fa-chart-column"></i> Reports</div>
                        <a class="hs-nav-link hs-nav-sublink @NavClass("/admin/reports/provider")" href="/Admin/Reports/Provider">
                            <i class="fa-solid fa-chart-column"></i> Provider Report
                        </a>
                        <a class="hs-nav-link hs-nav-sublink @NavClass("/admin/reports/customer")" href="/Admin/Reports/Customer">
                            <i class="fa-solid fa-chart-pie"></i> Customer Report
                        </a>
                        <a class="hs-nav-link hs-nav-sublink @NavClass("/admin/reports/bookings")" href="/Admin/Reports/Bookings">
                            <i class="fa-solid fa-chart-line"></i> Booking Report
                        </a>
                        <a class="hs-nav-link hs-nav-sublink @NavClass("/admin/reports/payments")" href="/Admin/Reports/Payments">
                            <i class="fa-solid fa-chart-bar"></i> Payment Report
                        </a>
                        <a class="hs-nav-link hs-nav-sublink @NavClass("/admin/reports/servicerequests")" href="/Admin/Reports/ServiceRequests">
                            <i class="fa-solid fa-chart-area"></i> Service Request Report
                        </a>
                    </div>

                    <div class="hs-sidebar-panel @(activeSection == "administration" ? "" : "d-none")" data-section="administration">
                        <div class="hs-nav-parent"><i class="fa-solid fa-user-shield"></i> Administration</div>
                        <a class="hs-nav-link hs-nav-sublink @NavClass("/admin/administration/users", "/admin/administration/roles")" href="/Admin/Administration/Users">
                            <i class="fa-solid fa-user-shield"></i> Users &amp; Roles
                        </a>
                    </div>

                </div>
            </aside>

            <main class="col-12 col-lg-10">
                <div class="p-3">
                    @RenderBody()
                </div>
            </main>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        (function () {
            const activeSection = '@activeSection';

            function showSidebarSection(section) {
                document.querySelectorAll('.hs-sidebar-panel').forEach(function (panel) {
                    panel.classList.toggle('d-none', panel.dataset.section !== section);
                });

                document.querySelectorAll('.hs-tab-link[data-hs-section]').forEach(function (tab) {
                    tab.classList.toggle('active', tab.dataset.hsSection === section);
                });
            }

            document.querySelectorAll('.hs-tab-link[data-hs-section]').forEach(function (tab) {
                tab.addEventListener('click', function (e) {
                    e.preventDefault();
                    showSidebarSection(tab.dataset.hsSection);
                });
            });

            showSidebarSection(activeSection);
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
