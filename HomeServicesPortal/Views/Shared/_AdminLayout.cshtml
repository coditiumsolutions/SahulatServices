@{
    var userName = User.Identity?.Name ?? "User";
    var pageTitle = ViewData["Title"]?.ToString() ?? "Dashboard";
    var path = (Context.Request.Path.Value ?? "/").ToLowerInvariant().TrimEnd('/');
    if (string.IsNullOrEmpty(path)) path = "/";

    string TabClass(params string[] prefixes) =>
        prefixes.Any(p => path.Equals(p, StringComparison.OrdinalIgnoreCase)
                          || path.StartsWith(p + "/", StringComparison.OrdinalIgnoreCase))
            ? "active" : "";

    string NavClass(params string[] prefixes) => TabClass(prefixes);

    var requestStatusFilter = Context.Request.Query["status"].ToString();

    bool IsServiceRequestsIndex() =>
        path.Equals("/admin/servicerequests", StringComparison.OrdinalIgnoreCase);

    string ServiceRequestNavClass(string? expectedStatus)
    {
        if (!IsServiceRequestsIndex()) return "";
        var current = requestStatusFilter?.Trim() ?? "";
        if (string.IsNullOrEmpty(expectedStatus))
            return string.IsNullOrEmpty(current) ? "active" : "";
        return string.Equals(current, expectedStatus, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    }

    bool IsDashboardPath() =>
        path.Equals("/admin", StringComparison.OrdinalIgnoreCase)
        || path.StartsWith("/admin/dashboard", StringComparison.OrdinalIgnoreCase)
        || path.StartsWith("/admin/graph", StringComparison.OrdinalIgnoreCase);

    bool IsBookingsPath() =>
        path.StartsWith("/admin/bookings", StringComparison.OrdinalIgnoreCase) &&
        !path.StartsWith("/admin/bookingtracking", StringComparison.OrdinalIgnoreCase);

    bool IsGraphPath() =>
        path.StartsWith("/admin/graph", StringComparison.OrdinalIgnoreCase);

    bool IsSummaryPath() =>
        path.Equals("/admin", StringComparison.OrdinalIgnoreCase)
        || path.StartsWith("/admin/dashboard", StringComparison.OrdinalIgnoreCase);

    string CustomerNavClass(bool requestsLink)
    {
        var onRequests = path.StartsWith("/admin/clients/requests", StringComparison.OrdinalIgnoreCase)
            || path.StartsWith("/admin/customers/requests", StringComparison.OrdinalIgnoreCase);
        var onCustomers = (path.StartsWith("/admin/clients", StringComparison.OrdinalIgnoreCase)
                || path.StartsWith("/admin/customers", StringComparison.OrdinalIgnoreCase))
            && !onRequests;
        if (requestsLink) return onRequests ? "active" : "";
        return onCustomers ? "active" : "";
    }

    var activeSection = "";
    if (IsDashboardPath())
        activeSection = "dashboard";
    else if (TabClass("/admin/clients", "/admin/customers") == "active")
        activeSection = "customers";
    else if (TabClass("/admin/serviceproviders", "/admin/providerdocuments", "/admin/mapstest") == "active")
        activeSection = "providers";
    else if (TabClass("/admin/servicerequests") == "active" || IsBookingsPath())
        activeSection = "operations";
    else if (TabClass("/admin/payments", "/admin/reviews") == "active")
        activeSection = "finance";
    else if (TabClass("/admin/reports") == "active")
        activeSection = "reports";
    else if (TabClass("/admin/services", "/admin/servicecategories", "/admin/servicetitles", "/admin/administration", "/admin/apkmanagement") == "active")
        activeSection = "setup";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle - HomeServicesPortal</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:wght@400;700&family=Open+Sans:wght@400;600;700&display=swap" />

    <style>
        :root {
            --primary: #0D6EFD;
            --success: #198754;
            --danger: #DC3545;
            --warning: #FFC107;
            --hs-dark: #0b1220;
            --hs-dark-hover: #14213D;
            --hs-navy: #003366;
            --hs-navy-dark: #002244;
            --hs-maroon: #8B1A1A;
            --hs-tab-text: #1a3a5c;
            --topbar-primary-height: 68px;
            --topbar-secondary-height: 44px;
        }

        body {
            background: #f5f7fb;
            margin: 0;
            font-family: "Open Sans", system-ui, sans-serif;
        }

        /* ---- Tier 1: navy utility bar ---- */
        .hs-topbar-primary {
            background: var(--hs-navy);
            color: #fff;
            min-height: var(--topbar-primary-height);
            border-bottom: 2px solid var(--hs-navy-dark);
            position: sticky;
            top: 0;
            z-index: 1030;
        }

        .hs-brand {
            display: flex;
            align-items: baseline;
            gap: 0.35rem;
            text-decoration: none;
            color: #fff;
            line-height: 1;
            padding: 0.5rem 0;
        }

        .hs-brand:hover {
            color: #fff;
            text-decoration: none;
        }

        .hs-brand-main {
            font-family: "Libre Baskerville", Georgia, "Times New Roman", serif;
            font-size: 2rem;
            font-weight: 700;
            letter-spacing: 0.04em;
            text-transform: uppercase;
        }

        .hs-brand-sub {
            font-family: "Libre Baskerville", Georgia, "Times New Roman", serif;
            font-size: 1.15rem;
            font-weight: 400;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            opacity: 0.95;
        }

        .hs-utility-nav {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 0;
            list-style: none;
            margin: 0;
            padding: 0;
        }

        .hs-utility-nav > li {
            display: flex;
            align-items: center;
        }

        .hs-utility-nav > li + li::before {
            content: "";
            width: 1px;
            height: 14px;
            background: rgba(255, 255, 255, 0.25);
            margin: 0 0.15rem;
        }

        .hs-utility-link {
            color: #fff;
            text-decoration: none;
            font-size: 0.8rem;
            font-weight: 600;
            padding: 0.35rem 0.65rem;
            white-space: nowrap;
            display: inline-flex;
            align-items: center;
            gap: 0.3rem;
            border: none;
            background: transparent;
            cursor: pointer;
        }

        .hs-utility-link:hover {
            color: #fff;
            text-decoration: underline;
        }

        .hs-utility-link .fa-chevron-right {
            font-size: 0.55rem;
            opacity: 0.85;
        }

        .hs-utility-link--logout:hover {
            color: #ffb4b4;
        }

        /* ---- Tier 2: gray tab bar ---- */
        .hs-topbar-secondary {
            background: linear-gradient(180deg, #ececec 0%, #d4d4d4 100%);
            min-height: var(--topbar-secondary-height);
            border-bottom: 1px solid #a8a8a8;
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.6);
            position: sticky;
            top: var(--topbar-primary-height);
            z-index: 1020;
        }

        .hs-topbar-secondary-inner {
            display: flex;
            align-items: stretch;
            gap: 0.35rem;
        }

        .hs-tab-nav {
            display: flex;
            align-items: stretch;
            list-style: none;
            margin: 0;
            padding: 0;
            height: 100%;
            flex-wrap: wrap;
            flex: 1 1 auto;
        }

        .hs-tab-nav > li {
            display: flex;
            align-items: stretch;
            border-right: 1px solid #b5b5b5;
        }

        .hs-tab-nav > li:first-child {
            border-left: 1px solid #b5b5b5;
        }

        .hs-tab-link {
            display: inline-flex;
            align-items: center;
            padding: 0 1.1rem;
            font-size: 0.72rem;
            font-weight: 700;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            color: var(--hs-tab-text);
            text-decoration: none;
            background: linear-gradient(180deg, #f0f0f0 0%, #dcdcdc 100%);
            border: none;
            white-space: nowrap;
            transition: color 0.12s ease, background 0.12s ease;
            height: var(--topbar-secondary-height);
        }

        .hs-tab-link:hover,
        .hs-tab-link:focus {
            color: var(--hs-maroon);
            background: linear-gradient(180deg, #f8f8f8 0%, #e6e6e6 100%);
        }

        .hs-tab-link.active {
            color: var(--hs-maroon);
            background: linear-gradient(180deg, #fff 0%, #ededed 100%);
            box-shadow: inset 0 2px 0 var(--hs-maroon);
        }

        /* Fixed Dashboard control — always present; not a section tab */
        .hs-tab-link--dashboard {
            gap: 0.3rem;
            padding: 0 0.85rem;
            font-size: 0.68rem;
            line-height: 1;
            height: calc(var(--topbar-secondary-height) - 8px);
            margin: 4px 0;
            align-self: center;
            border-radius: 3px;
            color: #fff !important;
            background: linear-gradient(180deg, #0a5cad 0%, #003366 100%) !important;
            box-shadow: inset 0 2px 0 #f0c14b;
        }

        .hs-tab-link--dashboard:hover,
        .hs-tab-link--dashboard:focus {
            color: #fff !important;
            background: linear-gradient(180deg, #1470c4 0%, #004080 100%) !important;
        }

        .hs-tab-link--dashboard.active {
            color: #fff !important;
            background: linear-gradient(180deg, #0d6efd 0%, #003366 100%) !important;
            box-shadow: inset 0 2px 0 #ffc107;
        }

        .hs-tab-link--dashboard i {
            font-size: 0.72rem;
        }

        .hs-tab-dropdown .dropdown-menu {
            border: 1px solid #b5b5b5;
            border-radius: 0 0 4px 4px;
            box-shadow: 0 6px 16px rgba(0, 0, 0, 0.12);
            font-size: 0.82rem;
            margin-top: 0;
            padding: 0.25rem 0;
        }

        .hs-tab-dropdown .dropdown-item {
            padding: 0.45rem 1rem;
            font-weight: 600;
            color: var(--hs-tab-text);
        }

        .hs-tab-dropdown .dropdown-item:hover {
            background: #f0f4f8;
            color: var(--hs-maroon);
        }

        .hs-tab-dropdown .dropdown-item.active {
            background: rgba(139, 26, 26, 0.08);
            color: var(--hs-maroon);
        }

        .hs-mobile-toggle {
            color: #fff;
            border: 1px solid rgba(255, 255, 255, 0.35);
            background: transparent;
            padding: 0.35rem 0.6rem;
            border-radius: 4px;
        }

        /* ---- Sidebar ---- */
        .hs-sidebar {
            background: var(--hs-navy);
            min-height: calc(100vh - var(--topbar-primary-height) - var(--topbar-secondary-height));
            position: sticky;
            top: calc(var(--topbar-primary-height) + var(--topbar-secondary-height));
            align-self: flex-start;
        }

        .hs-sidebar .hs-nav-link {
            color: #f0c14b;
            text-decoration: none;
            padding: 0.6rem 0.75rem;
            display: flex;
            flex-wrap: wrap;
            gap: 0.1rem 0.6rem;
            align-items: center;
            border-radius: 10px;
            transition: background-color 0.15s ease, color 0.15s ease;
        }

        .hs-sidebar .hs-nav-link > i:first-child {
            flex: 0 0 auto;
            color: #f5d76e;
        }

        .hs-sidebar .hs-nav-link:hover {
            background: rgba(240, 193, 75, 0.16);
            color: #ffe08a;
        }

        .hs-sidebar .hs-nav-link:hover > i:first-child {
            color: #ffe08a;
        }

        .hs-sidebar .hs-nav-link.active {
            background: rgba(240, 193, 75, 0.22);
            color: #ffd966;
            font-weight: 600;
        }

        .hs-sidebar .hs-nav-link.active > i:first-child {
            color: #ffd966;
        }

        .hs-sidebar .hs-nav-link--dashboard {
            color: #002244;
            background: linear-gradient(180deg, #ffe08a 0%, #f0c14b 100%);
            font-weight: 700;
            font-size: 0.82rem;
            border: 1px solid rgba(240, 193, 75, 0.9);
            margin-bottom: 0.65rem;
            padding: 0.4rem 0.65rem;
            border-radius: 8px;
        }

        .hs-sidebar .hs-nav-link--dashboard:hover {
            color: #002244;
            background: linear-gradient(180deg, #ffe9a8 0%, #f5cc5c 100%);
        }

        .hs-sidebar .hs-nav-link--dashboard.active {
            color: #002244;
            background: linear-gradient(180deg, #ffd966 0%, #e8b020 100%);
            box-shadow: inset 0 0 0 2px rgba(0, 51, 102, 0.25);
        }

        .hs-sidebar .hs-nav-parent {
            color: #fff;
            font-size: 0.78rem;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            padding: 0.75rem 0.9rem 0.35rem;
            display: flex;
            align-items: center;
            gap: 0.55rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.12);
            margin-bottom: 0.35rem;
        }

        .hs-sidebar .hs-nav-sublink {
            padding-left: 1.1rem;
            font-size: 0.88rem;
        }

        .hs-sidebar-panel {
            padding-top: 1.1rem;
        }

        .hs-wip-badge-row {
            flex: 0 0 100%;
            order: 3;
            display: flex;
            margin-left: calc(1em + 0.6rem);
        }

        .hs-wip-badge {
            font-size: 0.52rem;
            font-weight: 700;
            letter-spacing: 0.03em;
            text-transform: uppercase;
            background: rgba(255, 193, 7, 0.9);
            color: #3a2e00;
            border-radius: 999px;
            padding: 0.05rem 0.4rem;
            white-space: nowrap;
        }

        .hs-sidebar-panel.d-none {
            display: none !important;
        }

        .hs-notify-wrap {
            position: relative;
            display: flex;
            align-items: center;
            flex: 0 0 auto;
            margin-left: auto;
            padding: 0 0.65rem;
            align-self: stretch;
        }

        .hs-notify-toggle {
            border: 0;
            background: transparent;
            cursor: pointer;
            position: relative;
            color: #E6B422;
            padding: 0.35rem 0.55rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            line-height: 1;
        }

        .hs-notify-toggle:hover {
            color: #F5C842;
        }

        .hs-notify-toggle > i {
            font-size: 1.7rem;
            color: #E6B422;
            filter: drop-shadow(0 1px 1px rgba(0, 0, 0, 0.18));
        }

        .hs-notify-badge {
            position: absolute;
            top: -0.15rem;
            right: -0.2rem;
            min-width: 1.35rem;
            height: 1.35rem;
            padding: 0 0.35rem;
            border-radius: 999px;
            background: #dc3545;
            color: #fff;
            font-size: 0.78rem;
            font-weight: 800;
            line-height: 1.35rem;
            text-align: center;
            box-shadow: 0 0 0 2px #d8d8d8;
            display: none;
            pointer-events: none;
            z-index: 2;
        }

        .hs-notify-badge.is-visible {
            display: inline-block;
        }

        .hs-notify-panel {
            position: absolute;
            top: calc(100% + 0.45rem);
            right: 0;
            width: min(360px, 90vw);
            max-height: 420px;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            background: #fff;
            color: #1a1a1a;
            border-radius: 10px;
            box-shadow: 0 12px 28px rgba(0, 0, 0, 0.22);
            z-index: 1100;
        }

        .hs-notify-panel.d-none {
            display: none !important;
        }

        .hs-notify-panel-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0.75rem 0.9rem;
            border-bottom: 1px solid #e9ecef;
            background: #f8f9fa;
        }

        .hs-notify-panel-sub {
            font-size: 0.75rem;
            color: #6c757d;
        }

        .hs-notify-list {
            overflow-y: auto;
            max-height: 360px;
        }

        .hs-notify-item {
            display: block;
            padding: 0.75rem 0.9rem;
            text-decoration: none;
            color: inherit;
            border-bottom: 1px solid #f1f3f5;
        }

        .hs-notify-item:hover {
            background: #f8f9fa;
        }

        .hs-notify-item.unread {
            background: #eef5ff;
        }

        .hs-notify-item-title {
            font-weight: 600;
            font-size: 0.88rem;
            margin-bottom: 0.15rem;
        }

        .hs-notify-item-msg {
            font-size: 0.8rem;
            color: #495057;
        }

        .hs-notify-item-time {
            font-size: 0.72rem;
            color: #868e96;
            margin-top: 0.25rem;
        }

        .hs-notify-empty {
            padding: 1.25rem 0.9rem;
            text-align: center;
            color: #868e96;
            font-size: 0.85rem;
        }

        .hs-sidebar .hs-nav-section-title {
            color: rgba(255, 255, 255, 0.55);
            font-size: 0.85rem;
            margin: 1.1rem 0 0.4rem;
            padding: 0 0.9rem;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }

        .hs-card {
            border: 0;
            border-radius: 14px;
            box-shadow: 0 10px 22px rgba(18, 38, 63, 0.08);
            transition: transform .15s ease, box-shadow .15s ease;
        }

        .hs-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 14px 28px rgba(18, 38, 63, 0.13);
        }

        .hs-tab-dropdown .dropdown-toggle::after {
            display: none;
        }

        .hs-tab-dropdown:hover > .dropdown-menu {
            display: block;
        }

        @@media (max-width: 991.98px) {
            .hs-brand-main {
                font-size: 1.45rem;
            }

            .hs-brand-sub {
                font-size: 0.9rem;
            }

            .hs-topbar-secondary .container-fluid {
                padding: 0;
            }

            .hs-topbar-secondary-inner {
                flex-wrap: wrap;
            }

            .hs-notify-wrap {
                order: -1;
                margin-left: auto;
                padding: 0.35rem 0.75rem;
            }

            .hs-tab-nav {
                flex-direction: column;
                width: 100%;
            }

            .hs-tab-nav > li {
                border-right: none;
                border-bottom: 1px solid #b5b5b5;
            }

            .hs-tab-nav > li:first-child {
                border-left: none;
            }

            .hs-tab-link {
                width: 100%;
                height: auto;
                padding: 0.65rem 1rem;
            }

            .hs-sidebar {
                min-height: auto;
                position: relative;
                top: 0;
            }
        }
    </style>
</head>
<body>

    <!-- Tier 1: Navy utility bar (brand + quick links) -->
    <header class="hs-topbar-primary">
        <div class="container-fluid px-3 px-lg-4">
            <div class="d-flex align-items-center justify-content-between py-2 gap-2">
                <a class="hs-brand" href="/Admin">
                    <span class="hs-brand-main">Sahulat</span>
                    <span class="hs-brand-sub">Ghar Tak</span>
                </a>

                <button class="hs-mobile-toggle d-lg-none" type="button" data-bs-toggle="collapse"
                        data-bs-target="#hsUtilityNav" aria-controls="hsUtilityNav" aria-expanded="false"
                        aria-label="Toggle utility menu">
                    <i class="fa-solid fa-bars"></i>
                </button>

                <div class="collapse d-lg-flex" id="hsUtilityNav">
                    <ul class="hs-utility-nav ms-lg-auto">
                        <li>
                            <span class="hs-utility-link d-none d-xl-inline-flex">
                                <i class="fa-regular fa-calendar"></i>
                                @DateTime.Now.ToString("dddd, dd MMM yyyy")
                            </span>
                        </li>
                        <li>
                            <span class="hs-utility-link">
                                <i class="fa-regular fa-user"></i>@userName
                                <i class="fa-solid fa-chevron-right"></i>
                            </span>
                        </li>
                        <li>
                            <a class="hs-utility-link" href="/Admin/Administration/Users">
                                Users<i class="fa-solid fa-chevron-right"></i>
                            </a>
                        </li>
                        <li>
                            <form class="m-0" asp-controller="Account" asp-action="Logout" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="hs-utility-link hs-utility-link--logout">
                                    Logout<i class="fa-solid fa-chevron-right"></i>
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </header>

    <!-- Tier 2: Gray tab navigation -->
    <nav class="hs-topbar-secondary">
        <div class="container-fluid px-0 px-lg-3 hs-topbar-secondary-inner">
            <button class="hs-mobile-toggle d-lg-none text-start px-3 py-2 border-0 flex-grow-1"
                    type="button" data-bs-toggle="collapse" data-bs-target="#hsTabNav"
                    aria-controls="hsTabNav" aria-expanded="false" aria-label="Toggle navigation"
                    style="background: linear-gradient(180deg, #f0f0f0 0%, #dcdcdc 100%); color: var(--hs-tab-text); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase;">
                <i class="fa-solid fa-bars me-2"></i>Menu
            </button>

            <div class="collapse d-lg-block flex-grow-1" id="hsTabNav">
                <ul class="hs-tab-nav">
                    <li>
                        <a class="hs-tab-link hs-tab-link--dashboard @(IsDashboardPath() ? "active" : "")"
                           href="/Admin"
                           title="Dashboard (always available)">
                            <i class="fa-solid fa-gauge"></i> Dashboard
                        </a>
                    </li>
                    <li>
                        <a class="hs-tab-link @TabClass("/admin/clients", "/admin/customers")"
                           href="#" data-hs-section="customers">Customers</a>
                    </li>
                    <li>
                        <a class="hs-tab-link @TabClass("/admin/serviceproviders", "/admin/providerdocuments", "/admin/mapstest")"
                           href="#" data-hs-section="providers">Providers</a>
                    </li>
                    <li>
                        <a class="hs-tab-link @(TabClass("/admin/servicerequests") == "active" || IsBookingsPath() ? "active" : "")"
                           href="#" data-hs-section="operations">Operations</a>
                    </li>
                    <li>
                        <a class="hs-tab-link @TabClass("/admin/payments", "/admin/reviews")" href="#" data-hs-section="finance">Finance</a>
                    </li>
                    <li>
                        <a class="hs-tab-link @TabClass("/admin/reports")"
                           href="#" data-hs-section="reports">Reports</a>
                    </li>
                    <li>
                        <a class="hs-tab-link @TabClass("/admin/services", "/admin/servicecategories", "/admin/servicetitles", "/admin/administration", "/admin/apkmanagement")"
                           href="#" data-hs-section="setup">Setup</a>
                    </li>
                </ul>
            </div>

            <div class="hs-notify-wrap">
                <button type="button"
                        class="hs-notify-toggle"
                        id="hsNotifyToggle"
                        aria-expanded="false"
                        aria-controls="hsNotifyPanel"
                        title="Notifications">
                    <i class="fa-solid fa-bell"></i>
                    <span class="hs-notify-badge" id="hsNotifyBadge">0</span>
                </button>
                <div class="hs-notify-panel d-none" id="hsNotifyPanel" role="menu" aria-label="Notifications">
                    <div class="hs-notify-panel-header">
                        <strong>Notifications</strong>
                        <span class="hs-notify-panel-sub" id="hsNotifyUnreadLabel">0 unread</span>
                    </div>
