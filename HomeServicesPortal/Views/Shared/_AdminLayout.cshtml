    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.7/dist/browser/signalr.min.js"></script>
    <script>
        (function () {
            const activeSection = '@activeSection';

            function showSidebarSection(section) {
                document.querySelectorAll('.hs-sidebar-panel').forEach(function (panel) {
                    panel.classList.toggle('d-none', !section || panel.dataset.section !== section);
                });

                document.querySelectorAll('.hs-tab-link[data-hs-section]').forEach(function (tab) {
                    tab.classList.toggle('active', !!section && tab.dataset.hsSection === section);
                });
            }

            document.querySelectorAll('.hs-tab-link[data-hs-section]').forEach(function (tab) {
                tab.addEventListener('click', function (e) {
                    e.preventDefault();
                    showSidebarSection(tab.dataset.hsSection);
                });
            });

            showSidebarSection(activeSection);
        })();
    </script>
    <script>
        (function () {
            const toggle = document.getElementById('hsNotifyToggle');
            const panel = document.getElementById('hsNotifyPanel');
            const badge = document.getElementById('hsNotifyBadge');
            const list = document.getElementById('hsNotifyList');
            const unreadLabel = document.getElementById('hsNotifyUnreadLabel');
            if (!toggle || !panel || !badge || !list) return;

            const POLL_MS = 4000;
            let items = [];
            let unreadCount = 0;
            let open = false;
            let loading = false;

            function antiForgeryToken() {
                const input = document.querySelector('#hsNotifyAntiForgery input[name="__RequestVerificationToken"]');
                return input ? input.value : '';
            }

            function formatTime(value) {
                try {
                    return new Date(value).toLocaleString();
                } catch {
                    return value;
                }
            }

            function escapeHtml(value) {
                return String(value ?? '')
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;');
            }

            function render() {
                if (unreadLabel) {
                    unreadLabel.textContent = unreadCount + ' unread';
                }

                const label = unreadCount > 99 ? '99+' : String(unreadCount);
                badge.textContent = label;
                badge.setAttribute('data-count', label);
                if (unreadCount > 0) {
                    badge.classList.add('is-visible');
                    badge.style.background = '#dc3545';
                } else {
                    badge.classList.remove('is-visible');
                }

                if (!items.length) {
                    list.innerHTML = '<div class="hs-notify-empty">No notifications yet.</div>';
                    return;
                }

                list.innerHTML = items.map(function (n) {
                    const href = escapeHtml(n.linkUrl || n.LinkUrl || '#');
                    const title = escapeHtml(n.title || n.Title || 'Notification');
                    const message = escapeHtml(n.message || n.Message || '');
                    const created = n.createdOn || n.CreatedOn;
                    const isRead = n.isRead === true || n.IsRead === true;
                    return '<a class="hs-notify-item' + (isRead ? '' : ' unread') + '" href="' + href + '">' +
                        '<div class="hs-notify-item-title">' + title + '</div>' +
                        '<div class="hs-notify-item-msg">' + message + '</div>' +
                        '<div class="hs-notify-item-time">' + escapeHtml(formatTime(created)) + '</div>' +
                        '</a>';
                }).join('');
            }

            function setFeed(feed) {
                if (!feed || typeof feed !== 'object') return;
                unreadCount = Number(feed.unreadCount ?? feed.UnreadCount ?? 0) || 0;
                items = feed.items || feed.Items || items;
                render();
            }

            function setUnreadOnly(count) {
                unreadCount = Number(count) || 0;
                render();
            }

            async function loadFeed() {
                if (loading) return;
                loading = true;
                try {
                    const res = await fetch('/Admin/Notifications/feed?_=' + Date.now(), {
                        credentials: 'same-origin',
                        headers: { 'Accept': 'application/json' },
                        cache: 'no-store'
                    });
                    if (!res.ok) return;
                    const data = await res.json();
                    setFeed(data);
                } catch {
                    // Keep last known badge; next poll / SignalR can recover.
                } finally {
                    loading = false;
                }
            }

            async function pollUnreadCount() {
                if (open) return;
                try {
                    const res = await fetch('/Admin/Notifications/unread-count?_=' + Date.now(), {
                        credentials: 'same-origin',
                        headers: { 'Accept': 'application/json' },
                        cache: 'no-store'
                    });
                    if (!res.ok) return;
                    const data = await res.json();
                    const next = Number(data.unreadCount ?? data.UnreadCount ?? 0) || 0;
                    if (next !== unreadCount) {
                        // Count changed — refresh full feed so the dropdown stays in sync.
                        await loadFeed();
                    }
                } catch {
                    // Ignore transient network errors.
                }
            }

            async function markAllRead() {
                if (unreadCount === 0) return;
                const body = new URLSearchParams();
                body.set('__RequestVerificationToken', antiForgeryToken());
                try {
                    const res = await fetch('/Admin/Notifications/mark-read', {
                        method: 'POST',
                        credentials: 'same-origin',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                        body: body.toString()
                    });
                    if (!res.ok) return;
                    unreadCount = 0;
                    items = items.map(function (n) {
                        return Object.assign({}, n, { isRead: true, IsRead: true });
                    });
                    render();
                } catch {
                    // Leave unread state; user can reopen.
                }
            }

            async function openPanel() {
                open = true;
                panel.classList.remove('d-none');
                toggle.setAttribute('aria-expanded', 'true');
                await loadFeed();
                await markAllRead();
            }

            function closePanel() {
                open = false;
                panel.classList.add('d-none');
                toggle.setAttribute('aria-expanded', 'false');
            }

            toggle.addEventListener('click', function (e) {
                e.preventDefault();
                e.stopPropagation();
                if (open) closePanel();
                else openPanel();
            });

            document.addEventListener('click', function (e) {
                if (!open) return;
                if (panel.contains(e.target) || toggle.contains(e.target)) return;
                closePanel();
            });

            document.addEventListener('visibilitychange', function () {
                if (!document.hidden) {
                    loadFeed();
                }
            });

            // Initial load + polling fallback (works even if SignalR fails).
            loadFeed();
            setInterval(pollUnreadCount, POLL_MS);

            if (window.signalR) {
                const connection = new signalR.HubConnectionBuilder()
                    .withUrl('/hubs/admin-notifications')
                    .withAutomaticReconnect([0, 2000, 5000, 10000, 30000])
                    .build();

                connection.on('ReceiveNotification', function (payload) {
                    if (!payload) {
                        loadFeed();
                        return;
                    }
                    const notification = payload.notification || payload.Notification;
                    const nextCount = payload.unreadCount ?? payload.UnreadCount;
                    if (typeof nextCount === 'number') {
                        setUnreadOnly(nextCount);
                    } else {
                        setUnreadOnly(unreadCount + 1);
                    }
                    if (notification) {
                        const id = notification.uid || notification.Uid;
                        items = items.filter(function (n) {
                            return (n.uid || n.Uid) !== id;
                        });
                        items = [notification].concat(items).slice(0, 20);
                        render();
                    } else {
                        loadFeed();
                    }
                });

                connection.on('NotificationsMarkedRead', function (payload) {
                    setUnreadOnly(payload && (payload.unreadCount ?? payload.UnreadCount) || 0);
                    items = items.map(function (n) {
                        return Object.assign({}, n, { isRead: true, IsRead: true });
                    });
                    render();
                });

                connection.onreconnected(function () { loadFeed(); });
                connection.start()
                    .then(function () { loadFeed(); })
                    .catch(function () { /* polling keeps badge fresh */ });
            }
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
