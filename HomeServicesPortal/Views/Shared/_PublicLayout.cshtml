@inject IConfiguration Configuration
<!DOCTYPE html>
<html lang="en">
<head>
    @{
        // Configurable via Marketing:MetaPixelId; defaults to the business's existing Pixel so production
        // (whose appsettings are not deployed from the repo) keeps tracking without a config change.
        var metaPixelId = Configuration["Marketing:MetaPixelId"] ?? "943484539264647";
        var pageTitle = $"{ViewData["Title"]} - Sahulat Ghar Tak";
        var pageDescription = ViewData["Description"] as string
            ?? "Sahulat Ghar Tak connects households across Pakistan with verified electricians, plumbers, cleaners, AC technicians, carpenters and painters — book trusted home service professionals in minutes.";
        var robotsContent = ViewData["Robots"] as string ?? "index, follow";
        // Always https on the production host (nginx hides the real scheme from the app); see PublicUrl.
        var siteBase = HomeServicesPortal.Helpers.PublicUrl.Base(Context.Request);
        var canonicalUrl = $"{siteBase}{Context.Request.Path}";
        var ogImagePath = ViewData["OgImage"] as string ?? "/img/og-default.jpg";
        var ogImageUrl = $"{siteBase}{ogImagePath}";
        var requestPath = (Context.Request.Path.Value ?? "/").TrimEnd('/');
        var breadcrumbJson = requestPath.Length == 0 || ViewData["Title"] == null
            ? null
            : System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, object>
            {
                ["@context"] = "https://schema.org",
                ["@type"] = "BreadcrumbList",
                ["itemListElement"] = new object[]
                {
                    new Dictionary<string, object> { ["@type"] = "ListItem", ["position"] = 1, ["name"] = "Home", ["item"] = siteBase + "/" },
                    new Dictionary<string, object> { ["@type"] = "ListItem", ["position"] = 2, ["name"] = ViewData["Title"]!.ToString()!, ["item"] = canonicalUrl }
                }
            });
    }
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="@pageDescription" />
    <meta name="keywords" content="home services Pakistan, electrician Pakistan, plumber Pakistan, AC technician, carpenter, painter, verified home service providers, book home services online" />
    <meta name="robots" content="@robotsContent" />
    <link rel="canonical" href="@canonicalUrl" />
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <title>@pageTitle</title>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Sahulat Ghar Tak" />
    <meta property="og:title" content="@pageTitle" />
    <meta property="og:description" content="@pageDescription" />
    <meta property="og:url" content="@canonicalUrl" />
    <meta property="og:image" content="@ogImageUrl" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@pageTitle" />
    <meta name="twitter:description" content="@pageDescription" />
    <meta name="twitter:image" content="@ogImageUrl" />

    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    @* Icons and web fonts load without blocking first paint; text shows in a fallback font until they arrive (display=swap). *@
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" media="print" onload="this.media='all'" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:wght@400;700&family=Open+Sans:wght@400;600;700&display=swap" media="print" onload="this.media='all'" />
    <noscript>
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:wght@400;700&family=Open+Sans:wght@400;600;700&display=swap" />
    </noscript>
    <link rel="stylesheet" href="~/css/site-header.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/public-home.css" asp-append-version="true" />
    <link rel="manifest" href="~/manifest.json" />
    <partial name="_OrganizationSchema" />
    @if (breadcrumbJson != null)
    {
        <script type="application/ld+json">@Html.Raw(breadcrumbJson)</script>
    }
    @if (!string.IsNullOrWhiteSpace(metaPixelId))
    {
        <!-- Meta Pixel Code (shared by every public page) -->
        <script>
        !function(f,b,e,v,n,t,s)
        {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
        n.callMethod.apply(n,arguments):n.queue.push(arguments)};
        if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
        n.queue=[];
        // Calls made before the script arrives are queued; the script itself loads after the page has loaded.
        var load=function(){t=b.createElement(e);t.async=!0;
        t.src=v;s=b.getElementsByTagName(e)[0];
        s.parentNode.insertBefore(t,s)};
        if(b.readyState==='complete')load();else f.addEventListener('load',load)}(window, document,'script',
        'https://connect.facebook.net/en_US/fbevents.js');
        fbq('init', '@metaPixelId');
        fbq('track', 'PageView');
        </script>
        <noscript>
            <img height="1" width="1" style="display:none"
                 src="https://www.facebook.com/tr?id=@metaPixelId&ev=PageView&noscript=1"
                 alt="" />
        </noscript>
        <!-- End Meta Pixel Code -->
    }
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="public-home">
    <partial name="_SiteHeaderPublic" />
    <main id="main-content">
        @RenderBody()
    </main>
    <footer class="hs-footer">
        <div class="hs-footer-top">
            <div class="container">
                <div class="hs-footer-grid">
                    <div class="hs-footer-brand">
                        <a class="hs-brand hs-footer-logo" href="/">
                            <span class="hs-brand-main">Sahulat</span>
                            <span class="hs-brand-sub">Ghar Tak</span>
                        </a>
                        <p class="hs-footer-tagline">
                            Trusted home service professionals, verified and dispatched to your doorstep
                            in Islamabad and Rawalpindi, with a focus on Bahria Town.
                        </p>
                        <div class="hs-footer-social">
                            <a href="tel:+923225040823" aria-label="Call us"><i class="fa-solid fa-phone"></i></a>
                            <a href="mailto:sahulatghartak@gmail.com" aria-label="Email us"><i class="fa-solid fa-envelope"></i></a>
                            <a href="https://www.facebook.com/p/Sahulat-Ghar-Tak-61594810288945/" target="_blank" rel="noopener noreferrer me" aria-label="Sahulat Ghar Tak on Facebook"><i class="fa-brands fa-facebook-f"></i></a>
                            <a href="https://www.instagram.com/sahulatghartak" target="_blank" rel="noopener noreferrer me" aria-label="Sahulat Ghar Tak on Instagram"><i class="fa-brands fa-instagram"></i></a>
                            <a href="https://www.youtube.com/@@sahulatghartak" target="_blank" rel="noopener noreferrer me" aria-label="Sahulat Ghar Tak on YouTube"><i class="fa-brands fa-youtube"></i></a>
                            <a href="https://www.tiktok.com/@@sahulatghartak" target="_blank" rel="noopener noreferrer me" aria-label="Sahulat Ghar Tak on TikTok"><i class="fa-brands fa-tiktok"></i></a>
                        </div>
                    </div>

                    <div class="hs-footer-col">
                        <p class="hs-footer-heading">Explore</p>
                        <ul class="hs-footer-links">
                            <li><a href="/">Home</a></li>
                            <li><a href="/about">About</a></li>
                            <li><a href="/#services">Services</a></li>
                            <li><a href="/home-maintenance">Home Maintenance</a></li>
                            <li><a href="/specialized-services">Specialized Services</a></li>
                            <li><a href="/property-and-legal-services">Property &amp; Legal</a></li>
                            <li><a href="/#providers">Providers</a></li>
                            <li><a href="/#how-it-works">How It Works</a></li>
                            <li><a href="/#faq">FAQ</a></li>
                            <li><a href="/Home/DownloadApp">Download App</a></li>
                        </ul>
                    </div>

                    <div class="hs-footer-col">
                        <p class="hs-footer-heading">Legal &amp; Account</p>
                        <ul class="hs-footer-links">
                            <li><a href="/privacy-policy">Privacy Policy</a></li>
                            <li><a href="/delete-account">Delete Account</a></li>
                            <li><a href="/#contact">Contact</a></li>
                        </ul>
                    </div>

                    <div class="hs-footer-col">
                        <p class="hs-footer-heading">Reach Us</p>
                        <ul class="hs-footer-links hs-footer-contact">
                            <li><i class="fa-solid fa-phone"></i><a href="tel:+923225040823">0322-5040823</a></li>
                            <li><i class="fa-solid fa-envelope"></i><a href="mailto:sahulatghartak@gmail.com">sahulatghartak@gmail.com</a></li>
                            <li><i class="fa-solid fa-location-dot"></i><span>Bahria Town, Islamabad &amp; Rawalpindi, Pakistan</span></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
        <div class="hs-footer-bottom">
            <div class="container">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <span>&copy; @DateTime.Now.Year Sahulat Ghar Tak &middot; Coditum Solutions. All rights reserved.</span>
                    <span class="hs-footer-bottom-links">
                        <a href="/privacy-policy">Privacy</a>
                        <span aria-hidden="true">&middot;</span>
                        <a href="/delete-account">Delete Account</a>
                    </span>
                </div>
            </div>
        </div>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
    // Count taps on Google Play / App Store links as a Meta "Lead" so app-install intent is measurable.
    document.addEventListener('click', function (e) {
        var a = e.target.closest && e.target.closest('a[href*="play.google.com"], a[href*="apps.apple.com"]');
        if (!a || typeof fbq !== 'function') return;
        fbq('track', 'Lead', { content_name: a.href.indexOf('apple.com') > -1 ? 'app_store' : 'google_play' });
    });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
