@{
    var path = (Context.Request.Path.Value ?? "/").ToLowerInvariant();
    var userType = User.FindFirst("UserType")?.Value;
    var isClient = User.Identity?.IsAuthenticated == true
        && userType != null
        && userType.Equals("Client", StringComparison.OrdinalIgnoreCase);
    var isProvider = User.Identity?.IsAuthenticated == true
        && userType != null
        && userType.Equals("Provider", StringComparison.OrdinalIgnoreCase);
    var isPortalUser = isClient || isProvider;
    // An account with both a client and a provider profile can switch between the two dashboards.
    var isDualRole = isPortalUser
        && int.TryParse(User.FindFirst("ClientId")?.Value, out var clientProfileId) && clientProfileId > 0
        && int.TryParse(User.FindFirst("ProviderId")?.Value, out var providerProfileId) && providerProfileId > 0;
    var notificationsHref = isProvider ? "/provider/notifications" : "/client/notifications";
    var switchTo = isProvider ? "Client" : "Provider";
    var displayName = User.Identity?.Name;
    var homeHref = isProvider ? "/provider/dashboard" : isClient ? "/client/dashboard" : "/";

    // Phone shell (portal-mobile.css): an app bar with the page title and a bottom tab bar, like the Flutter app.
    var cleanPath = path.TrimEnd('/');
    var isTabPage = isPortalUser && cleanPath is "/client/dashboard" or "/client/services" or "/client/requests" or "/client/profile"
        or "/client/notifications" or "/provider/dashboard" or "/provider/requests" or "/provider/bookings"
        or "/provider/wallet" or "/provider/profile" or "/provider/notifications";
    (string Title, string? Sub) appBarText = cleanPath switch
    {
        "/client/dashboard" => ("Sahulat Ghar Tak", "Quality Services Delivered to Your Doorstep"),
        "/client/services" => ("Services", "Choose a service to get started"),
        "/client/requests" => ("My Service Requests", "Track your requests here"),
        "/client/profile" => ("Profile", null),
        "/client/notifications" or "/provider/notifications" => ("Notifications", null),
        "/provider/dashboard" => ("Welcome back!", null),
        "/provider/requests" => ("Incoming Requests", "New job offers from staff"),
        "/provider/bookings" => ("My Bookings", null),
        "/provider/wallet" => ("Wallet", "Balance and payment history"),
        "/provider/profile" => ("Provider Profile", null),
        _ => (ViewData["Title"]?.ToString() ?? "Sahulat Ghar Tak", null)
    };
    var appBarTitle = ViewData["MobileTitle"] as string ?? appBarText.Title;
    var appBarSub = ViewData["MobileSubtitle"] as string ?? appBarText.Sub;
    var appBarSearch = ViewData["MobileSearch"] is true;
    var showBottomNav = isPortalUser && !path.StartsWith("/provider/pending");
    var bottomNav = isProvider
        ? new[]
        {
            (Label: "Home", Icon: "home", Href: "/provider/dashboard", Active: cleanPath == "/provider/dashboard"),
            (Label: "Requests", Icon: "inbox", Href: "/provider/requests", Active: path.StartsWith("/provider/requests")),
            (Label: "Bookings", Icon: "work", Href: "/provider/bookings", Active: path.StartsWith("/provider/bookings")),
            (Label: "Wallet", Icon: "account_balance_wallet", Href: "/provider/wallet", Active: path.StartsWith("/provider/wallet")),
            (Label: "Profile", Icon: "person", Href: "/provider/profile",
                Active: path.StartsWith("/provider/profile") || path.StartsWith("/provider/documents") || path.StartsWith("/provider/categories"))
        }
        : new[]
        {
            (Label: "Home", Icon: "home", Href: "/client/dashboard", Active: cleanPath == "/client/dashboard" || path.StartsWith("/client/services")),
            (Label: "Requests", Icon: "receipt_long", Href: "/client/requests", Active: path.StartsWith("/client/requests")),
            (Label: "Profile", Icon: "person", Href: "/client/profile", Active: path.StartsWith("/client/profile"))
        };

    string TabActive(string segment)
    {
        if (segment == "home")
        {
            return path is "/" or "/home" or "/home/index"
                or "/client/dashboard" or "/provider/dashboard"
                ? "active" : "";
        }

        if (segment == "services")
        {
            return path.StartsWith("/client/services", StringComparison.OrdinalIgnoreCase) ? "active" : "";
        }

        return path.Contains($"/{segment}", StringComparison.OrdinalIgnoreCase)
            || path.EndsWith($"/{segment}", StringComparison.OrdinalIgnoreCase)
            ? "active" : "";
    }
}

@if (isPortalUser)
{
    <header class="hs-appbar d-lg-none @(appBarSearch ? "hs-appbar--search" : "")">
        <div class="hs-appbar-bg" aria-hidden="true"><span></span><span></span></div>
        <div class="hs-appbar-row">
            @if (isTabPage)
            {
                <a class="hs-appbar-logo" href="@homeHref" aria-label="Home"><img src="~/img/app-logo.png" alt="" width="46" height="46" /></a>
            }
            else
            {
                <button type="button" class="hs-appbar-btn" data-home="@homeHref" aria-label="Back"
                        onclick="if (history.length > 1) { history.back(); } else { location.href = this.dataset.home; }">
                    <span class="ms" aria-hidden="true">arrow_back</span>
                </button>
            }
            <div class="hs-appbar-text">
                <div class="hs-appbar-title">@appBarTitle</div>
                @if (!string.IsNullOrWhiteSpace(appBarSub))
                {
                    <div class="hs-appbar-sub">@appBarSub</div>
                }
            </div>
            @if (ViewData["MobileOnline"] is bool mobileOnline)
            {
                if (mobileOnline)
                {
                    <form method="post" action="/provider/availability" class="m-0">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="isOnline" value="false" />
                        <button type="submit" class="hs-online-pill is-on" aria-label="Online. Tap to go offline">
                            <i class="fa-solid fa-tower-broadcast" aria-hidden="true"></i><span>Online</span>
                        </button>
                    </form>
                }
                else
                {
                    <button type="button" class="hs-online-pill" data-bs-toggle="modal" data-bs-target="#availabilityModal" aria-label="Offline. Tap to go online">
                        <i class="fa-solid fa-tower-broadcast" aria-hidden="true"></i><span>Offline</span>
                    </button>
                }
            }
            <a class="hs-appbar-btn hs-bell" href="@notificationsHref" data-count-url="@notificationsHref/count" aria-label="Notifications">
                <span class="ms" aria-hidden="true">notifications</span>
                <span class="hs-bell-badge d-none js-bell-badge" aria-hidden="true"></span>
            </a>
            <button type="button" class="hs-appbar-btn" data-bs-toggle="modal" data-bs-target="#hsPublicUtilityModal" aria-haspopup="dialog" aria-label="Open menu">
                <span class="ms" aria-hidden="true">menu</span>
            </button>
        </div>
        @if (appBarSearch)
        {
            <div class="hs-appbar-search">
                <span class="ms" aria-hidden="true">search</span>
                <input type="search" id="serviceSearchM" placeholder="Search services..." autocomplete="off"
                       aria-label="Search services" aria-controls="serviceSearchResultsM" />
                <ul class="list-group client-search-results d-none" id="serviceSearchResultsM" role="listbox"></ul>
            </div>
        }
    </header>
}

<header class="hs-topbar-primary @(isPortalUser ? "hs-desktop-only" : "")">
    <div class="container-fluid px-3 px-lg-4">
        <div class="d-flex align-items-center justify-content-between py-2 gap-2">
            <a class="hs-brand" href="@homeHref">
                <span class="hs-brand-main">Sahulat</span>
                <span class="hs-brand-sub">Ghar Tak</span>
            </a>

            <button class="hs-mobile-toggle d-lg-none" type="button" data-bs-toggle="modal"
                    data-bs-target="#hsPublicUtilityModal" aria-haspopup="dialog"
                    aria-label="Open quick links">
                <i class="fa-solid fa-bars"></i>
            </button>

            <div class="d-none d-lg-flex" id="hsPublicUtilityNav">
                <ul class="hs-utility-nav ms-lg-auto">
                    <li>
                        <span class="hs-utility-link d-none d-xl-inline-flex">
                            <i class="fa-regular fa-calendar"></i>
                            @PktTimeHelper.NowPkt.ToString("dddd, dd MMM yyyy")
                        </span>
                    </li>
                    @if (isPortalUser)
                    {
                        <li>
                            <a class="hs-utility-link hs-bell" href="@notificationsHref" data-count-url="@notificationsHref/count" aria-label="Notifications">
                                <i class="fa-regular fa-bell"></i>
                                <span class="hs-bell-badge d-none js-bell-badge" aria-hidden="true"></span>
                            </a>
                        </li>
                        <li>
                            <span class="hs-utility-link">
                                <i class="fa-solid fa-user"></i>
                                @(displayName ?? userType)
                                <span class="hs-utility-role">(@(isProvider ? "Provider" : "Client"))</span>
                            </span>
                        </li>
                        <li>
                            <form method="post" action="/logout" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="hs-utility-link border-0 bg-transparent">
                                    Logout<i class="fa-solid fa-chevron-right"></i>
                                </button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li>
                            <a class="hs-utility-link" href="/login">
                                Login<i class="fa-solid fa-chevron-right"></i>
                            </a>
                        </li>
                        <li>
                            <a class="hs-utility-link" href="/signup">
                                Signup<i class="fa-solid fa-chevron-right"></i>
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
</header>

<nav class="hs-topbar-secondary @(isPortalUser ? "hs-desktop-only" : "")">
    <div class="container-fluid px-0 px-lg-3">
        <button class="hs-mobile-toggle d-lg-none w-100 text-start px-3 py-2 border-0"
                type="button" data-bs-toggle="collapse" data-bs-target="#hsPublicTabNav"
                aria-controls="hsPublicTabNav" aria-expanded="false" aria-label="Toggle navigation menu"
                style="background: linear-gradient(180deg, #f0f0f0 0%, #dcdcdc 100%); color: var(--hs-tab-text); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase;">
            <i class="fa-solid fa-bars me-2"></i>Menu
        </button>

        <div class="collapse d-lg-block" id="hsPublicTabNav">
            @if (isClient)
            {
                <ul class="hs-tab-nav">
                    <li>
                        <a class="hs-tab-link @TabActive("home")" href="/client/dashboard">Home</a>
                    </li>
                    <li>
                        <a class="hs-tab-link @TabActive("services")" href="/client/services">Services</a>
                    </li>
                    <li>
                        <a class="hs-tab-link @TabActive("requests")" href="/client/requests">Requests</a>
                    </li>
                    <li>
                        <a class="hs-tab-link @TabActive("profile")" href="/client/profile">Profile</a>
                    </li>
                    @if (isDualRole)
                    {
                        <li class="hs-tab-link-spacer">
                            <form method="post" action="/switch-role" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="to" value="@switchTo" />
                                <button type="submit" class="hs-tab-link border-0 bg-transparent">
                                    <i class="fa-solid fa-repeat me-1"></i>Switch to @switchTo Dashboard
                                </button>
                            </form>
                        </li>
                    }
                </ul>
            }
            else if (isProvider)
            {
                <ul class="hs-tab-nav">
                    <li>
                        <a class="hs-tab-link @TabActive("home")" href="/provider/dashboard">Home</a>
                    </li>
                    <li>
                        <a class="hs-tab-link @TabActive("requests")" href="/provider/requests">Requests</a>
                    </li>
                    <li>
                        <a class="hs-tab-link @TabActive("bookings")" href="/provider/bookings">Bookings</a>
                    </li>
                    <li>
                        <a class="hs-tab-link @TabActive("wallet")" href="/provider/wallet">Wallet</a>
                    </li>
                    <li>
                        <a class="hs-tab-link @TabActive("profile")" href="/provider/profile">Profile</a>
                    </li>
                    @if (isDualRole)
                    {
                        <li class="hs-tab-link-spacer">
                            <form method="post" action="/switch-role" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="to" value="@switchTo" />
                                <button type="submit" class="hs-tab-link border-0 bg-transparent">
                                    <i class="fa-solid fa-repeat me-1"></i>Switch to @switchTo Dashboard
                                </button>
                            </form>
                        </li>
                    }
                </ul>
            }
            else
            {
                <ul class="hs-tab-nav">
                    <li>
                        <a class="hs-tab-link @TabActive("home")" href="/">Home</a>
                    </li>
                    <li>
                        <a class="hs-tab-link @(path.StartsWith("/about") ? "active" : "")" href="/about">About</a>
                    </li>
                    <li>
                        <a class="hs-tab-link @TabActive("services")" href="/#services">Services</a>
                    </li>
                    <li>
                        <a class="hs-tab-link @TabActive("providers")" href="/#providers">Providers</a>
                    </li>
                    <li>
                        <a class="hs-tab-link @TabActive("how-it-works")" href="/#how-it-works">How It Works</a>
                    </li>
                    <li>
                        <a class="hs-tab-link @TabActive("contact")" href="/#contact">Contact</a>
                    </li>
                    <li class="hs-tab-link-spacer">
                        <a class="hs-tab-link @TabActive("downloadapp")" href="/Home/DownloadApp">Download App</a>
                    </li>
                </ul>
            }
        </div>
    </div>
</nav>

@* Mobile quick links: the same links as the desktop utility bar, in their own pop-up. Kept outside the sticky
   header so its stacking context can't put the modal behind the backdrop. *@
<div class="modal fade hs-quick-modal" id="hsPublicUtilityModal" tabindex="-1" aria-labelledby="hsPublicUtilityModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title" id="hsPublicUtilityModalLabel">Quick Links</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="hs-quick-date"><i class="fa-regular fa-calendar"></i>@PktTimeHelper.NowPkt.ToString("dddd, dd MMM yyyy")</p>
                <div class="list-group list-group-flush">
                    @if (isClient)
                    {
                        <div class="hs-quick-link">
                            <span><i class="fa-solid fa-user"></i>@(displayName ?? userType) (Client)</span>
                        </div>
                        <a class="hs-quick-link" href="/client/dashboard">
                            <span><i class="fa-solid fa-house"></i>Home</span><i class="fa-solid fa-chevron-right"></i>
                        </a>
                        <a class="hs-quick-link" href="/client/services">
                            <span><i class="fa-solid fa-screwdriver-wrench"></i>Services</span><i class="fa-solid fa-chevron-right"></i>
                        </a>
                        <a class="hs-quick-link" href="/client/requests">
                            <span><i class="fa-solid fa-inbox"></i>Requests</span><i class="fa-solid fa-chevron-right"></i>
                        </a>
                        <a class="hs-quick-link" href="/client/profile">
                            <span><i class="fa-solid fa-id-badge"></i>Profile</span><i class="fa-solid fa-chevron-right"></i>
                        </a>
                        <a class="hs-quick-link" href="/client/notifications">
                            <span><i class="fa-regular fa-bell"></i>Notifications <span class="badge text-bg-danger d-none js-bell-badge"></span></span><i class="fa-solid fa-chevron-right"></i>
                        </a>
                        @if (isDualRole)
                        {
                            <form method="post" action="/switch-role">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="to" value="Provider" />
                                <button type="submit" class="hs-quick-link border-0 bg-transparent w-100 text-start">
                                    <span><i class="fa-solid fa-repeat"></i>Switch to Provider Dashboard</span><i class="fa-solid fa-chevron-right"></i>
                                </button>
                            </form>
                        }
                        <form method="post" action="/logout">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="hs-quick-link border-0 bg-transparent w-100 text-start">
                                <span><i class="fa-solid fa-right-from-bracket"></i>Logout</span><i class="fa-solid fa-chevron-right"></i>
                            </button>
                        </form>
                    }
                    else if (isProvider)
                    {
                        <div class="hs-quick-link">
                            <span><i class="fa-solid fa-user"></i>@(displayName ?? userType) (Provider)</span>
                        </div>
                        <a class="hs-quick-link" href="/provider/dashboard">
                            <span><i class="fa-solid fa-house"></i>Home</span><i class="fa-solid fa-chevron-right"></i>
                        </a>
                        <a class="hs-quick-link" href="/provider/requests">
                            <span><i class="fa-solid fa-inbox"></i>Requests</span><i class="fa-solid fa-chevron-right"></i>
                        </a>
                        <a class="hs-quick-link" href="/provider/bookings">
                            <span><i class="fa-solid fa-calendar-check"></i>Bookings</span><i class="fa-solid fa-chevron-right"></i>
                        </a>
                        <a class="hs-quick-link" href="/provider/wallet">
                            <span><i class="fa-solid fa-wallet"></i>Wallet</span><i class="fa-solid fa-chevron-right"></i>
                        </a>
                        <a class="hs-quick-link" href="/provider/profile">
                            <span><i class="fa-solid fa-id-badge"></i>Profile</span><i class="fa-solid fa-chevron-right"></i>
                        </a>
                        <a class="hs-quick-link" href="/provider/notifications">
                            <span><i class="fa-regular fa-bell"></i>Notifications <span class="badge text-bg-danger d-none js-bell-badge"></span></span><i class="fa-solid fa-chevron-right"></i>
                        </a>
                        @if (isDualRole)
                        {
                            <form method="post" action="/switch-role">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="to" value="Client" />
                                <button type="submit" class="hs-quick-link border-0 bg-transparent w-100 text-start">
                                    <span><i class="fa-solid fa-repeat"></i>Switch to Client Dashboard</span><i class="fa-solid fa-chevron-right"></i>
                                </button>
                            </form>
                        }
                        <form method="post" action="/logout">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="hs-quick-link border-0 bg-transparent w-100 text-start">
                                <span><i class="fa-solid fa-right-from-bracket"></i>Logout</span><i class="fa-solid fa-chevron-right"></i>
                            </button>
                        </form>
                    }
                    else
                    {
                        <a class="hs-quick-link" href="/login">
                            <span><i class="fa-solid fa-right-to-bracket"></i>Login</span><i class="fa-solid fa-chevron-right"></i>
                        </a>
                        <a class="hs-quick-link" href="/signup">
                            <span><i class="fa-solid fa-user-plus"></i>Signup</span><i class="fa-solid fa-chevron-right"></i>
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@if (showBottomNav)
{
    <nav class="hs-bottomnav d-lg-none hs-bottomnav--@bottomNav.Length" aria-label="Main">
        @foreach (var item in bottomNav)
        {
            <a class="hs-bn-item @(item.Active ? "is-active" : "")" href="@item.Href" @(item.Active ? "aria-current=page" : null)>
                <span class="hs-bn-pill"><span class="ms @(item.Active ? "fill" : "")" aria-hidden="true">@item.Icon</span></span>
                <span class="hs-bn-label">@item.Label</span>
            </a>
        }
    </nav>
}

@if (isPortalUser)
{
    <script src="~/js/notification-bell.js" asp-append-version="true" defer></script>
}
