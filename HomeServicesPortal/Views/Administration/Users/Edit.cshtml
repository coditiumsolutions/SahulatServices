@model HomeServicesPortal.Models.ViewModels.UserEditVm
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Edit User";
    var isProvider = string.Equals(Model.Role, "Provider", StringComparison.OrdinalIgnoreCase);
    var isStaffRole = string.Equals(Model.Role, "Staff", StringComparison.OrdinalIgnoreCase)
                      || string.Equals(Model.Role, "Super Admin", StringComparison.OrdinalIgnoreCase);
    var roleOptions = isStaffRole
        ? Model.AvailableRoles.Where(r => r is "Staff" or "Super Admin")
        : Model.AvailableRoles.Where(r => string.Equals(r, Model.Role, StringComparison.OrdinalIgnoreCase));
}

<div class="mb-4">
    <a asp-action="Users" class="text-decoration-none text-muted">
        <i class="fa-solid fa-arrow-left me-1"></i>Back to Users
    </a>
    <h2 class="mt-2 mb-1"><i class="fa-solid fa-pen me-2 text-primary"></i>Edit User</h2>
    <p class="text-muted mb-0">Update UsersLogin credentials and profile. Staff privilege can switch between Staff and Super Admin.</p>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card hs-card">
            <div class="card-body p-4">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <form asp-action="EditUser" asp-route-id="@Model.Id" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />

                    <div class="mb-3">
                        <label asp-for="MobileNo" class="form-label"></label>
                        <input asp-for="MobileNo" class="form-control" />
                        <span asp-validation-for="MobileNo" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label"></label>
                        <input asp-for="FullName" class="form-control" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Role" class="form-label"></label>
                        <select asp-for="Role" class="form-select" asp-items="@(new SelectList(roleOptions))"></select>
                        <span asp-validation-for="Role" class="text-danger small"></span>
                    </div>

                    @if (isProvider)
                    {
                        <div class="mb-3">
                            <label asp-for="Cnic" class="form-label"></label>
                            <input asp-for="Cnic" class="form-control" />
                            <span asp-validation-for="Cnic" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="CategoryUid" class="form-label"></label>
                            <select asp-for="CategoryUid" class="form-select" asp-items="Model.Categories">
                                <option value="">-- Select Category --</option>
                            </select>
                            <span asp-validation-for="CategoryUid" class="text-danger small"></span>
                        </div>
                    }
                    else if (!isStaffRole)
                    {
                        <div class="mb-3">
                            <label asp-for="Cnic" class="form-label"></label>
                            <input asp-for="Cnic" class="form-control" />
                            <span asp-validation-for="Cnic" class="text-danger small"></span>
                        </div>
                    }

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <div class="form-check">
                                <input asp-for="IsActive" class="form-check-input" />
                                <label asp-for="IsActive" class="form-check-label"></label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-check">
                                <input asp-for="IsVerified" class="form-check-input" />
                                <label asp-for="IsVerified" class="form-check-label"></label>
                            </div>
                        </div>
                    </div>

                    <hr class="my-4" />
                    <p class="text-muted small mb-3">Leave password fields blank to keep the current password.</p>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label"></label>
                        <input asp-for="NewPassword" class="form-control" />
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmNewPassword" class="form-label"></label>
                        <input asp-for="ConfirmNewPassword" class="form-control" />
                        <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary btn-lg flex-grow-1">
                            <i class="fa-solid fa-save me-1"></i>Save Changes
                        </button>
                        <a asp-action="Users" class="btn btn-outline-secondary btn-lg">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
