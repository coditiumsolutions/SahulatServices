@model HomeServicesPortal.Models.ViewModels.UserListVm
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Users";
}

<div class="d-flex flex-wrap align-items-center justify-content-between mb-4 gap-2">
    <div>
        <h2 class="mb-1"><i class="fa-solid fa-user-shield me-2 text-primary"></i>Users &amp; Roles</h2>
        <p class="text-muted mb-0">Manage login accounts from UsersLogin (role = Client / Provider / Staff / Super Admin)</p>
    </div>
    <a asp-action="CreateUser" class="btn btn-primary">
        <i class="fa-solid fa-user-plus me-1"></i>Create User
    </a>
</div>

@if (TempData["SuccessMessage"] is string success)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fa-solid fa-circle-check me-2"></i>@success
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card hs-card">
    <div class="card-body">
        <form method="get" asp-action="Users" class="row g-2 mb-3">
            <div class="col-md-6 col-lg-4">
                <div class="input-group">
                    <span class="input-group-text"><i class="fa-solid fa-search"></i></span>
                    <input type="text" name="search" value="@Model.Search" class="form-control"
                           placeholder="Search mobile, name, or role..." />
                    <button type="submit" class="btn btn-outline-primary">Search</button>
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.Search))
            {
                <div class="col-auto">
                    <a asp-action="Users" class="btn btn-outline-secondary">Clear</a>
                </div>
            }
        </form>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Mobile No</th>
                        <th>Full Name</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th>Last Login</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Users.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">No users found.</td>
                        </tr>
                    }
                    @foreach (var user in Model.Users)
                    {
                        <tr>
                            <td class="fw-semibold">@user.MobileNo</td>
                            <td>@(string.IsNullOrWhiteSpace(user.FullName) ? "—" : user.FullName)</td>
                            <td><span class="badge bg-primary">@user.Role</span></td>
                            <td>
                                @if (user.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                                @if (user.IsVerified)
                                {
                                    <span class="badge bg-info ms-1">Verified</span>
                                }
                            </td>
                            <td>@(user.LastLogin?.ToString("dd MMM yyyy HH:mm") ?? "—")</td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="UserDetails" asp-route-id="@user.Id" class="btn btn-outline-secondary" title="Details">
                                        <i class="fa-solid fa-eye"></i>
                                    </a>
                                    <a asp-action="EditUser" asp-route-id="@user.Id" class="btn btn-outline-primary" title="Edit">
                                        <i class="fa-solid fa-pen"></i>
                                    </a>
                                    <a asp-action="DeleteUser" asp-route-id="@user.Id" class="btn btn-outline-danger" title="Delete">
                                        <i class="fa-solid fa-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
