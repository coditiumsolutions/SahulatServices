@model HomeServicesPortal.Models.ViewModels.UserDetailsVm
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "User Details";
}

<div class="mb-4">
    <a asp-action="Users" class="text-decoration-none text-muted">
        <i class="fa-solid fa-arrow-left me-1"></i>Back to Users
    </a>
    <h2 class="mt-2 mb-1"><i class="fa-solid fa-user me-2 text-primary"></i>User Details</h2>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card hs-card">
            <div class="card-body p-4">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted">User UID</dt>
                    <dd class="col-sm-8 fw-semibold">@Model.Id</dd>

                    <dt class="col-sm-4 text-muted">Mobile No</dt>
                    <dd class="col-sm-8">@Model.MobileNo</dd>

                    <dt class="col-sm-4 text-muted">Full Name</dt>
                    <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.FullName) ? "—" : Model.FullName)</dd>

                    <dt class="col-sm-4 text-muted">Role</dt>
                    <dd class="col-sm-8"><span class="badge bg-primary">@Model.Role</span></dd>

                    <dt class="col-sm-4 text-muted">User Type</dt>
                    <dd class="col-sm-8">@Model.UserType</dd>

                    <dt class="col-sm-4 text-muted">Active</dt>
                    <dd class="col-sm-8">@(Model.IsActive ? "Yes" : "No")</dd>

                    <dt class="col-sm-4 text-muted">Verified</dt>
                    <dd class="col-sm-8">@(Model.IsVerified ? "Yes" : "No")</dd>

                    <dt class="col-sm-4 text-muted">CNIC</dt>
                    <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Cnic) ? "—" : Model.Cnic)</dd>

                    <dt class="col-sm-4 text-muted">Category</dt>
                    <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.CategoryName) ? "—" : Model.CategoryName)</dd>

                    <dt class="col-sm-4 text-muted">Created On</dt>
                    <dd class="col-sm-8">@Model.CreatedOn.ToString("dd MMM yyyy HH:mm")</dd>

                    <dt class="col-sm-4 text-muted">Last Login</dt>
                    <dd class="col-sm-8">@(Model.LastLogin?.ToString("dd MMM yyyy HH:mm") ?? "—")</dd>
                </dl>

                <hr />

                <div class="d-flex gap-2">
                    <a asp-action="EditUser" asp-route-id="@Model.Id" class="btn btn-primary">
                        <i class="fa-solid fa-pen me-1"></i>Edit
                    </a>
                    <a asp-action="DeleteUser" asp-route-id="@Model.Id" class="btn btn-outline-danger">
                        <i class="fa-solid fa-trash me-1"></i>Delete
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
