@model HomeServicesPortal.Models.ViewModels.UserDetailsVm
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "User Details";
}

<div class="mb-4">
    <a asp-action="Users" class="text-decoration-none text-muted">
        <i class="fa-solid fa-arrow-left me-1"></i>Back to Users
    </a>
    <h2 class="mt-2 mb-1"><i class="fa-solid fa-user me-2 text-primary"></i>User Details</h2>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card hs-card">
            <div class="card-body p-4">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted">Username</dt>
                    <dd class="col-sm-8 fw-semibold">@Model.UserName</dd>

                    <dt class="col-sm-4 text-muted">Email</dt>
                    <dd class="col-sm-8">@Model.Email</dd>

                    <dt class="col-sm-4 text-muted">Role(s)</dt>
                    <dd class="col-sm-8">
                        @foreach (var role in Model.Roles)
                        {
                            <span class="badge bg-primary me-1">@role</span>
                        }
                    </dd>

                    <dt class="col-sm-4 text-muted">Email Confirmed</dt>
                    <dd class="col-sm-8">
                        @(Model.EmailConfirmed
                            ? Html.Raw("<span class='badge bg-success'>Yes</span>")
                            : Html.Raw("<span class='badge bg-warning text-dark'>No</span>"))
                    </dd>

                    <dt class="col-sm-4 text-muted">Lockout Enabled</dt>
                    <dd class="col-sm-8">@(Model.LockoutEnabled ? "Yes" : "No")</dd>
                </dl>

                <hr />

                <div class="d-flex gap-2">
                    <a asp-action="EditUser" asp-route-id="@Model.Id" class="btn btn-primary">
                        <i class="fa-solid fa-pen me-1"></i>Edit
                    </a>
                    <a asp-action="DeleteUser" asp-route-id="@Model.Id" class="btn btn-outline-danger">
                        <i class="fa-solid fa-trash me-1"></i>Delete
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
