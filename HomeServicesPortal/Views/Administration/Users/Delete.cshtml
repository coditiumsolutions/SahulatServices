@model HomeServicesPortal.Models.ViewModels.UserDeleteVm
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Delete User";
}

<div class="mb-4">
    <a asp-action="Users" class="text-decoration-none text-muted">
        <i class="fa-solid fa-arrow-left me-1"></i>Back to Users
    </a>
    <h2 class="mt-2 mb-1 text-danger"><i class="fa-solid fa-triangle-exclamation me-2"></i>Delete User</h2>
</div>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card hs-card border-danger">
            <div class="card-body p-4">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <p class="mb-3">Are you sure you want to permanently delete this user?</p>

                <dl class="row mb-4">
                    <dt class="col-sm-4 text-muted">Username</dt>
                    <dd class="col-sm-8 fw-semibold">@Model.UserName</dd>
                    <dt class="col-sm-4 text-muted">Email</dt>
                    <dd class="col-sm-8">@Model.Email</dd>
                    <dt class="col-sm-4 text-muted">Role(s)</dt>
                    <dd class="col-sm-8">
                        @foreach (var role in Model.Roles)
                        {
                            <span class="badge bg-primary me-1">@role</span>
                        }
                    </dd>
                </dl>

                <form asp-action="DeleteUserConfirmed" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-danger">
                            <i class="fa-solid fa-trash me-1"></i>Yes, Delete
                        </button>
                        <a asp-action="Users" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
