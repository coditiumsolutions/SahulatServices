@using System.Text.Json
@using HomeServicesPortal.Models.ViewModels
@model ClientDashboardVm
@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "Client Dashboard";
    ViewData["Robots"] = "noindex, nofollow";

    var searchJson = JsonSerializer.Serialize(
        Model.Categories.Select(c => new { id = c.Uid, name = c.CategoryName, serviceId = c.ServiceUid, service = c.ServiceName }),
        new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase });
    var firstName = (Model.FullName ?? string.Empty).Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault();
    // Phone: the search box lives in the app bar (see _SiteHeaderPublic).
    ViewData["MobileSearch"] = true;
    var toneClasses = new[] { "client-service-card--indigo", "client-service-card--teal", "client-service-card--green", "client-service-card--amber", "client-service-card--pink", "client-service-card--blue" };

    // Service colours as in the app; unknown services alternate teal / violet like the app does.
    string ToneFor(string? serviceName, int index) => (serviceName ?? string.Empty).Trim().ToLowerInvariant() switch
    {
        "home maintenance" => "client-service-card--sky",
        "specialized services" => "client-service-card--lilac",
        "property & legal services" => "client-service-card--sun",
        "sahulat ride" => "client-service-card--orange",
        _ => index % 2 == 0 ? "client-service-card--mint" : "client-service-card--violet"
    };

    // Featured: up to 4 categories, those with a photo first (same keywords as the app's category_images.dart).
    string? PhotoFor(string? categoryName)
    {
        var n = (categoryName ?? string.Empty).ToLowerInvariant();
        if (n.Contains("electric")) return "/img/featured/electrician.jpg";
        if (n.Contains("plumb")) return "/img/featured/plumbing.jpg";
        if (n.Contains("carpenter") || n.Contains("carpainter")) return "/img/featured/carpenter.jpg";
        if (n.Contains("paint")) return "/img/featured/painter.jpg";
        return null;
    }
    var featuredColours = new[] { "#FF6B6B", "#4ECDC4", "#45B7D1", "#FFA07A" };
    var featured = Model.Categories
        .OrderByDescending(c => PhotoFor(c.CategoryName) != null)
        .Take(4)
        .ToList();
}

@section Head {
    <link rel="stylesheet" href="~/css/public-auth.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/public-dashboard.css" asp-append-version="true" />
}

<section class="pub-dash">
    <div class="container">
        <header class="pub-dash-hero">
            <div class="provider-hero-bar">
                <p class="pub-dash-eyebrow mb-0">Client account</p>
                <div class="provider-hero-actions d-none d-lg-flex">
                    <a href="/client/requests" class="btn btn-sm btn-outline-primary">
                        <i class="fa-solid fa-inbox me-1" aria-hidden="true"></i>My requests
                    </a>
                    <a href="/client/profile" class="btn btn-sm btn-outline-secondary">
                        <i class="fa-solid fa-id-badge me-1" aria-hidden="true"></i>Profile
                    </a>
                </div>
            </div>
            <h1 class="provider-welcome">@(string.IsNullOrEmpty(firstName) ? "Welcome!" : $"Welcome, {firstName}!")</h1>
            <p class="pub-dash-lead">Quality Services Delivered to Your Doorstep</p>

            <div class="client-search position-relative mt-3">
                <label class="visually-hidden" for="serviceSearch">Search services</label>
                <input type="search" id="serviceSearch" class="form-control form-control-lg" placeholder="Search services..."
                       autocomplete="off" aria-controls="serviceSearchResults" />
                <ul class="list-group client-search-results d-none" id="serviceSearchResults" role="listbox"></ul>
            </div>
        </header>

        <h2 class="h5 mb-3">Services</h2>
        @if (Model.Services.Count == 0)
        {
            <div class="pub-dash-card">
                <h3 class="h6 mb-2">No services available</h3>
                <p class="mb-0 text-muted">Active services will appear here once they are published.</p>
            </div>
        }
        else
        {
            <div class="client-services-grid">
                @for (var i = 0; i < Model.Services.Count; i++)
                {
                    var service = Model.Services[i];
                    <a class="client-service-card client-service-card--link @toneClasses[i % toneClasses.Length] @ToneFor(service.ServiceName, i)" href="/client/services/@service.Uid">
                        <div class="client-service-icon" aria-hidden="true">
                            <i class="@service.IconClass"></i>
                        </div>
                        <h3 class="client-service-title">@service.ServiceName</h3>
                        <span class="client-service-cta">View categories <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></span>
                    </a>
                }
            </div>
        }

        @if (featured.Count > 0)
        {
            <div class="d-lg-none">
                <hr class="hs-divider" />
                <h2 class="h5 mb-3">Featured Services</h2>
                <div class="hs-featured">
                    @for (var f = 0; f < featured.Count; f++)
                    {
                        var cat = featured[f];
                        var photo = PhotoFor(cat.CategoryName);
                        <a class="hs-featured-card" href="/client/services/@cat.ServiceUid/categories/@cat.Uid/request"
                           style="--feat: @featuredColours[f % featuredColours.Length];@(photo != null ? $" background-image: url('{photo}')" : "")">
                            @if (photo == null)
                            {
                                <i class="fa-solid fa-screwdriver-wrench" aria-hidden="true"></i>
                            }
                            <span class="hs-featured-label">@cat.CategoryName</span>
                        </a>
                    }
                </div>
            </div>
        }
    </div>
</section>

@section Scripts {
    <script>
        (function () {
            var categories = @Html.Raw(searchJson);

            // The page has two search boxes: the desktop one in the page header and the phone one in the app bar.
            initSearch('serviceSearch', 'serviceSearchResults');
            initSearch('serviceSearchM', 'serviceSearchResultsM');

            function initSearch(inputId, listId) {
            var input = document.getElementById(inputId);
            var list = document.getElementById(listId);
            if (!input || !list) return;

            // Same ranking as the app: exact, prefix, word start, then contains; best 6.
            function rank(name, q) {
                var n = name.toLowerCase();
                if (n === q) return [0, 0];
                if (n.indexOf(q) === 0) return [1, 0];
                var words = n.split(/\s+/);
                for (var i = 0; i < words.length; i++) {
                    if (words[i].indexOf(q) === 0) return [2, n.indexOf(words[i])];
                }
                var pos = n.indexOf(q);
                return pos >= 0 ? [3, pos] : null;
            }

            function render() {
                var q = input.value.trim().toLowerCase();
                list.innerHTML = '';
                if (!q) { list.classList.add('d-none'); return; }

                var hits = [];
                categories.forEach(function (c) {
                    var r = rank(c.name, q);
                    if (r) hits.push({ c: c, r: r });
                });
                hits.sort(function (a, b) { return a.r[0] - b.r[0] || a.r[1] - b.r[1] || a.c.name.localeCompare(b.c.name); });
                hits = hits.slice(0, 6);

                if (!hits.length) {
                    var empty = document.createElement('li');
                    empty.className = 'list-group-item text-muted';
                    empty.textContent = 'No services found';
                    list.appendChild(empty);
                }
                hits.forEach(function (h) {
                    var a = document.createElement('a');
                    a.className = 'list-group-item list-group-item-action';
                    a.href = '/client/services/' + h.c.serviceId + '/categories/' + h.c.id + '/request';
                    a.setAttribute('role', 'option');
                    var title = document.createElement('div');
                    title.className = 'fw-semibold';
                    title.textContent = h.c.name;
                    var sub = document.createElement('div');
                    sub.className = 'small text-muted';
                    sub.textContent = h.c.service;
                    a.appendChild(title);
                    a.appendChild(sub);
                    list.appendChild(a);
                });
                list.classList.remove('d-none');
            }

            input.addEventListener('input', render);
            input.addEventListener('focus', render);
            document.addEventListener('click', function (e) {
                if (!e.target.closest('.client-search, .hs-appbar-search')) list.classList.add('d-none');
            });
            }
        })();
    </script>
}
