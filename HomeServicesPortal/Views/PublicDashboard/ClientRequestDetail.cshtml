@using HomeServicesPortal.Helpers
@using HomeServicesPortal.Models.ViewModels
@model ClientRequestCardVm
@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "Request #" + Model.Uid;
    ViewData["Robots"] = "noindex, nofollow";

    string StatusClass(string label) => label switch
    {
        "Requested" => "client-req-status--initiated",
        "Assigned" => "client-req-status--assigned",
        "In Progress" => "client-req-status--active",
        "Completed" => "client-req-status--done",
        _ => "client-req-status--cancelled"
    };

    var budget = RequestDisplayHelper.Currency(Model.EstimatedBudget);
}

@section Head {
    <link rel="stylesheet" href="~/css/public-dashboard.css" asp-append-version="true" />
}

<section class="pub-dash">
    <div class="container">
        <p class="mb-3">
            <a href="/client/requests" class="client-back-link">
                <i class="fa-solid fa-arrow-left me-1" aria-hidden="true"></i>Back to my requests
            </a>
        </p>

        <header class="pub-dash-hero">
            <p class="pub-dash-eyebrow">Client · Request #@Model.Uid</p>
            <h1>@Model.ServiceTitle</h1>
            <p class="pub-dash-lead">
                <span class="client-req-status @StatusClass(Model.StatusLabel)">@Model.StatusLabel</span>
                @if (Model.IsUrgent)
                {
                    <span class="client-req-urgent ms-2"><i class="fa-solid fa-bolt" aria-hidden="true"></i> Urgent</span>
                }
            </p>
        </header>

        @if (TempData["RequestSuccess"] is string requestOk)
        {
            <div class="alert alert-success d-flex align-items-start gap-2 mb-3" role="status">
                <i class="fa-solid fa-circle-check mt-1" aria-hidden="true"></i>
                <div>@requestOk</div>
            </div>
        }
        @if (TempData["RequestError"] is string requestErr)
        {
            <div class="alert alert-danger d-flex align-items-start gap-2 mb-3" role="alert">
                <i class="fa-solid fa-circle-exclamation mt-1" aria-hidden="true"></i>
                <div>@requestErr</div>
            </div>
        }

        <div class="pub-dash-card mb-3">
            @await Html.PartialAsync("_RequestProgress", Model.ProgressStatus)
            @if (Model.ProgressStatus == null)
            {
                <p class="mb-0 mt-2 text-muted">Request Cancelled</p>
            }
        </div>

        <div class="pub-dash-grid">
            <article class="pub-dash-card">
                <h2><i class="fa-solid fa-screwdriver-wrench me-2" aria-hidden="true"></i>Service Details</h2>
                <dl class="pub-dash-dl">
                    <div><dt>Category</dt><dd>@(Model.CategoryName ?? "-")</dd></div>
                    <div>
                        <dt>Description</dt>
                        <dd>
                            @if (string.IsNullOrWhiteSpace(Model.ServiceDescription))
                            {
                                <span class="text-muted fst-italic">No description provided</span>
                            }
                            else
                            {
                                @Model.ServiceDescription
                            }
                        </dd>
                    </div>
                    <div><dt>Priority</dt><dd>@(Model.IsUrgent ? "Urgent" : "Normal")</dd></div>
                </dl>
            </article>

            <article class="pub-dash-card">
                <h2><i class="fa-solid fa-location-dot me-2" aria-hidden="true"></i>Schedule &amp; Location</h2>
                <dl class="pub-dash-dl">
                    <div><dt>Preferred Date</dt><dd>@(Model.PreferredServiceDate?.ToString("dd-MM-yyyy") ?? "Not specified")</dd></div>
                    <div><dt>Preferred Time</dt><dd>@(RequestDisplayHelper.TimeText(Model.PreferredServiceTime) ?? "Not specified")</dd></div>
                    <div><dt>Address</dt><dd>@(Model.AddressTitle ?? "-")</dd></div>
                </dl>
            </article>

            @if (Model.HasProvider)
            {
                <article class="pub-dash-card">
                    <h2><i class="fa-solid fa-user-check me-2" aria-hidden="true"></i>Provider Details</h2>
                    <dl class="pub-dash-dl">
                        <div><dt>Name</dt><dd>@(Model.ProviderName ?? "-")</dd></div>
                        <div><dt>Mobile No</dt><dd>@RequestDisplayHelper.MobileDisplay(Model.ProviderMobileNo)</dd></div>
                        @if (!string.IsNullOrWhiteSpace(Model.ProviderCnic))
                        {
                            <div><dt>CNIC No</dt><dd>@Model.ProviderCnic</dd></div>
                        }
                    </dl>
                    <div class="client-req-actions">
                        @if (!string.IsNullOrWhiteSpace(Model.ProviderMobileNo))
                        {
                            <a href="tel:@Model.ProviderMobileNo" class="btn btn-outline-success btn-sm">
                                <i class="fa-solid fa-phone me-1" aria-hidden="true"></i>Call
                            </a>
                            <a href="@RequestDisplayHelper.WhatsAppUrl(Model.ProviderMobileNo)" target="_blank" rel="noopener" class="btn btn-outline-success btn-sm">
                                <i class="fa-brands fa-whatsapp me-1" aria-hidden="true"></i>WhatsApp
                            </a>
                        }
                        <button type="button" class="btn btn-outline-primary btn-sm" data-show-passcode data-passcode="@Model.Passcode">
                            <i class="fa-solid fa-key me-1" aria-hidden="true"></i>Show Passcode
                        </button>
                    </div>
                </article>
            }

            <article class="pub-dash-card">
                <h2><i class="fa-solid fa-address-book me-2" aria-hidden="true"></i>Contact Information</h2>
                <p class="text-muted fst-italic small">You entered this manually when submitting the request — it may differ from your account details.</p>
                <dl class="pub-dash-dl">
                    <div><dt>Contact Person</dt><dd>@(Model.ContactPerson ?? "-")</dd></div>
                    <div><dt>Contact Number</dt><dd>@(Model.ContactNo ?? "-")</dd></div>
                </dl>
            </article>

            <article class="pub-dash-card">
                <h2><i class="fa-solid fa-wallet me-2" aria-hidden="true"></i>Budget &amp; Remarks</h2>
                <dl class="pub-dash-dl">
                    <div><dt>Estimated Budget</dt><dd>@(budget ?? "Not specified")</dd></div>
                    <div><dt>Remarks</dt><dd>@(string.IsNullOrWhiteSpace(Model.Remarks) ? "No remarks" : Model.Remarks)</dd></div>
                </dl>
            </article>

            <article class="pub-dash-card">
                <h2><i class="fa-solid fa-circle-info me-2" aria-hidden="true"></i>Request Info</h2>
                <dl class="pub-dash-dl">
                    <div><dt>Request ID</dt><dd>#@Model.Uid</dd></div>
                    <div><dt>Requested On</dt><dd>@Model.CreatedOn.ToPktDisplay()</dd></div>
                </dl>
            </article>
        </div>

        @if (Model.CanCancel)
        {
            <div class="mt-3">
                <button type="button" class="btn btn-outline-warning"
                        data-cancel-request data-request-id="@Model.Uid" data-request-title="@Model.ServiceTitle" data-return-to="detail">
                    Cancel Request
                </button>
            </div>
        }
    </div>
</section>

@await Html.PartialAsync("_RequestModals")
