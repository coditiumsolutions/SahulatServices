@model HomeServicesPortal.Models.ViewModels.ClientServiceCategoriesVm
@{
    Layout = "_PublicLayout";
    ViewData["Title"] = $"{Model.ServiceName} · Categories";
    ViewData["Robots"] = "noindex, nofollow";
}

@section Head {
    <link rel="stylesheet" href="~/css/public-dashboard.css" asp-append-version="true" />
}

<section class="pub-dash">
    <div class="container">
        <p class="mb-3">
            <a href="/client/services" class="client-back-link">
                <i class="fa-solid fa-arrow-left me-1" aria-hidden="true"></i>All services
            </a>
        </p>

        <header class="pub-dash-hero">
            <p class="pub-dash-eyebrow">Client · Services · Categories</p>
            <h1>@Model.ServiceName</h1>
            <p class="pub-dash-lead">
                @(string.IsNullOrWhiteSpace(Model.ServiceDescription)
                    ? "Select a category to create a service request."
                    : Model.ServiceDescription)
            </p>
        </header>

        @if (Model.Categories.Count == 0)
        {
            <div class="pub-dash-card">
                <h2 class="h5 mb-2">No categories yet</h2>
                <p class="mb-0 text-muted">Active categories for this service will appear here once they are published.</p>
            </div>
        }
        else
        {
            <div class="client-services-grid">
                @foreach (var category in Model.Categories)
                {
                    <a class="client-service-card client-service-card--link"
                       href="/client/services/@Model.ServiceUid/categories/@category.Uid/request">
                        <div class="client-service-icon" aria-hidden="true">
                            <i class="fa-solid fa-layer-group"></i>
                        </div>
                        <h2 class="client-service-title">@category.CategoryName</h2>
                        @if (!string.IsNullOrWhiteSpace(category.Description))
                        {
                            <p class="client-service-desc">@category.Description</p>
                        }
                        else
                        {
                            <p class="client-service-desc client-service-desc--muted">Category available under @Model.ServiceName.</p>
                        }
                        <span class="client-service-cta">Request service <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></span>
                    </a>
                }
            </div>
        }
    </div>
</section>
