@model HomeServicesPortal.Models.ViewModels.PublicDashboardVm
@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "Provider Dashboard";
    ViewData["Robots"] = "noindex, nofollow";
}

@section Head {
    <link rel="stylesheet" href="~/css/public-auth.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/public-dashboard.css" asp-append-version="true" />
}

<section class="pub-dash">
    <div class="container">
        <header class="pub-dash-hero pub-dash-hero--provider">
            <p class="pub-dash-eyebrow">Provider account</p>
            <h1>Welcome, @Model.FullName</h1>
            <p class="pub-dash-lead">Track jobs and stay available for nearby requests. Use the mobile app for live job alerts, location updates, and full provider tools.</p>
        </header>

        <div class="pub-dash-grid">
            <article class="pub-dash-card">
                <h2><i class="fa-solid fa-id-card me-2" aria-hidden="true"></i>Account</h2>
                <dl class="pub-dash-dl">
                    <div><dt>Name</dt><dd>@Model.FullName</dd></div>
                    <div><dt>Mobile</dt><dd>@Model.MobileNo</dd></div>
                    <div><dt>Type</dt><dd>Provider</dd></div>
                    @if (Model.LastLogin.HasValue)
                    {
                        <div><dt>Last login</dt><dd>@Model.LastLogin.Value.ToPktDisplay()</dd></div>
                    }
                </dl>
            </article>

            <article class="pub-dash-card">
                <h2><i class="fa-solid fa-bolt me-2" aria-hidden="true"></i>Quick actions</h2>
                <ul class="pub-dash-actions">
                    <li><a href="/provider/requests"><i class="fa-solid fa-inbox"></i>Requests</a></li>
                    <li><a href="/provider/bookings"><i class="fa-solid fa-calendar-check"></i>Bookings</a></li>
                    <li><a href="/provider/wallet"><i class="fa-solid fa-wallet"></i>Wallet</a></li>
                    <li><a href="/provider/profile"><i class="fa-solid fa-id-badge"></i>Profile</a></li>
                </ul>
            </article>
        </div>
    </div>
</section>
