@inject IWebHostEnvironment Env
@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "Download App";
    ViewData["Description"] = "Download the Sahulat Ghar Tak app to book verified home service professionals in Pakistan. Available now on Google Play and the App Store.";
    var playStoreUrl = "https://play.google.com/store/apps/details?id=com.coditiumsols.sahulatghartak";
    var appStoreUrl = "https://apps.apple.com/pk/app/sahulat-ghar-tak/id6810184599";
    // The iOS screenshot slot shows up as soon as the file is added; until then the Android phone stands alone.
    var hasIosScreenshot = System.IO.File.Exists(System.IO.Path.Combine(Env.WebRootPath, "img", "ios-home-screen.png"));
}

<section class="public-hero download-hero">
    <div class="container public-hero-content">
        <div class="row align-items-center g-4">
            <div class="col-lg-6">
                <p class="text-uppercase fw-semibold mb-2 opacity-75" style="letter-spacing: 0.12em; font-size: 0.8rem;">
                    Sahulat Ghar Tak &middot; Mobile App
                </p>
                <h1>Take Sahulat Ghar Tak Wherever You Go</h1>
                <p class="lead mb-0">
                    Book verified home service professionals, track your requests, and manage everything
                    right from your phone.
                </p>
                <div class="public-hero-actions">
                    <a href="@playStoreUrl" target="_blank" rel="noopener" class="store-badge-img-link">
                        <img src="~/img/downloads/google-play-badge.svg" alt="Get it on Google Play" class="store-badge-img" />
                    </a>
                    <a href="@appStoreUrl" target="_blank" rel="noopener" class="store-badge-img-link">
                        <img src="~/img/downloads/app-store-badge.svg" alt="Download on the App Store" class="store-badge-img" />
                    </a>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="hero-phones">
                    <div class="hero-phone">
                        <img src="~/img/app-home-screen.png" width="540" height="1200"
                             alt="Screenshot of the Sahulat Ghar Tak Android app home screen" />
                    </div>
                    @if (hasIosScreenshot)
                    {
                        <div class="hero-phone">
                            <img src="~/img/ios-home-screen.png"
                                 alt="Screenshot of the Sahulat Ghar Tak iOS app home screen" />
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<section class="public-section">
    <div class="container">
        <h2 class="public-section-title">Get the App</h2>
        <p class="public-section-subtitle">
            Scan a QR code with your phone's camera, or tap a store link below.
        </p>

        <div class="store-grid">
            <div class="store-card is-live">
                <span class="store-card-pill is-live">Available now</span>
                <div class="store-card-heading">
                    <i class="fa-brands fa-google-play"></i>
                    <h3>Google Play</h3>
                </div>
                <a href="@playStoreUrl" target="_blank" rel="noopener" class="store-qr-frame" aria-label="Open Sahulat Ghar Tak on Google Play">
                    <img src="~/img/downloads/playstore-qr.png" alt="QR code linking to the Sahulat Ghar Tak Google Play listing" />
                </a>
                <p class="text-muted mb-0">Scan to open the Play Store listing directly on your Android phone.</p>
                <a href="@playStoreUrl" target="_blank" rel="noopener" class="store-badge-img-link">
                    <img src="~/img/downloads/google-play-badge.svg" alt="Get it on Google Play" class="store-badge-img" />
                </a>
            </div>

            <div class="store-card is-live">
                <span class="store-card-pill is-live">Available now</span>
                <div class="store-card-heading">
                    <i class="fa-brands fa-apple"></i>
                    <h3>App Store</h3>
                </div>
                <a href="@appStoreUrl" target="_blank" rel="noopener" class="store-qr-frame" aria-label="Open Sahulat Ghar Tak on the App Store">
                    <img src="~/img/downloads/appstore-qr.png" alt="QR code linking to the Sahulat Ghar Tak App Store listing" />
                </a>
                <p class="text-muted mb-0">Scan to open the App Store listing directly on your iPhone or iPad.</p>
                <a href="@appStoreUrl" target="_blank" rel="noopener" class="store-badge-img-link">
                    <img src="~/img/downloads/app-store-badge.svg" alt="Download on the App Store" class="store-badge-img" />
                </a>
            </div>
        </div>
    </div>
</section>
