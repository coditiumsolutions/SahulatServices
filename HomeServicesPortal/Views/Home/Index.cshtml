    ViewData["Title"] = "Home";
    ViewData["Description"] = "Sahulat Ghar Tak is Pakistan's trusted home services platform — book verified electricians, plumbers, cleaners, AC technicians, carpenters and painters with transparent pricing and live tracking.";
}

