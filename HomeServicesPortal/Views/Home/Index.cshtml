                    Pakistan's trusted home services platform
                </p>
                <h1>Quality Home Services, Delivered to Your Doorstep</h1>
                <p class="lead mb-0">
                    Sahulat Ghar Tak connects households with verified electricians, plumbers, cleaners,
                    technicians, and more — book reliable professionals in minutes.
                </p>
                <div class="public-hero-actions">
                    <a href="#services" class="public-btn-light">Explore Services</a>
                    <a href="#how-it-works" class="public-btn-outline">How It Works</a>
                </div>
                <div class="public-stats">
                    <div class="public-stat-card">
                        <strong>500+</strong>
                        <span>Verified Providers</span>
                    </div>
                    <div class="public-stat-card">
                        <strong>18+</strong>
                        <span>Service Categories</span>
                    </div>
                    <div class="public-stat-card">
                        <strong>24/7</strong>
                        <span>Booking Support</span>
                    </div>
                </div>
            </div>
            <div class="col-lg-5 d-none d-lg-block text-center">
                <i class="fa-solid fa-house-chimney-user" style="font-size: 9rem; opacity: 0.25;"></i>
            </div>
        </div>
    </div>
</section>

<section id="services" class="public-section public-services-section">
    <div class="container">
        <h2 class="public-section-title">Our Services</h2>
        <p class="public-section-subtitle">
            Four pillars of convenience — from your home to the road, and everything in between.
        </p>
        <p class="public-services-rotator" aria-live="polite">
            <span class="public-services-rotator-label">Now covering</span>
            <span class="public-services-rotator-track" id="servicesRotatorText">Home Maintenance</span>
        </p>
    </div>

    <div class="public-services-marquee" aria-hidden="true">
        <div class="public-services-marquee-track">
            <span>Electrician</span><span>Plumbing</span><span>Cleaning</span><span>AC Service</span>
            <span>Carpentry</span><span>Painting</span><span>Legal Support</span><span>Property Care</span>
            <span>Sahulat Ride</span><span>Home Maintenance</span><span>Specialized Services</span>
            <span>Electrician</span><span>Plumbing</span><span>Cleaning</span><span>AC Service</span>
            <span>Carpentry</span><span>Painting</span><span>Legal Support</span><span>Property Care</span>
            <span>Sahulat Ride</span><span>Home Maintenance</span><span>Specialized Services</span>
        </div>
    </div>

    <div class="container">
        <div class="public-pillar-grid">
            <article class="public-pillar-card" style="--delay: 0s">
                <div class="public-pillar-icon"><i class="fa-solid fa-house-chimney"></i></div>
                <h3>Home Maintenance</h3>
                <p>Everyday upkeep for your home — electrical, plumbing, cleaning, AC, carpentry, and painting by verified professionals.</p>
                <ul class="public-pillar-tags">
                    <li>Electrician</li>
                    <li>Plumber</li>
                    <li>Cleaner</li>
                    <li>AC Tech</li>
                </ul>
            </article>

            <article class="public-pillar-card" style="--delay: 0.08s">
                <div class="public-pillar-icon"><i class="fa-solid fa-screwdriver-wrench"></i></div>
                <h3>Specialized Services</h3>
                <p>Expert help for complex jobs that need skilled technicians and tailored solutions beyond routine maintenance.</p>
                <ul class="public-pillar-tags">
                    <li>Technicians</li>
                    <li>Repairs</li>
                    <li>Installations</li>
                    <li>Custom Jobs</li>
                </ul>
            </article>

            <article class="public-pillar-card" style="--delay: 0.16s">
                <div class="public-pillar-icon"><i class="fa-solid fa-scale-balanced"></i></div>
                <h3>Property and Legal Services</h3>
                <p>Support for property-related needs and legal assistance — practical guidance when ownership and paperwork matter.</p>
                <ul class="public-pillar-tags">
                    <li>Property</li>
                    <li>Documentation</li>
                    <li>Legal Aid</li>
                    <li>Advisory</li>
                </ul>
            </article>

            <a class="public-pillar-card public-pillar-card-link" href="https://sahulatride.com" target="_blank" rel="noopener noreferrer" style="--delay: 0.24s">
                <div class="public-pillar-icon public-pillar-icon-ride"><i class="fa-solid fa-car-side"></i></div>
                <h3>Sahulat Ride</h3>
                <p>Reliable rides when you need to move — book transport through our companion service.</p>
                <span class="public-pillar-cta">
                    sahulatride.com <i class="fa-solid fa-arrow-up-right-from-square"></i>
                </span>
            </a>
        </div>
    </div>
</section>

@section Scripts {
<script>
(() => {
    const phrases = [
        'Home Maintenance',
        'Specialized Services',
        'Property and Legal Services',
        'Sahulat Ride'
    ];
    const el = document.getElementById('servicesRotatorText');
    if (!el || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    let i = 0;
    setInterval(() => {
        i = (i + 1) % phrases.length;
        el.classList.add('is-fading');
        setTimeout(() => {
            el.textContent = phrases[i];
            el.classList.remove('is-fading');
        }, 280);
    }, 2800);
})();
</script>
}

