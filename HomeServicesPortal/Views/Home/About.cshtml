@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "About Us";
    ViewData["Description"] = "Sahulat Ghar Tak is Pakistan’s all-in-one service platform connecting customers and professionals. Learn our vision, mission, and community-first approach.";
}

<section class="public-hero about-hero">
    <div class="container public-hero-content">
        <div class="row align-items-center g-4">
            <div class="col-lg-8">
                <p class="text-uppercase fw-semibold mb-2 opacity-75" style="letter-spacing: 0.12em; font-size: 0.8rem;">
                    About Sahulat Ghar Tak
                </p>
                <h1>One Platform. Every Service. Endless Possibilities.</h1>
                <p class="lead mb-0">
                    An innovative, all-in-one service platform designed to bring everyday services closer
                    to people across Pakistan.
                </p>
            </div>
            <div class="col-lg-4 d-none d-lg-block text-center">
                <i class="fa-solid fa-handshake" style="font-size: 8rem; opacity: 0.25;"></i>
            </div>
        </div>
    </div>
</section>

<section class="public-section">
    <div class="container">
        <div class="about-prose">
            <h2 class="public-section-title">Who We Are</h2>
            <p>
                Sahulat Ghar Tak is an innovative, all-in-one service platform designed to bring everyday
                services closer to people across Pakistan. Our vision is simple: make every essential service
                accessible through one trusted platform.
            </p>
            <p>
                Sahulat Ghar Tak aims to become Pakistan’s first truly comprehensive service ecosystem,
                connecting customers with a wide range of professional service providers through a single app.
                Whether you need a home service, skilled professional, delivery, maintenance, repair, or other
                everyday assistance, Sahulat Ghar Tak is built to make finding and accessing services easier,
                faster, and more convenient.
            </p>
            <p>
                Sahulat Ghar Tak is more than just a service-booking app. It is a digital marketplace built to
                create opportunities for service professionals, empower individuals to earn through their skills,
                and give customers a convenient way to find trusted services from one platform.
            </p>
        </div>

        <blockquote class="about-quote">
            <p>“My client is my provider, and my provider is my client.”</p>
            <footer>
                Our unique approach is based on a powerful two-sided relationship. We believe that every customer
                can also be a service provider, and every provider can also become a customer. This creates a
                connected community where people can both offer their skills and access the services they need.
            </footer>
        </blockquote>

        <div class="about-vm-grid">
            <article class="about-vm-card">
                <span class="about-vm-label">Our Vision</span>
                <h3>Trusted. Accessible. Complete.</h3>
                <p>
                    To build Pakistan’s most trusted and accessible all-in-one service platform, connecting people,
                    professionals, and opportunities in one digital ecosystem.
                </p>
            </article>
            <article class="about-vm-card">
                <span class="about-vm-label">Our Mission</span>
                <h3>Simplify everyday life.</h3>
                <p>
                    To simplify everyday life by bringing multiple services together on one platform while creating
                    new earning opportunities for skilled individuals and service providers.
                </p>
            </article>
        </div>

        <div class="about-closing">
            <p class="about-closing-line">Sahulat Ghar Tak — One Platform. Every Service. Endless Possibilities.</p>
            <div class="d-flex flex-wrap gap-2 justify-content-center">
                <a href="/#services" class="btn btn-primary">Explore Services</a>
                <a href="/#contact" class="btn btn-outline-primary">Contact Us</a>
            </div>
        </div>
    </div>
</section>
