@model HomeServicesPortal.Models.ViewModels.AssignProviderVm
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Assign Provider";
    var selected = new HashSet<int>(Model.ProviderUids ?? new List<int>());
}

<div class="mb-4">
    <a asp-action="Index" class="text-decoration-none text-muted"><i class="fa-solid fa-arrow-left me-1"></i>Back to S-Requests</a>
    <h2 class="mt-2 mb-0"><i class="fa-solid fa-user-check me-2 text-primary"></i>Assign Provider</h2>
    <p class="text-muted mb-0">Select one or more providers and create ServiceBookings with bill and commission totals</p>
</div>

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="card hs-card mb-3">
            <div class="card-body p-4">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted">Request</dt>
                    <dd class="col-sm-8 fw-semibold">#@Model.RequestUid — @Model.ServiceTitle</dd>
                    <dt class="col-sm-4 text-muted">Client</dt>
                    <dd class="col-sm-8">@Model.ClientName</dd>
                    <dt class="col-sm-4 text-muted">Category</dt>
                    <dd class="col-sm-8">@Model.CategoryName</dd>
                    <dt class="col-sm-4 text-muted">Address</dt>
                    <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.ServiceAddress) ? "—" : Model.ServiceAddress)</dd>
                    <dt class="col-sm-4 text-muted">Estimated Budget</dt>
                    <dd class="col-sm-8">@(Model.EstimatedBudget?.ToString("N2") ?? "—")</dd>
                    <dt class="col-sm-4 text-muted">Status</dt>
                    <dd class="col-sm-8"><span class="badge bg-warning text-dark">@(Model.Status ?? "Initiated")</span></dd>
                </dl>
            </div>
        </div>

        <div class="card hs-card">
            <div class="card-body p-4">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <form asp-action="Assign" asp-route-id="@Model.RequestUid" method="post" id="assignProviderForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="RequestUid" />

                    <div class="mb-3">
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                            <label class="form-label mb-0">Providers</label>
                            <span class="badge bg-primary" id="selectedProviderCount">0 selected</span>
                        </div>

                        @if (!Model.HasCategoryMatch)
                        {
                            <div class="alert alert-warning py-2 px-3 small mb-2">
                                <i class="fa-solid fa-triangle-exclamation me-1"></i>
                                No providers match this request's category (@Model.CategoryName). Showing all providers instead.
                            </div>
                        }

                        <div id="providerListMatching" class="border rounded p-2 @(Model.ShowAllProviders ? "d-none" : "")" style="max-height: 260px; overflow-y: auto;">
                            @if (Model.Providers.Count == 0)
                            {
                                <div class="text-muted small py-2 px-1">No matching providers.</div>
                            }
                            @foreach (var p in Model.Providers)
                            {
                                var uid = int.TryParse(p.Value, out var id) ? id : 0;
                                <div class="form-check">
                                    @if (selected.Contains(uid))
                                    {
                                        <input class="form-check-input provider-check matching-check" type="checkbox"
                                               name="ProviderUids" value="@p.Value" id="match_@p.Value" checked />
                                    }
                                    else
                                    {
                                        <input class="form-check-input provider-check matching-check" type="checkbox"
                                               name="ProviderUids" value="@p.Value" id="match_@p.Value" />
                                    }
                                    <label class="form-check-label" for="match_@p.Value">@p.Text</label>
                                </div>
                            }
                        </div>

                        <div id="providerListAll" class="border rounded p-2 @(Model.ShowAllProviders ? "" : "d-none")" style="max-height: 260px; overflow-y: auto;">
                            @foreach (var p in Model.AllProviders)
                            {
                                var uid = int.TryParse(p.Value, out var id) ? id : 0;
                                <div class="form-check">
                                    @if (selected.Contains(uid))
                                    {
                                        <input class="form-check-input provider-check all-check" type="checkbox"
                                               name="ProviderUids" value="@p.Value" id="all_@p.Value" checked
                                               disabled="@(!Model.ShowAllProviders)" />
                                    }
                                    else
                                    {
                                        <input class="form-check-input provider-check all-check" type="checkbox"
                                               name="ProviderUids" value="@p.Value" id="all_@p.Value"
                                               disabled="@(!Model.ShowAllProviders)" />
                                    }
                                    <label class="form-check-label" for="all_@p.Value">@p.Text</label>
                                </div>
                            }
                        </div>

                        <span asp-validation-for="ProviderUids" class="text-danger small"></span>

                        <div class="form-check mt-2">
                            <input asp-for="ShowAllProviders" class="form-check-input" id="showAllProvidersToggle" disabled="@(!Model.HasCategoryMatch)" />
                            <label asp-for="ShowAllProviders" class="form-check-label small"></label>
                        </div>
                        <div class="form-text">Same bill and commission will be applied to each selected provider.</div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ServiceDetail" class="form-label"></label>
                        <textarea asp-for="ServiceDetail" class="form-control" rows="3" maxlength="1000"></textarea>
                        <span asp-validation-for="ServiceDetail" class="text-danger small"></span>
                    </div>

                    <h5 class="mb-3">Bill Breakdown</h5>
                    <div class="row">
                        <div class="col-md-3 mb-3">
                            <label asp-for="EstimatedAmount" class="form-label"></label>
                            <input asp-for="EstimatedAmount" class="form-control calc-input" type="number" step="0.01" min="0" />
                            <span asp-validation-for="EstimatedAmount" class="text-danger small"></span>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label asp-for="VisitCharges" class="form-label"></label>
                            <input asp-for="VisitCharges" class="form-control calc-input" type="number" step="0.01" min="0" />
                            <span asp-validation-for="VisitCharges" class="text-danger small"></span>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label asp-for="AdditionalCharges" class="form-label"></label>
                            <input asp-for="AdditionalCharges" class="form-control calc-input" type="number" step="0.01" min="0" />
                            <span asp-validation-for="AdditionalCharges" class="text-danger small"></span>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label asp-for="Deductions" class="form-label"></label>
                            <input asp-for="Deductions" class="form-control calc-input" type="number" step="0.01" min="0" />
                            <span asp-validation-for="Deductions" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="FinalAmount" class="form-label"></label>
                            <input asp-for="FinalAmount" class="form-control fw-semibold" type="number" step="0.01" readonly tabindex="-1" />
                            <div class="form-text">Estimated + Visit + Additional − Deductions</div>
                            <span asp-validation-for="FinalAmount" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="CustomerPaid" class="form-label"></label>
                            <input asp-for="CustomerPaid" class="form-control calc-input" type="number" step="0.01" min="0" />
                            <span asp-validation-for="CustomerPaid" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="PaymentMode" class="form-label"></label>
                            <select asp-for="PaymentMode" class="form-select" asp-items="Model.PaymentModeOptions"></select>
                            <span asp-validation-for="PaymentMode" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="CustomerRemaining" class="form-label"></label>
                        <input asp-for="CustomerRemaining" class="form-control" type="number" step="0.01" readonly tabindex="-1" />
                        <div class="form-text">Final Bill − Customer Paid</div>
                    </div>

                    <h5 class="mb-3">Commission</h5>
                    <p class="text-muted small mb-2" id="commissionSourceLabel">
                        <i class="fa-solid fa-percent me-1"></i>@Model.CommissionSourceLabel
                    </p>
                    <input type="hidden" asp-for="CategoryUid" />
                    <input type="hidden" asp-for="CommissionSourceLabel" id="CommissionSourceLabelHidden" />
                    <div class="row">
                        <div class="col-md-3 mb-3">
                            <label asp-for="CommissionType" class="form-label"></label>
                            <select asp-for="CommissionType" class="form-select calc-input" asp-items="Model.CommissionTypeOptions"></select>
                            <span asp-validation-for="CommissionType" class="text-danger small"></span>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label asp-for="CommissionValue" class="form-label"></label>
                            <input asp-for="CommissionValue" class="form-control calc-input" type="number" step="0.01" min="0" />
                            <span asp-validation-for="CommissionValue" class="text-danger small"></span>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label asp-for="CommissionAmount" class="form-label"></label>
                            <input asp-for="CommissionAmount" class="form-control" type="number" step="0.01" readonly tabindex="-1" />
                            <div class="form-text">Auto from type + rate on Final Bill</div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label asp-for="ProviderEarning" class="form-label"></label>
                            <input asp-for="ProviderEarning" class="form-control" type="number" step="0.01" readonly tabindex="-1" />
                            <div class="form-text">Final Bill − Company Commission</div>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="fa-solid fa-check me-1"></i>Assign &amp; Create Booking
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const form = document.getElementById('assignProviderForm');
            if (!form) return;

            const categoryUid = @Model.CategoryUid;
            const resolveUrl = '@Url.Action("ResolveCommission", "ServiceRequests")';
            const matchingList = document.getElementById('providerListMatching');
            const allList = document.getElementById('providerListAll');
            const toggle = document.getElementById('showAllProvidersToggle');
            const countBadge = document.getElementById('selectedProviderCount');

            const num = (id) => {
                const el = form.querySelector('#' + id);
                if (!el) return 0;
                const v = parseFloat(el.value);
                return Number.isFinite(v) ? v : 0;
            };

            const set = (id, value) => {
                const el = form.querySelector('#' + id);
                if (el) el.value = (Math.round(value * 100) / 100).toFixed(2);
            };

            function recalc() {
                const estimated = num('EstimatedAmount');
                const visit = num('VisitCharges');
                const additional = num('AdditionalCharges');
                const deductions = num('Deductions');
                const paid = num('CustomerPaid');
                const rate = num('CommissionValue');
                const typeEl = form.querySelector('#CommissionType');
                const type = typeEl ? typeEl.value : 'Percent';

                const finalBill = estimated + visit + additional - deductions;
                const remaining = finalBill - paid;
                let commission = type === 'Fixed'
                    ? rate
                    : finalBill * rate / 100;
                commission = Math.round(commission * 100) / 100;
                const earning = Math.round((finalBill - commission) * 100) / 100;

                set('FinalAmount', finalBill);
                set('CustomerRemaining', remaining);
                set('CommissionAmount', commission);
                set('ProviderEarning', earning);
            }

            function setCommissionSource(label) {
                const text = document.getElementById('commissionSourceLabel');
                const hidden = document.getElementById('CommissionSourceLabelHidden');
                if (text) text.innerHTML = '<i class="fa-solid fa-percent me-1"></i>' + (label || '');
                if (hidden) hidden.value = label || '';
            }

            async function applyResolvedCommission(providerUid) {
                const params = new URLSearchParams({ categoryUid: String(categoryUid || 0) });
                if (providerUid) params.set('providerUid', String(providerUid));
                try {
                    const res = await fetch(resolveUrl + '?' + params.toString(), {
                        headers: { 'Accept': 'application/json' }
                    });
                    if (!res.ok) return;
                    const data = await res.json();
                    const typeEl = form.querySelector('#CommissionType');
                    const valueEl = form.querySelector('#CommissionValue');
                    if (typeEl && data.commissionType) typeEl.value = data.commissionType;
                    if (valueEl && data.commissionValue != null) valueEl.value = data.commissionValue;
                    setCommissionSource(data.sourceLabel || '');
                    recalc();
                } catch (_) { /* keep current values */ }
            }

            function activeChecks() {
                return [...form.querySelectorAll('.provider-check:not([disabled]):checked')];
            }

            function updateSelectedCount() {
                const n = activeChecks().length;
                if (countBadge) countBadge.textContent = n + ' selected';
            }

            function onProviderSelectionChanged() {
                updateSelectedCount();
                const checked = activeChecks();
                if (checked.length === 1) {
                    const uid = parseInt(checked[0].value, 10);
                    applyResolvedCommission(Number.isFinite(uid) && uid > 0 ? uid : null);
                } else {
                    applyResolvedCommission(null);
                }
            }

            function applyToggleState() {
                const showAll = toggle && toggle.checked;
                if (matchingList) matchingList.classList.toggle('d-none', showAll);
                if (allList) allList.classList.toggle('d-none', !showAll);

                form.querySelectorAll('.matching-check').forEach(function (el) {
                    el.disabled = !!showAll;
                    if (showAll) el.checked = false;
                });
                form.querySelectorAll('.all-check').forEach(function (el) {
                    el.disabled = !showAll;
                    if (!showAll) el.checked = false;
                });

                onProviderSelectionChanged();
            }

            form.querySelectorAll('.provider-check').forEach(function (el) {
                el.addEventListener('change', onProviderSelectionChanged);
            });
            if (toggle) toggle.addEventListener('change', applyToggleState);

            form.querySelectorAll('.calc-input').forEach(el => {
                el.addEventListener('input', recalc);
                el.addEventListener('change', recalc);
            });

            applyToggleState();
            recalc();
        })();
    </script>
}
