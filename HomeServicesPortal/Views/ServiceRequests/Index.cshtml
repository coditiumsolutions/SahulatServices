@model HomeServicesPortal.Models.ViewModels.ServiceRequestListVm
@{
    Layout = "_AdminLayout";
    var isPendingFilter = string.Equals(Model.Status, "PendingRequests", StringComparison.OrdinalIgnoreCase)
        || string.Equals(Model.Status, "Pending Requests", StringComparison.OrdinalIgnoreCase);
    var listTitle = string.Equals(Model.Status, "Initiated", StringComparison.OrdinalIgnoreCase)
        ? "Initiated Requests"
        : isPendingFilter
            ? "Pending Requests"
            : string.Equals(Model.Status, "Assigned", StringComparison.OrdinalIgnoreCase)
                ? "Assigned Requests"
                : string.Equals(Model.Status, "Urgent", StringComparison.OrdinalIgnoreCase)
                    ? "Urgent Requests"
                    : string.Equals(Model.Status, "Completed", StringComparison.OrdinalIgnoreCase)
                        ? "Completed Requests"
                        : "All Requests";
    ViewData["Title"] = listTitle;
    string StatusBadgeClass(string? status) => status switch
    {
        "Completed" => "success",
        "In Progress" => "primary",
        "Assigned" => "info",
        "Cancelled" => "secondary",
        "Initiated" => "warning",
        _ => "warning"
    };
}

<div class="d-flex flex-wrap align-items-center justify-content-between mb-4 gap-2">
    <div>
        <h2 class="mb-1"><i class="fa-solid fa-list-check me-2 text-primary"></i>@listTitle</h2>
        <p class="text-muted mb-0">
            @if (string.Equals(Model.Status, "Initiated", StringComparison.OrdinalIgnoreCase))
            {
                <text>New requests awaiting staff assignment</text>
            }
            else if (isPendingFilter)
            {
                <text>Assigned requests waiting for the provider to accept</text>
            }
            else if (string.Equals(Model.Status, "Assigned", StringComparison.OrdinalIgnoreCase))
            {
                <text>Requests assigned to a provider</text>
            }
            else if (string.Equals(Model.Status, "Urgent", StringComparison.OrdinalIgnoreCase))
            {
                <text>Urgent requests that are not completed</text>
            }
            else if (string.Equals(Model.Status, "Completed", StringComparison.OrdinalIgnoreCase))
            {
                <text>Completed service requests</text>
            }
            else
            {
                <text>Manage service requests from customers</text>
            }
        </p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fa-solid fa-plus me-1"></i>Add Request
    </a>
</div>

@if (TempData["SuccessMessage"] is string success)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fa-solid fa-circle-check me-2"></i>@success
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] is string error)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fa-solid fa-circle-exclamation me-2"></i>@error
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card hs-card">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-2 mb-3 align-items-end">
            <div class="col-md-4 col-lg-3">
                <label class="form-label small text-muted mb-1" for="statusFilter">Status</label>
                @{
                    var knownStatus = string.IsNullOrWhiteSpace(Model.Status)
                        || string.Equals(Model.Status, "Initiated", StringComparison.OrdinalIgnoreCase)
                        || isPendingFilter
                        || string.Equals(Model.Status, "Assigned", StringComparison.OrdinalIgnoreCase)
                        || string.Equals(Model.Status, "Completed", StringComparison.OrdinalIgnoreCase);
                }
                <select id="statusFilter" name="status" class="form-select" onchange="this.form.submit()">
                    @if (string.IsNullOrWhiteSpace(Model.Status))
                    {
                        <option value="" selected>All</option>
                    }
                    else
                    {
                        <option value="">All</option>
                    }

                    @if (string.Equals(Model.Status, "Initiated", StringComparison.OrdinalIgnoreCase))
                    {
                        <option value="Initiated" selected>Initiated</option>
                    }
                    else
                    {
                        <option value="Initiated">Initiated</option>
                    }

                    @if (isPendingFilter)
                    {
                        <option value="PendingRequests" selected>Pending</option>
                    }
                    else
                    {
                        <option value="PendingRequests">Pending</option>
                    }

                    @if (string.Equals(Model.Status, "Assigned", StringComparison.OrdinalIgnoreCase))
                    {
                        <option value="Assigned" selected>Assigned</option>
                    }
                    else
                    {
                        <option value="Assigned">Assigned</option>
                    }

                    @if (string.Equals(Model.Status, "Completed", StringComparison.OrdinalIgnoreCase))
                    {
                        <option value="Completed" selected>Completed</option>
                    }
                    else
                    {
                        <option value="Completed">Completed</option>
                    }

                    @if (!knownStatus)
                    {
                        <option value="@Model.Status" selected>@Model.Status</option>
                    }
                </select>
            </div>
            <div class="col-md-6 col-lg-5">
                <label class="form-label small text-muted mb-1" for="searchFilter">Search</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fa-solid fa-search"></i></span>
                    <input id="searchFilter" type="text" name="search" value="@Model.Search" class="form-control" placeholder="Search requests..." />
                    <button type="submit" class="btn btn-outline-primary">Search</button>
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.Search) || !string.IsNullOrWhiteSpace(Model.Status))
            {
                <div class="col-auto">
                    <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
                </div>
            }
        </form>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Client</th>
                        <th>Category</th>
                        <th>Title / Address</th>
                        <th>Status</th>
                        <th>Created On</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Items.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">No service requests found.</td>
                        </tr>
                    }
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td class="fw-semibold">@item.CustomerName</td>
                            <td>@item.CategoryName</td>
                            <td>
                                <div>@(string.IsNullOrWhiteSpace(item.ServiceTitle) ? "—" : item.ServiceTitle)</div>
                                <div class="small text-muted">@(string.IsNullOrWhiteSpace(item.ServiceAddress) ? "—" : item.ServiceAddress)</div>
                            </td>
                            <td>
                                <span class="badge bg-@StatusBadgeClass(item.Status)">@(item.Status ?? "Initiated")</span>
                                @if (item.IsUrgent)
                                {
                                    <span class="badge bg-danger ms-1">Urgent</span>
                                }
                            </td>
                            <td>@(item.RequestDate?.ToString("dd MMM yyyy HH:mm") ?? "—")</td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@item.Uid" class="btn btn-outline-secondary" title="Details"><i class="fa-solid fa-eye"></i></a>
                                    @if (string.Equals(item.Status, "Initiated", StringComparison.OrdinalIgnoreCase)
                                         || string.Equals(item.Status, "Pending", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <a asp-action="Assign" asp-route-id="@item.Uid" class="btn btn-outline-success" title="Assign Provider">
                                            <i class="fa-solid fa-user-check"></i>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav class="mt-3" aria-label="Service request pagination">
                <ul class="pagination pagination-sm justify-content-center mb-0">
                    <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page - 1)"
                           asp-route-search="@Model.Search" asp-route-sort="@Model.Sort" asp-route-sortDir="@Model.SortDir" asp-route-status="@Model.Status">Previous</a>
                    </li>
                    @for (var p = 1; p <= Model.TotalPages; p++)
                    {
                        <li class="page-item @(p == Model.Page ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@p"
                               asp-route-search="@Model.Search" asp-route-sort="@Model.Sort" asp-route-sortDir="@Model.SortDir" asp-route-status="@Model.Status">@p</a>
                        </li>
                    }
                    <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page + 1)"
                           asp-route-search="@Model.Search" asp-route-sort="@Model.Sort" asp-route-sortDir="@Model.SortDir" asp-route-status="@Model.Status">Next</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>
