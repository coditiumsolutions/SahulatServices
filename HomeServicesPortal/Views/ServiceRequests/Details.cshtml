@model HomeServicesPortal.Models.ViewModels.ServiceRequestDetailsVm
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "S-Request Details";
    var statusClass = Model.Status switch
    {
        "Completed" => "success",
        "In Progress" => "primary",
        "Assigned" => "info",
        "Cancelled" => "secondary",
        _ => "warning"
    };
}

<div class="mb-4">
    <a asp-action="Index" class="text-decoration-none text-muted"><i class="fa-solid fa-arrow-left me-1"></i>Back to S-Requests</a>
    <h2 class="mt-2 mb-0"><i class="fa-solid fa-eye me-2 text-primary"></i>S-Request Details</h2>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card hs-card">
            <div class="card-body p-4">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted">Client</dt>
                    <dd class="col-sm-8 fw-semibold">@Model.CustomerName</dd>
                    <dt class="col-sm-4 text-muted">Category</dt>
                    <dd class="col-sm-8">@Model.CategoryName</dd>
                    <dt class="col-sm-4 text-muted">Service Title</dt>
                    <dd class="col-sm-8">@Model.ServiceTitle</dd>
                    <dt class="col-sm-4 text-muted">Description</dt>
                    <dd class="col-sm-8">@Model.ServiceDescription</dd>
                    <dt class="col-sm-4 text-muted">Address</dt>
                    <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.ServiceAddress) ? "—" : Model.ServiceAddress)</dd>
                    <dt class="col-sm-4 text-muted">Preferred Date</dt>
                    <dd class="col-sm-8">@(Model.PreferredServiceDate?.ToString("dd MMM yyyy") ?? "—")</dd>
                    <dt class="col-sm-4 text-muted">Preferred Time</dt>
                    <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.PreferredServiceTime) ? "—" : Model.PreferredServiceTime)</dd>
                    <dt class="col-sm-4 text-muted">Urgent</dt>
                    <dd class="col-sm-8">@(Model.IsUrgent ? "Yes" : "No")</dd>
                    <dt class="col-sm-4 text-muted">Contact</dt>
                    <dd class="col-sm-8">@(Model.ContactPerson ?? "—") / @Model.ContactNo</dd>
                    <dt class="col-sm-4 text-muted">Budget</dt>
                    <dd class="col-sm-8">@(Model.EstimatedBudget?.ToString("N2") ?? "—")</dd>
                    <dt class="col-sm-4 text-muted">Created On</dt>
                    <dd class="col-sm-8">@(Model.RequestDate?.ToString("dd MMM yyyy HH:mm") ?? "—")</dd>
                    <dt class="col-sm-4 text-muted">Status</dt>
                    <dd class="col-sm-8"><span class="badge bg-@statusClass">@(Model.Status ?? "Pending")</span></dd>
                    <dt class="col-sm-4 text-muted">Remarks</dt>
                    <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Remarks) ? "—" : Model.Remarks)</dd>
                </dl>
                <hr />
                <div class="d-flex gap-2">
                    @if (string.Equals(Model.Status, "Pending", StringComparison.OrdinalIgnoreCase))
                    {
                        <a asp-action="Assign" asp-route-id="@Model.Uid" class="btn btn-success">
                            <i class="fa-solid fa-user-check me-1"></i>Assign Provider
                        </a>
                    }
                    <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
                </div>
            </div>
        </div>
    </div>
</div>
