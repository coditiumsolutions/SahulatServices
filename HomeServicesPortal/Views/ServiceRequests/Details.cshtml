@model HomeServicesPortal.Models.ViewModels.ServiceRequestDetailsVm
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "S-Request Details";
    var statusClass = Model.Status switch
    {
        "Completed" => "success",
        "In Progress" => "primary",
        "Assigned" => "info",
        "Cancelled" => "secondary",
        _ => "warning"
    };
}

<div class="mb-4">
    <a asp-action="Index" class="text-decoration-none text-muted"><i class="fa-solid fa-arrow-left me-1"></i>Back to S-Requeste</a>
    <h2 class="mt-2 mb-0"><i class="fa-solid fa-eye me-2 text-primary"></i>S-Request Details</h2>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card hs-card">
            <div class="card-body p-4">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted">Customer</dt>
                    <dd class="col-sm-8 fw-semibold">@Model.CustomerName</dd>
                    <dt class="col-sm-4 text-muted">Category</dt>
                    <dd class="col-sm-8">@Model.CategoryName</dd>
                    <dt class="col-sm-4 text-muted">Service Address</dt>
                    <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.ServiceAddress) ? "—" : Model.ServiceAddress)</dd>
                    <dt class="col-sm-4 text-muted">Latitude</dt>
                    <dd class="col-sm-8">@(Model.Latitude?.ToString("0.0000000") ?? "—")</dd>
                    <dt class="col-sm-4 text-muted">Longitude</dt>
                    <dd class="col-sm-8">@(Model.Longitude?.ToString("0.0000000") ?? "—")</dd>
                    <dt class="col-sm-4 text-muted">Problem Description</dt>
                    <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.ProblemDescription) ? "—" : Model.ProblemDescription)</dd>
                    <dt class="col-sm-4 text-muted">Request Date</dt>
                    <dd class="col-sm-8">@(Model.RequestDate?.ToString("dd MMM yyyy HH:mm") ?? "—")</dd>
                    <dt class="col-sm-4 text-muted">Status</dt>
                    <dd class="col-sm-8"><span class="badge bg-@statusClass">@(Model.Status ?? "Pending")</span></dd>
                    <dt class="col-sm-4 text-muted">Provider Quotes</dt>
                    <dd class="col-sm-8"><span class="badge bg-info">@Model.QuoteCount</span></dd>
                    <dt class="col-sm-4 text-muted">Bookings</dt>
                    <dd class="col-sm-8"><span class="badge bg-secondary">@Model.BookingCount</span></dd>
                </dl>
                <hr />
                <div class="d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.Uid" class="btn btn-primary"><i class="fa-solid fa-pen me-1"></i>Edit</a>
                    <a asp-action="Delete" asp-route-id="@Model.Uid" class="btn btn-outline-danger"><i class="fa-solid fa-trash me-1"></i>Delete</a>
                </div>
            </div>
        </div>
    </div>
</div>
