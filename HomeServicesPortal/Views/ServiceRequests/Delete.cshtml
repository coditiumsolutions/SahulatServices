@model HomeServicesPortal.Models.ViewModels.ServiceRequestDeleteVm
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Delete S-Request";
}

<div class="mb-4">
    <a asp-action="Index" class="text-decoration-none text-muted"><i class="fa-solid fa-arrow-left me-1"></i>Back to S-Requests</a>
    <h2 class="mt-2 mb-0 text-danger"><i class="fa-solid fa-triangle-exclamation me-2"></i>Delete S-Request</h2>
</div>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card hs-card border-danger">
            <div class="card-body p-4">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <p>Are you sure you want to delete this service request?</p>
                <dl class="row mb-4">
                    <dt class="col-sm-4 text-muted">Request ID</dt>
                    <dd class="col-sm-8 fw-semibold">@Model.Uid</dd>
                    <dt class="col-sm-4 text-muted">Client</dt>
                    <dd class="col-sm-8 fw-semibold">@Model.CustomerName</dd>
                    <dt class="col-sm-4 text-muted">Category</dt>
                    <dd class="col-sm-8">@Model.CategoryName</dd>
                    <dt class="col-sm-4 text-muted">Title</dt>
                    <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.ServiceTitle) ? "—" : Model.ServiceTitle)</dd>
                    <dt class="col-sm-4 text-muted">Address</dt>
                    <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.ServiceAddress) ? "—" : Model.ServiceAddress)</dd>
                    <dt class="col-sm-4 text-muted">Status</dt>
                    <dd class="col-sm-8">@(Model.Status ?? "—")</dd>
                    <dt class="col-sm-4 text-muted">Created On</dt>
                    <dd class="col-sm-8">@(Model.RequestDate.ToPktDisplay())</dd>
                </dl>

                @if (Model.HasLinkedData)
                {
                    <div class="alert alert-warning">
                        <strong>This will also permanently delete:</strong>
                        <ul class="mb-0 mt-2">
                            @if (Model.BookingCount > 0)
                            {
                                <li>@Model.BookingCount booking(s)</li>
                            }
                            @if (Model.PaymentLedgerCount > 0)
                            {
                                <li>@Model.PaymentLedgerCount payment ledger row(s)</li>
                            }
                        </ul>
                    </div>
                }

                <form asp-action="DeleteConfirmed" asp-route-id="@Model.Uid" method="post">
                    @Html.AntiForgeryToken()
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-danger"><i class="fa-solid fa-trash me-1"></i>Yes, Delete</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
