{
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_SQL_SERVER,1433;Database=SahulatAppDB;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True;Encrypt=False;MultipleActiveResultSets=true;Connect Timeout=30"
  },
  "DevSqlTunnel": {
    "Enabled": false,
    "LocalPort": 11433
  },
  "Otp": {
    "IncludeInResponse": true
  },
  "FileStorage": {
    "ProviderDocuments": "wwwroot/uploads/providers",
    "MaxFileSizeBytes": 5242880,
    "MaxImageWidth": 1600,
    "JpegQuality": 80,
    "AllowedExtensions": [ "jpg", "jpeg", "png" ],
    "AllowedContentTypes": [ "image/jpeg", "image/jpg", "image/pjpeg", "image/png" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
