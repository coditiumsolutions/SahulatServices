{
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_SQL_SERVER,1433;Database=SahulatAppDB;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True;Encrypt=False;MultipleActiveResultSets=true;Connect Timeout=30"
  },
  "DevSqlTunnel": {
    "Enabled": false,
    "LocalPort": 11433
  },
  "Otp": {
    "IncludeInResponse": true
  },
  "Nominatim": {
    "BaseUrl": "https://nominatim.openstreetmap.org",
    "UserAgent": "SahulatGharTak/1.0 (contact: coditiumsolutions@gmail.com)",
    "TimeoutSeconds": 10,
    "MinRequestIntervalMs": 1100
  },
  "FileStorage": {
    "ProviderDocuments": "wwwroot/uploads/providers",
    "MaxFileSizeBytes": 5242880,
    "MaxImageWidth": 1600,
    "JpegQuality": 80,
    "AllowedExtensions": [ "jpg", "jpeg", "png" ],
    "AllowedContentTypes": [ "image/jpeg", "image/jpg", "image/pjpeg", "image/png" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Firebase": {
    "ServiceAccountPath": "secrets/firebase-service-account.json"
  },
  "AppConfig": {
    "Android": {
      "MinimumRequiredVersion": "1.0.3",
      "LatestVersion": "1.0.3",
      "ForceUpdate": false,
      "StoreUrl": "https://play.google.com/store/apps/details?id=com.coditiumsols.sahulatghartak",
      "UpdateMessage": "A new version of Sahulat Ghar Tak is available."
    },
    "Ios": {
      "MinimumRequiredVersion": "1.0.3",
      "LatestVersion": "1.0.3",
      "ForceUpdate": false,
      "StoreUrl": "https://apps.apple.com/pk/app/sahulat-ghar-tak/id6810184599",
      "UpdateMessage": "A new version of Sahulat Ghar Tak is available."
    }
  },
  "Notifications": {
    "BookingPushEnabled": true,
    "AndroidChannelsEnabled": false
  }
}
